+    fn observe_multi_workspace(
+        &mut self,
+        mw: &Entity<MultiWorkspace>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        self._subscriptions.push(cx.subscribe_in(
+            mw,
+            window,
+            |_this, _mw, _event: &workspace::MultiWorkspaceEvent, _window, cx| {
+                cx.notify();
+            },
+        ));
+    }
+
+    fn render_project_tabs(
+        &self,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<AnyElement> {
+        let mw = self.multi_workspace.as_ref()?.upgrade()?;
+
+        if !mw.read(cx).multi_workspace_enabled(cx) {
+            return None;
+        }
+
+        let keys = mw.read(cx).project_group_keys();
+        if keys.len() < 2 {
+            return None;
+        }
+
+        let ws = mw.read(cx).workspace().clone();
+        let active_key = mw.read(cx).project_group_key_for_workspace(&ws, cx);
+
+        let mw_weak = self.multi_workspace.clone();
+        let mut strip = h_flex().id("project-tabs").gap_0p5().items_center();
+
+        for (ix, key) in keys.into_iter().enumerate() {
+            let is_active = key == active_key;
+            let label = key.display_name(&std::collections::HashMap::new());
+
+            let activate_key = key.clone();
+            let activate_mw = mw_weak.clone();
+            let close_key = key.clone();
+            let close_mw = mw_weak.clone();
+
+            let tab = h_flex()
+                .id(("project-tab", ix))
+                .gap_1()
+                .items_center()
+                .px_2()
+                .py_0p5()
+                .rounded_t_md()
+                .bg(if is_active {
+                    cx.theme().colors().tab_active_background
+                } else {
+                    cx.theme().colors().tab_inactive_background
+                })
+                .child(
+                    Label::new(label)
+                        .size(LabelSize::Small)
+                        .color(if is_active {
+                            Color::Default
+                        } else {
+                            Color::Muted
+                        }),
+                )
+                .child(
+                    IconButton::new(("close-project-tab", ix), IconName::Close)
+                        .icon_size(IconSize::XSmall)
+                        .on_click(move |_event, window, cx| {
+                            if let Some(mw) = close_mw.as_ref().and_then(|m| m.upgrade()) {
+                                let close_key = close_key.clone();
+                                mw.update(cx, |mw, cx| {
+                                    mw.remove_project_group(&close_key, window, cx)
+                                        .detach_and_log_err(cx);
+                                });
+                            }
+                        }),
+                )
+                .on_click(move |_event, window, cx| {
+                    if let Some(mw) = activate_mw.as_ref().and_then(|m| m.upgrade()) {
+                        let activate_key = activate_key.clone();
+                        mw.update(cx, |mw, cx| {
+                            mw.activate_project_group(&activate_key, window, cx)
+                        });
+                    }
+                })
+                .on_drag(DraggedProjectTab { ix }, |tab, _, _, cx| {
+                    cx.new(|_| tab.clone())
+                })
+                .drag_over::<DraggedProjectTab>(|style, _, _, cx| {
+                    style.bg(cx.theme().colors().drop_target_background)
+                })
+                .on_drop(cx.listener(
+                    move |this, dragged: &DraggedProjectTab, _window, cx| {
+                        if let Some(mw) = this
+                            .multi_workspace
+                            .as_ref()
+                            .and_then(|m| m.upgrade())
+                        {
+                            let from = dragged.ix;
+                            mw.update(cx, |mw, cx| mw.move_project_group(from, ix, cx));
+                        }
+                    },
+                ));
+
+            strip = strip.child(tab);
+        }
+
+        strip = strip.child(
+            IconButton::new("new-project-tab", IconName::Plus)
+                .icon_size(IconSize::Small)
+                .on_click(|_event, window, cx| {
+                    window.dispatch_action(
+                        Box::new(zed_actions::OpenRecent {
+                            create_new_window: false,
+                        }),
+                        cx,
+                    )
+                }),
+        );
+
+        Some(strip.into_any_element())
+    }
