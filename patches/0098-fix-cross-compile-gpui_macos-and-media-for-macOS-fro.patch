From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Sun, 28 Jun 2026 23:05:10 +0300
Subject: [PATCH] fix: cross-compile gpui_macos and media for macOS from Linux
 (osxcross)

Key off CARGO_CFG_TARGET_OS instead of cfg!(target_os) in build scripts so
cross-compiling to macOS from a Linux host generates shader bindings.
Remove gpui from gpui_macos build-deps (only needed a path constant; derive
it from CARGO_MANIFEST_DIR instead to avoid dragging in the host backend).
---
 Cargo.lock                   |  2 ++
 crates/gpui_macos/Cargo.toml |  9 +++++--
 crates/gpui_macos/build.rs   | 20 ++++++++++++---
 crates/media/build.rs        | 50 ++++++++++++++++++++++++++----------
 4 files changed, 62 insertions(+), 19 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 3c94dfbdcb..c0f136430c 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3767,9 +3767,11 @@ dependencies = [
  "rustls-platform-verifier",
  "serde",
  "serde_json",
+ "settings",
  "smallvec",
  "tempfile",
  "theme",
+ "theme_settings",
  "tokio",
  "tokio-postgres",
  "tokio-postgres-rustls",
diff --git a/crates/gpui_macos/Cargo.toml b/crates/gpui_macos/Cargo.toml
index 2c9446401b..247b4a6ea0 100644
--- a/crates/gpui_macos/Cargo.toml
+++ b/crates/gpui_macos/Cargo.toml
@@ -60,9 +60,14 @@ strum.workspace = true
 util.workspace = true
 uuid.workspace = true
 
-[target.'cfg(target_os = "macos")'.build-dependencies]
+# Unconditional (host) build-dependency: the build script runs cbindgen on the
+# host to generate the Metal shader header. Gating it on cfg(target_os = "macos")
+# scopes it to the HOST platform, making it unavailable when cross-compiling to
+# macOS from Linux (osxcross). The script only runs the macOS codegen when
+# CARGO_CFG_TARGET_OS == "macos". gpui was dropped here — build.rs now derives
+# the gpui crate dir from CARGO_MANIFEST_DIR instead of gpui::GPUI_MANIFEST_DIR.
+[build-dependencies]
 cbindgen = { version = "0.28.0", default-features = false }
-gpui.workspace = true
 
 # When this crate is itself being tested (cargo test -p gpui_macos), its own
 # cfg(test) flag enables impls of test-only traits like PlatformHeadlessRenderer
diff --git a/crates/gpui_macos/build.rs b/crates/gpui_macos/build.rs
index d5c1893f4c..6aecc16775 100644
--- a/crates/gpui_macos/build.rs
+++ b/crates/gpui_macos/build.rs
@@ -1,11 +1,16 @@
 #![allow(clippy::disallowed_methods, reason = "build scripts are exempt")]
 
 fn main() {
-    #[cfg(target_os = "macos")]
-    macos_build::run();
+    // In a build script `cfg!(target_os = ...)` reflects the HOST, not the
+    // build target. Key off CARGO_CFG_TARGET_OS so cross-compiling to macOS
+    // from a non-macOS host (osxcross on Linux) still generates the shader
+    // bindings/stitched shaders. See docs/MACOS_LOCAL_BUILD.md.
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("macos") {
+        macos_build::run();
+    }
 }
 
-#[cfg(target_os = "macos")]
+#[allow(dead_code, reason = "only invoked when building for a macOS target")]
 mod macos_build {
     use std::{
         env,
@@ -98,7 +103,14 @@ mod macos_build {
 
     /// Locate the gpui crate directory relative to this crate.
     fn find_gpui_crate_dir() -> PathBuf {
-        gpui::GPUI_MANIFEST_DIR.into()
+        // Sibling crate at <workspace>/crates/gpui, computed from this crate's
+        // manifest dir. Avoids a `gpui` build-dependency, which when compiled
+        // for the host would drag in the host's gpui platform backend (e.g. the
+        // Linux GTK/Wayland stack) just to read a path constant.
+        PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap())
+            .parent()
+            .unwrap()
+            .join("gpui")
     }
 
     /// To enable runtime compilation, we need to "stitch" the shaders file with the generated header
diff --git a/crates/media/build.rs b/crates/media/build.rs
index 090002e9e9..8c5e1a072b 100644
--- a/crates/media/build.rs
+++ b/crates/media/build.rs
@@ -1,21 +1,48 @@
 #![allow(clippy::disallowed_methods, reason = "build scripts are exempt")]
-#[cfg(target_os = "macos")]
+
 fn main() {
-    use std::{env, path::PathBuf, process::Command};
+    // Build scripts run on the host, so `cfg!(target_os = ...)` reflects the
+    // HOST, not the build target. Key off CARGO_CFG_TARGET_OS so cross-compiling
+    // to macOS from a non-macOS host (osxcross on Linux) still generates the
+    // CoreMedia/CoreVideo bindings that src/bindings.rs includes unconditionally.
+    // See docs/MACOS_LOCAL_BUILD.md.
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("macos") {
+        return;
+    }
+
+    use std::{env, path::PathBuf};
 
-    let sdk_path = String::from_utf8(
-        Command::new("xcrun")
-            .args(["--sdk", "macosx", "--show-sdk-path"])
-            .output()
+    // SDK sysroot: prefer an explicit SDKROOT (set when cross-compiling with
+    // osxcross); otherwise ask xcrun, which exists on a native macOS host.
+    let sdk_path = env::var("SDKROOT")
+        .ok()
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| {
+            use std::process::Command;
+            String::from_utf8(
+                Command::new("xcrun")
+                    .args(["--sdk", "macosx", "--show-sdk-path"])
+                    .output()
+                    .unwrap()
+                    .stdout,
+            )
             .unwrap()
-            .stdout,
-    )
-    .unwrap();
-    let sdk_path = sdk_path.trim_end();
+            .trim_end()
+            .to_string()
+        });
 
+    // Point libclang at the macOS target (not the host) so it resolves the
+    // Objective-C framework headers. CARGO_CFG_TARGET_ARCH is aarch64/x86_64;
+    // clang spells the Apple arch "arm64".
+    let arch = env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_else(|_| "aarch64".into());
+    let clang_arch = if arch == "aarch64" { "arm64" } else { arch.as_str() };
+    let target_triple = format!("{clang_arch}-apple-darwin");
+
+    println!("cargo:rerun-if-env-changed=SDKROOT");
     println!("cargo:rerun-if-changed=src/bindings.h");
     let bindings = bindgen::Builder::default()
         .header("src/bindings.h")
+        .clang_arg(format!("--target={target_triple}"))
         .clang_arg(format!("-isysroot{}", sdk_path))
         .clang_arg("-xobjective-c")
         .allowlist_type("CMItemIndex")
@@ -39,6 +66,3 @@ fn main() {
         .write_to_file(out_path.join("bindings.rs"))
         .expect("couldn't write dispatch bindings");
 }
-
-#[cfg(not(target_os = "macos"))]
-fn main() {}
