---
 crates/database_client/src/connection/introspect.rs | 11 +++++++++++
 crates/database_client/src/panel.rs                 |  6 +++++-
 crates/database_client/src/query_view.rs            | 13 +------------
 3 files changed, 17 insertions(+), 13 deletions(-)

diff --git a/crates/database_client/src/connection/introspect.rs b/crates/database_client/src/connection/introspect.rs
index 79ca949881..b2c878a1bc 100644
--- a/crates/database_client/src/connection/introspect.rs
+++ b/crates/database_client/src/connection/introspect.rs
@@ -73,6 +73,11 @@ pub(crate) fn quote_literal(s: &str) -> String {
     format!("'{}'", s.replace('\'', "''"))
 }
 
+/// Double-quote a Postgres identifier (schema/table/column name), escaping embedded quotes.
+pub(crate) fn quote_ident(s: &str) -> String {
+    format!("\"{}\"", s.replace('"', "\"\""))
+}
+
 impl Connection {
     pub fn list_schemas(&self, cx: &App) -> Task<Result<Vec<SchemaInfo>>> {
         let sql = "select schema_name from information_schema.schemata \
@@ -164,4 +169,10 @@ mod tests {
     fn quote_literal_escapes_apostrophes() {
         assert_eq!(quote_literal("o'brien"), "'o''brien'");
     }
+
+    #[test]
+    fn quote_ident_double_quotes_and_escapes() {
+        assert_eq!(quote_ident("order"), "\"order\"");
+        assert_eq!(quote_ident("we\"ird"), "\"we\"\"ird\"");
+    }
 }
diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
index 158bf88609..8e45ad1f55 100644
--- a/crates/database_client/src/panel.rs
+++ b/crates/database_client/src/panel.rs
@@ -206,7 +206,11 @@ impl DatabasePanel {
         };
 
         let profile = self.profiles.iter().find(|p| p.id == conn_id).cloned();
-        let initial_sql = format!("SELECT * FROM {schema_name}.{table_name} LIMIT 500");
+        let initial_sql = format!(
+            "SELECT * FROM {}.{} LIMIT 500",
+            crate::connection::introspect::quote_ident(schema_name),
+            crate::connection::introspect::quote_ident(table_name),
+        );
 
         self.workspace
             .update(cx, |workspace, cx| {
