From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 01:28:36 +0300
Subject: [PATCH] acp_thread: add SubagentIndex::children_of for recursive
 rendering
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Returns only direct (one-hop) children in document order, mixing
tool-call and text entries — the primitive recursive card rendering
needs, since the existing members_of() flattens an entire nested
subtree and loses which level owns which entry.
---
 crates/acp_thread/src/acp_thread.rs | 137 ++++++++++++++++++++++++++++
 1 file changed, 137 insertions(+)

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index dd91c5a5aa..6a9ea01a75 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -466,6 +466,30 @@ impl SubagentIndex {
             .collect()
     }
 
+    /// Direct children of `parent` (one parent hop only — does not flatten nested
+    /// subtrees), in document order. Mixes tool-call and text/thought entries.
+    /// `parent` may be a top-level root or a nested root; the caller decides which
+    /// level to query, which is what makes recursive card rendering possible (a
+    /// nested root's own children are queried separately, not pre-flattened here).
+    pub fn children_of(&self, parent: &acp::ToolCallId, entries: &[AgentThreadEntry]) -> Vec<usize> {
+        entries
+            .iter()
+            .enumerate()
+            .filter_map(|(ix, entry)| match entry {
+                AgentThreadEntry::ToolCall(call) => self
+                    .membership
+                    .get(&call.id)
+                    .filter(|membership| &membership.parent == parent)
+                    .map(|_| ix),
+                _ => self
+                    .entry_membership
+                    .get(&ix)
+                    .filter(|membership| &membership.parent == parent)
+                    .map(|_| ix),
+            })
+            .collect()
+    }
+
     /// Like `apply`, but for transcript entries that have no `ToolCallId` of their
     /// own (text/thought chunks). Only the `Member` arm is meaningful here — a text
     /// entry can never itself be a subagent root (only tool calls spawn subagents),
@@ -4175,6 +4199,119 @@ mod tests {
         assert_eq!(index.root_label(&root), Some(SharedString::from("Explore")));
     }
 
+    enum EntryKind {
+        ToolCall(acp::ToolCallId),
+        Text,
+    }
+
+    fn minimal_tool_call_for_test(id: acp::ToolCallId, cx: &mut App) -> ToolCall {
+        let label = cx.new(|cx| Markdown::new("test label".into(), None, None, cx));
+        ToolCall {
+            id,
+            label,
+            kind: acp::ToolKind::Fetch,
+            content: vec![],
+            status: ToolCallStatus::Pending,
+            locations: Vec::new(),
+            resolved_locations: Vec::new(),
+            raw_input: None,
+            raw_input_markdown: None,
+            raw_output: None,
+            tool_name: None,
+            subagent_session_info: None,
+            sandbox_authorization_details: None,
+        }
+    }
+
+    fn synthetic_entries_for_test(kinds: Vec<EntryKind>, cx: &mut App) -> Vec<AgentThreadEntry> {
+        kinds
+            .into_iter()
+            .map(|kind| match kind {
+                EntryKind::ToolCall(id) => AgentThreadEntry::ToolCall(minimal_tool_call_for_test(id, cx)),
+                EntryKind::Text => AgentThreadEntry::AssistantMessage(AssistantMessage {
+                    chunks: Vec::new(),
+                    indented: false,
+                    is_subagent_output: false,
+                }),
+            })
+            .collect()
+    }
+
+    #[gpui::test]
+    async fn subagent_index_children_of_returns_direct_children_in_order(cx: &mut gpui::TestAppContext) {
+        cx.update(|cx| {
+            let mut index = SubagentIndex::default();
+            let root = acp::ToolCallId::new("R");
+            let nested_root = acp::ToolCallId::new("N");
+            let leaf_tool_call = acp::ToolCallId::new("L");
+
+            // Tree shape: R has two direct children — a plain tool-call member (entry 0,
+            // tool call id "M1") and a nested subagent root "N" (entry 1, tool call).
+            // N itself has one child: a text entry at index 2, and a tool call "L" at
+            // index 3.
+            index.apply(
+                &root,
+                SubagentClassification::Root {
+                    subagent_type: Some(SharedString::from("Explore")),
+                    subtree: SubagentSubtree::SameThread,
+                },
+            );
+            let m1 = acp::ToolCallId::new("M1");
+            index.apply(
+                &m1,
+                SubagentClassification::Member {
+                    parent: root.clone(),
+                    subagent_type: SharedString::from("Explore"),
+                },
+            );
+            index.apply(
+                &nested_root,
+                SubagentClassification::Root {
+                    subagent_type: Some(SharedString::from("Plan")),
+                    subtree: SubagentSubtree::SameThread,
+                },
+            );
+            // The nested root is itself a member of the outer root (so it's hidden from
+            // the outer flat list and shows up as a nested card instead).
+            index.apply(
+                &nested_root,
+                SubagentClassification::Member {
+                    parent: root.clone(),
+                    subagent_type: SharedString::from("Plan"),
+                },
+            );
+            index.apply_entry(
+                2,
+                SubagentClassification::Member {
+                    parent: nested_root.clone(),
+                    subagent_type: SharedString::from("Plan"),
+                },
+            );
+            index.apply(
+                &leaf_tool_call,
+                SubagentClassification::Member {
+                    parent: nested_root.clone(),
+                    subagent_type: SharedString::from("Plan"),
+                },
+            );
+
+            // Build a synthetic entries Vec whose tool-call ids match the above (content
+            // doesn't matter for this test, only matching ids at the right indices).
+            let entries = synthetic_entries_for_test(vec![
+                EntryKind::ToolCall(m1.clone()),         // index 0
+                EntryKind::ToolCall(nested_root.clone()), // index 1
+                EntryKind::Text,                          // index 2
+                EntryKind::ToolCall(leaf_tool_call.clone()), // index 3
+            ], cx);
+
+            let root_children = index.children_of(&root, &entries);
+            assert_eq!(root_children, vec![0, 1]);
+
+            let nested_children = index.children_of(&nested_root, &entries);
+            assert_eq!(nested_children, vec![2, 3]);
+        });
+    }
+
     fn init_test(cx: &mut TestAppContext) {
         env_logger::try_init().ok();
         cx.update(|cx| {
