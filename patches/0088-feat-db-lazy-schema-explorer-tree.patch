+use std::collections::{HashMap, HashSet};
+
+use crate::connection::introspect::{ColumnInfo, RelationInfo, RelationKind};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum NodeKind {
+    Connection,
+    Schema,
+    Relation,
+    Column,
+}
+
+pub struct TreeNode {
+    pub id: String,
+    pub depth: usize,
+    pub kind: NodeKind,
+    pub label: String,
+    pub expanded: bool,
+    pub has_children: bool,
+    pub relation_kind: Option<RelationKind>,
+}
+
+struct ConnectionEntry {
+    id: String,
+    name: String,
+}
+
+pub struct TreeState {
+    connections: Vec<ConnectionEntry>,
+    schemas: HashMap<String, Vec<String>>,
+    relations: HashMap<String, Vec<RelationInfo>>,
+    columns: HashMap<String, Vec<ColumnInfo>>,
+    expanded: HashSet<String>,
+}
+
+impl TreeState {
+    pub fn new(connections: Vec<(String, String)>) -> Self {
+        TreeState {
+            connections: connections
+                .into_iter()
+                .map(|(id, name)| ConnectionEntry { id, name })
+                .collect(),
+            schemas: HashMap::new(),
+            relations: HashMap::new(),
+            columns: HashMap::new(),
+            expanded: HashSet::new(),
+        }
+    }
+
+    pub fn visible_nodes(&self) -> Vec<TreeNode> {
+        let mut nodes = Vec::new();
+        for conn in &self.connections {
+            let expanded = self.expanded.contains(&conn.id);
+            nodes.push(TreeNode {
+                id: conn.id.clone(),
+                depth: 0,
+                kind: NodeKind::Connection,
+                label: conn.name.clone(),
+                expanded,
+                has_children: true,
+                relation_kind: None,
+            });
+            if expanded {
+                if let Some(schema_names) = self.schemas.get(&conn.id) {
+                    for schema_name in schema_names {
+                        let schema_id = format!("{}/{}", conn.id, schema_name);
+                        let schema_expanded = self.expanded.contains(&schema_id);
+                        nodes.push(TreeNode {
+                            id: schema_id.clone(),
+                            depth: 1,
+                            kind: NodeKind::Schema,
+                            label: schema_name.clone(),
+                            expanded: schema_expanded,
+                            has_children: true,
+                            relation_kind: None,
+                        });
+                        if schema_expanded {
+                            if let Some(relation_infos) = self.relations.get(&schema_id) {
+                                for rel in relation_infos {
+                                    let rel_id = format!("{}/{}", schema_id, rel.name);
+                                    let rel_expanded = self.expanded.contains(&rel_id);
+                                    nodes.push(TreeNode {
+                                        id: rel_id.clone(),
+                                        depth: 2,
+                                        kind: NodeKind::Relation,
+                                        label: rel.name.clone(),
+                                        expanded: rel_expanded,
+                                        has_children: true,
+                                        relation_kind: Some(rel.kind),
+                                    });
+                                    if rel_expanded {
+                                        if let Some(col_infos) = self.columns.get(&rel_id) {
+                                            for col in col_infos {
+                                                let col_id = format!("{}/{}", rel_id, col.name);
+                                                nodes.push(TreeNode {
+                                                    id: col_id,
+                                                    depth: 3,
+                                                    kind: NodeKind::Column,
+                                                    label: format!(
+                                                        "{}: {}",
+                                                        col.name, col.data_type
+                                                    ),
+                                                    expanded: false,
+                                                    has_children: false,
+                                                    relation_kind: None,
+                                                });
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        nodes
+    }
+
+    pub fn toggle(&mut self, id: &str) {
+        if self.expanded.contains(id) {
+            self.expanded.remove(id);
+        } else {
+            self.expanded.insert(id.to_string());
+        }
+    }
+
+    pub fn set_schemas(&mut self, conn_id: &str, schemas: Vec<String>) {
+        self.schemas.insert(conn_id.to_string(), schemas);
+    }
+
+    pub fn set_relations(&mut self, schema_id: &str, relations: Vec<RelationInfo>) {
+        self.relations.insert(schema_id.to_string(), relations);
+    }
+
+    pub fn set_columns(&mut self, rel_id: &str, columns: Vec<ColumnInfo>) {
+        self.columns.insert(rel_id.to_string(), columns);
+    }
+
+    pub fn is_expanded(&self, id: &str) -> bool {
+        self.expanded.contains(id)
+    }
+
+    pub fn schemas_loaded(&self, conn_id: &str) -> bool {
+        self.schemas.contains_key(conn_id)
+    }
+
+    pub fn relations_loaded(&self, schema_id: &str) -> bool {
+        self.relations.contains_key(schema_id)
+    }
+
+    pub fn columns_loaded(&self, rel_id: &str) -> bool {
+        self.columns.contains_key(rel_id)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn collapsed_connection_shows_only_itself() {
+        let t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        let nodes = t.visible_nodes();
+        assert_eq!(nodes.len(), 1);
+        assert_eq!(nodes[0].kind, NodeKind::Connection);
+        assert!(!nodes[0].expanded);
+    }
+
+    #[test]
+    fn expanding_connection_reveals_loaded_schemas() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        t.set_schemas("p1", vec!["public".into(), "app".into()]);
+        let labels: Vec<_> = t.visible_nodes().iter().map(|n| n.label.clone()).collect();
+        assert_eq!(labels, vec!["Local", "public", "app"]);
+    }
+
+    #[test]
+    fn expanding_then_collapsing_hides_schemas() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        t.set_schemas("p1", vec!["public".into()]);
+        assert_eq!(t.visible_nodes().len(), 2);
+        t.toggle("p1");
+        assert_eq!(t.visible_nodes().len(), 1);
+    }
+
+    #[test]
+    fn expanded_but_not_yet_loaded_shows_only_parent() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        // schemas not loaded yet
+        assert_eq!(t.visible_nodes().len(), 1);
+    }
+
+    #[test]
+    fn expanding_schema_reveals_relations() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        t.set_schemas("p1", vec!["public".into()]);
+        t.toggle("p1/public");
+        t.set_relations(
+            "p1/public",
+            vec![RelationInfo {
+                name: "users".into(),
+                kind: RelationKind::Table,
+            }],
+        );
+        let labels: Vec<_> = t.visible_nodes().iter().map(|n| n.label.clone()).collect();
+        assert_eq!(labels, vec!["Local", "public", "users"]);
+    }
+
+    #[test]
+    fn expanding_relation_reveals_columns() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        t.set_schemas("p1", vec!["public".into()]);
+        t.toggle("p1/public");
+        t.set_relations(
+            "p1/public",
+            vec![RelationInfo {
+                name: "users".into(),
+                kind: RelationKind::Table,
+            }],
+        );
+        t.toggle("p1/public/users");
+        t.set_columns(
+            "p1/public/users",
+            vec![ColumnInfo {
+                name: "id".into(),
+                data_type: "integer".into(),
+            }],
+        );
+        let nodes = t.visible_nodes();
+        assert_eq!(nodes.len(), 4);
+        assert_eq!(nodes[3].kind, NodeKind::Column);
+        assert_eq!(nodes[3].label, "id: integer");
+        assert_eq!(nodes[3].id, "p1/public/users/id");
+    }
+
+    #[test]
+    fn multiple_connections_both_visible() {
+        let t = TreeState::new(vec![
+            ("p1".into(), "Local".into()),
+            ("p2".into(), "Remote".into()),
+        ]);
+        let nodes = t.visible_nodes();
+        assert_eq!(nodes.len(), 2);
+        assert_eq!(nodes[0].label, "Local");
+        assert_eq!(nodes[1].label, "Remote");
+    }
+
+    #[test]
+    fn connection_node_has_children() {
+        let t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        let nodes = t.visible_nodes();
+        assert!(nodes[0].has_children);
+    }
+
+    #[test]
+    fn column_node_has_no_children() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        t.set_schemas("p1", vec!["public".into()]);
+        t.toggle("p1/public");
+        t.set_relations(
+            "p1/public",
+            vec![RelationInfo {
+                name: "users".into(),
+                kind: RelationKind::Table,
+            }],
+        );
+        t.toggle("p1/public/users");
+        t.set_columns(
+            "p1/public/users",
+            vec![ColumnInfo {
+                name: "id".into(),
+                data_type: "integer".into(),
+            }],
+        );
+        let nodes = t.visible_nodes();
+        let col = nodes.iter().find(|n| n.kind == NodeKind::Column).unwrap();
+        assert!(!col.has_children);
+    }
+}
