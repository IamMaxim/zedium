@@ -447,6 +450,37 @@ impl ExtensionStore {
         &self.extension_index.extensions
     }
 
+    /// Builds registry-shaped metadata for every installed non-dev extension, so the
+    /// extensions view can display installed extensions even when they are absent from
+    /// the local registry catalog (or no registry is configured). `published_at` and
+    /// `download_count` are synthesized placeholders — installed extensions carry no
+    /// registry timestamp.
+    pub fn installed_extensions_metadata(&self) -> Vec<ExtensionMetadata> {
+        self.extension_index
+            .extensions
+            .iter()
+            .filter(|(_, entry)| !entry.dev)
+            .map(|(id, entry)| {
+                let manifest = &entry.manifest;
+                ExtensionMetadata {
+                    id: id.clone(),
+                    manifest: ExtensionApiManifest {
+                        name: manifest.name.clone(),
+                        version: manifest.version.clone(),
+                        description: manifest.description.clone(),
+                        authors: manifest.authors.clone(),
+                        repository: manifest.repository.clone().unwrap_or_default(),
+                        schema_version: Some(manifest.schema_version.0),
+                        wasm_api_version: None,
+                        provides: manifest.provides(),
+                    },
+                    published_at: DateTime::<Utc>::default(),
+                    download_count: 0,
+                }
+            })
+            .collect()
+    }
+
     pub fn dev_extensions(&self) -> impl Iterator<Item = &Arc<ExtensionManifest>> {
         self.extension_index
             .extensions
