+    fn open_ddl_for_object(
+        &self,
+        node_id: &str,
+        target: DdlTarget,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        // Object node id: "{conn}/{db}/{schema}/{group}/{name}" (functions,
+        // sequences) or "{conn}/{db}/{schema}/{group}/{table}/{subkey}/{name}"
+        // (indexes, triggers). Schema is always at index 2; the object name
