+            return;
+        };
+        let title: SharedString = format!("{object_name} DDL").into();
+        self.open_ddl_tab(
+            connection,
+            target,
+            schema_name.to_string(),
+            object_name.to_string(),
+            title,
+            window,
+            cx,
+        );
+    }
