From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 01:50:18 +0300
Subject: [PATCH] acp_thread: extend qwen fixture with text-entry capture from
 patched qwen-code

Captured live against the provenance-patched local qwen-code build
(Task 5). Proves text-entry classification (Task 3) works end-to-end
against real wire traffic, not just synthetic test data.
---
 crates/acp_thread/src/acp_thread.rs           |  26 ++
 .../tests/qwen_subagent_session_updates.jsonl |  63 +++++
 2 files changed, 89 insertions(+)

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index 6a9ea01a75..c99c451c85 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -6199,6 +6199,32 @@ mod tests {
             assert_eq!(index.roots().count(), 1);
             assert!(index.is_root(&root_id));
             assert_eq!(index.members_of(&root_id).len(), 4);
+
+            // The freshly-captured fixture (2026-07-01, against the
+            // provenance-patched qwen-code build) also includes streamed text
+            // chunks tagged as belonging to a root subagent (Task 5's
+            // qwen-code patch). That capture is a separate session from the
+            // original 2026-06-23 tool-call-only capture above, so its root
+            // tool-call id is necessarily different.
+            let text_root_id =
+                acp::ToolCallId::new("toolu_bdrk_01SMLxZ8tCoqZKSEJNv2w4Es");
+            let entries = thread.entries();
+            let text_member_count = (0..entries.len())
+                .filter(|ix| index.is_text_member(*ix))
+                .count();
+            assert!(
+                text_member_count > 0,
+                "expected at least one text entry classified as a subagent member \
+                 from the updated fixture"
+            );
+            for ix in 0..entries.len() {
+                if index.is_text_member(ix) {
+                    assert_eq!(
+                        index.entry_membership_of(ix).map(|m| m.parent.clone()),
+                        Some(text_root_id.clone())
+                    );
+                }
+            }
         });
     }
 
