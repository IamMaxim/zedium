+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn mascot_asset_paths() {
+        assert_eq!(MascotState::Idle.asset_path(), "images/mascot/idle.webp");
+        assert_eq!(
+            MascotState::Listening.asset_path(),
+            "images/mascot/listening.webp"
+        );
+        assert_eq!(
+            MascotState::Thinking.asset_path(),
+            "images/mascot/thinking.webp"
+        );
+        assert_eq!(MascotState::Happy.asset_path(), "images/mascot/happy.webp");
+        assert_eq!(
+            MascotState::Concerned.asset_path(),
+            "images/mascot/concerned.webp"
+        );
+        assert_eq!(
+            MascotState::Sleeping.asset_path(),
+            "images/mascot/sleeping.webp"
+        );
+        assert_eq!(
+            MascotState::Stretch.asset_path(),
+            "images/mascot/stretch.webp"
+        );
+        assert_eq!(
+            MascotState::Petted.asset_path(),
+            "images/mascot/petted.webp"
+        );
+        assert_eq!(MascotState::Blink.asset_path(), "images/mascot/blink.webp");
+        assert_eq!(
+            MascotState::TailFlick.asset_path(),
+            "images/mascot/tail_flick.webp"
+        );
+        assert_eq!(MascotState::Look.asset_path(), "images/mascot/look.webp");
+        assert_eq!(MascotState::Groom.asset_path(), "images/mascot/groom.webp");
+        assert_eq!(
+            MascotState::WalkLeft.asset_path(),
+            "images/mascot/walk_left.webp"
+        );
+        assert_eq!(
+            MascotState::WalkRight.asset_path(),
+            "images/mascot/walk_right.webp"
+        );
+        assert_eq!(MASCOT_STATIC_ASSET, "images/mascot/static.png");
+    }
+
+    #[test]
+    fn mascot_clip_durations() {
+        assert_eq!(
+            MascotState::Idle.clip_duration(),
+            Duration::from_millis(1250)
+        );
+        assert_eq!(
+            MascotState::Listening.clip_duration(),
+            Duration::from_millis(1000)
+        );
+        assert_eq!(
+            MascotState::Thinking.clip_duration(),
+            Duration::from_millis(1250)
+        );
+        assert_eq!(
+            MascotState::Happy.clip_duration(),
+            Duration::from_millis(800)
+        );
+        assert_eq!(
+            MascotState::Concerned.clip_duration(),
+            Duration::from_millis(750)
+        );
+        assert_eq!(
+            MascotState::Sleeping.clip_duration(),
+            Duration::from_millis(2000)
+        );
+        assert_eq!(
+            MascotState::Stretch.clip_duration(),
+            Duration::from_millis(800)
+        );
+        assert_eq!(
+            MascotState::Petted.clip_duration(),
+            Duration::from_millis(1000)
+        );
+        assert_eq!(
+            MascotState::Blink.clip_duration(),
+            Duration::from_millis(400)
+        );
+        assert_eq!(
+            MascotState::TailFlick.clip_duration(),
+            Duration::from_millis(600)
+        );
+        assert_eq!(MascotState::Look.clip_duration(), Duration::from_millis(1000));
+        assert_eq!(
+            MascotState::Groom.clip_duration(),
+            Duration::from_millis(1250)
+        );
+        assert_eq!(
+            MascotState::WalkLeft.clip_duration(),
+            Duration::from_millis(600)
+        );
+        assert_eq!(
+            MascotState::WalkRight.clip_duration(),
+            Duration::from_millis(600)
+        );
+    }
+
+    #[test]
+    fn mascot_one_shot_states() {
+        assert!(!MascotState::Idle.is_one_shot());
+        assert!(!MascotState::Listening.is_one_shot());
+        assert!(!MascotState::Thinking.is_one_shot());
+        assert!(MascotState::Happy.is_one_shot());
+        assert!(MascotState::Concerned.is_one_shot());
+        assert!(!MascotState::Sleeping.is_one_shot());
+        assert!(MascotState::Stretch.is_one_shot());
+        assert!(MascotState::Petted.is_one_shot());
+        assert!(MascotState::Blink.is_one_shot());
+        assert!(MascotState::TailFlick.is_one_shot());
+        assert!(MascotState::Look.is_one_shot());
+        assert!(MascotState::Groom.is_one_shot());
+        assert!(!MascotState::WalkLeft.is_one_shot());
+        assert!(!MascotState::WalkRight.is_one_shot());
+    }
+}
