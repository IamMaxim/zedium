+use std::sync::Arc;
+use std::time::Duration;
+
+use gpui::{Animation, AnimationExt as _, img};
+
+use crate::prelude::*;
+
+/// The behavioral state of the agent mascot. Each state maps to one animated
+/// WebP clip under `assets/images/mascot/`.
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub enum MascotState {
+    Idle,
+    Listening,
+    Thinking,
+    Happy,
+    Concerned,
+    Sleeping,
+    Stretch,
+    Petted,
+    Blink,
+    TailFlick,
+    Look,
+    Groom,
+    WalkLeft,
+    WalkRight,
+}
+
+/// Single static idle pose, used when animations are disabled.
+pub const MASCOT_STATIC_ASSET: &str = "images/mascot/static.png";
+
+const CROSSFADE_DURATION: Duration = Duration::from_millis(120);
+
+impl MascotState {
+    /// Path of this state's animated clip, relative to the embedded assets root.
+    pub fn asset_path(&self) -> &'static str {
+        match self {
+            MascotState::Idle => "images/mascot/idle.webp",
+            MascotState::Listening => "images/mascot/listening.webp",
+            MascotState::Thinking => "images/mascot/thinking.webp",
+            MascotState::Happy => "images/mascot/happy.webp",
+            MascotState::Concerned => "images/mascot/concerned.webp",
+            MascotState::Sleeping => "images/mascot/sleeping.webp",
+            MascotState::Stretch => "images/mascot/stretch.webp",
+            MascotState::Petted => "images/mascot/petted.webp",
+            MascotState::Blink => "images/mascot/blink.webp",
+            MascotState::TailFlick => "images/mascot/tail_flick.webp",
+            MascotState::Look => "images/mascot/look.webp",
+            MascotState::Groom => "images/mascot/groom.webp",
+            MascotState::WalkLeft => "images/mascot/walk_left.webp",
+            MascotState::WalkRight => "images/mascot/walk_right.webp",
+        }
+    }
+
+    /// Total duration of one playback of this state's clip (frames / fps,
+    /// mirroring the timing baked into the clips by tools/mascot_pack).
+    pub fn clip_duration(&self) -> Duration {
+        let (frames, fps) = match self {
+            MascotState::Idle => (10, 8),
+            MascotState::Listening => (8, 8),
+            MascotState::Thinking => (10, 8),
+            MascotState::Happy => (8, 10),
+            MascotState::Concerned => (6, 8),
+            MascotState::Sleeping => (8, 4),
+            MascotState::Stretch => (8, 10),
+            MascotState::Petted => (10, 10),
+            MascotState::Blink => (4, 10),
+            MascotState::TailFlick => (6, 10),
+            MascotState::Look => (8, 8),
+            MascotState::Groom => (10, 8),
+            MascotState::WalkLeft => (6, 10),
+            MascotState::WalkRight => (6, 10),
+        };
+        Duration::from_millis(frames * 1000 / fps)
+    }
+
+    /// One-shot states play once and then return to a base state. The clip
+    /// files themselves loop (gpui's img() has no play-once API); the mascot
+    /// controller swaps the state after `clip_duration()` elapses.
+    pub fn is_one_shot(&self) -> bool {
+        matches!(
+            self,
+            MascotState::Happy
+                | MascotState::Concerned
+                | MascotState::Stretch
+                | MascotState::Petted
+                | MascotState::Blink
+                | MascotState::TailFlick
+                | MascotState::Look
+                | MascotState::Groom
+        )
+    }
+}
+
+/// Renders the mascot's clip for a given state, cross-fading from the previous
+/// state's clip when one is provided.
+#[derive(IntoElement)]
+pub struct MascotPlayer {
+    id: ElementId,
+    state: MascotState,
+    size: Pixels,
+    animated: bool,
+    crossfade_from: Option<MascotState>,
+}
+
+impl MascotPlayer {
+    pub fn new(id: impl Into<ElementId>, state: MascotState) -> Self {
+        Self {
+            id: id.into(),
+            state,
+            size: px(96.),
+            animated: true,
+            crossfade_from: None,
+        }
+    }
+
+    pub fn size(mut self, size: Pixels) -> Self {
+        self.size = size;
+        self
+    }
+
+    /// When false, renders the single static pose instead of animated clips.
+    pub fn animated(mut self, animated: bool) -> Self {
+        self.animated = animated;
+        self
+    }
+
+    /// Cross-fade from the previous state's clip over 120ms. The animation id
+    /// incorporates both states, so a state change restarts the fade.
+    pub fn crossfade_from(mut self, prev: Option<MascotState>) -> Self {
+        self.crossfade_from = prev;
+        self
+    }
+}
+
+impl RenderOnce for MascotPlayer {
+    fn render(self, _window: &mut Window, _cx: &mut App) -> impl IntoElement {
+        let size = self.size;
+
+        if !self.animated {
+            return div()
+                .id(self.id)
+                .size(size)
+                .child(img(MASCOT_STATIC_ASSET).size(size))
+                .into_any_element();
+        }
+
+        match self.crossfade_from {
+            Some(previous) if previous != self.state => {
+                let fade_out_id = ElementId::NamedChild(
+                    Arc::new(self.id.clone()),
+                    format!("xfade-out-{}-{}", previous as usize, self.state as usize).into(),
+                );
+                let fade_in_id = ElementId::NamedChild(
+                    Arc::new(self.id.clone()),
+                    format!("xfade-in-{}-{}", previous as usize, self.state as usize).into(),
+                );
+                div()
+                    .id(self.id)
+                    .relative()
+                    .size(size)
+                    .child(
+                        div()
+                            .absolute()
+                            .inset_0()
+                            .child(img(previous.asset_path()).size(size))
+                            .with_animation(
+                                fade_out_id,
+                                Animation::new(CROSSFADE_DURATION),
+                                |this, delta| this.opacity(1.0 - delta),
+                            ),
+                    )
+                    .child(
+                        div()
+                            .absolute()
+                            .inset_0()
+                            .child(img(self.state.asset_path()).size(size))
+                            .with_animation(
+                                fade_in_id,
+                                Animation::new(CROSSFADE_DURATION),
+                                |this, delta| this.opacity(delta),
+                            ),
+                    )
+                    .into_any_element()
+            }
+            _ => div()
+                .id(self.id)
+                .size(size)
+                .child(img(self.state.asset_path()).size(size))
+                .into_any_element(),
+        }
+    }
+}
