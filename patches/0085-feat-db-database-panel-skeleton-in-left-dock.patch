From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Sat, 27 Jun 2026 21:36:07 +0300
Subject: [PATCH] feat(db): database panel skeleton in left dock
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds `DatabasePanel` — a dockable left-side panel for the
`database_client` crate. Registers `ToggleFocus` / `NewConnection`
actions, wires the panel into `initialize_panels` in zed startup.
Renders a placeholder label with the connection count (0 until
Task 7 adds create-connection UI).

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GbHBSdw2MBBgxKxLnVCbf6
---
 crates/database_client/src/database_client.rs |  24 ++++-
 crates/database_client/src/panel.rs           | 100 ++++++++++++++++++
 crates/zed/src/zed.rs                         |   2 +
 3 files changed, 123 insertions(+), 3 deletions(-)
 create mode 100644 crates/database_client/src/panel.rs

diff --git a/crates/database_client/src/database_client.rs b/crates/database_client/src/database_client.rs
index 1628d4936e..78036d73b2 100644
--- a/crates/database_client/src/database_client.rs
+++ b/crates/database_client/src/database_client.rs
@@ -1,12 +1,30 @@
 //! Postgres database client: schema explorer panel + query tabs.
 
-use gpui::App;
+use gpui::{App, actions};
+use workspace::Workspace;
 
 mod connection;
+mod panel;
 
 pub use connection::client::DEFAULT_RESULT_LIMIT;
+pub use panel::DatabasePanel;
+
+actions!(
+    database_client,
+    [
+        /// Toggles focus on the database panel.
+        ToggleFocus,
+        /// Opens the new-connection dialog.
+        NewConnection,
+    ]
+);
 
 /// Initialize the database client: register actions, panel, and items.
-pub fn init(_cx: &mut App) {
-    // Wiring added in later tasks.
+pub fn init(cx: &mut App) {
+    cx.observe_new(|workspace: &mut Workspace, _, _| {
+        workspace.register_action(|workspace, _: &ToggleFocus, window, cx| {
+            workspace.toggle_panel_focus::<panel::DatabasePanel>(window, cx);
+        });
+    })
+    .detach();
 }
diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
new file mode 100644
index 0000000000..b756ffabbf
--- /dev/null
+++ b/crates/database_client/src/panel.rs
@@ -0,0 +1,100 @@
+use crate::{ToggleFocus, connection::profile::ConnectionProfile, connection::store};
+use anyhow::Result;
+use gpui::{
+    App, AsyncWindowContext, Context, Entity, EventEmitter, FocusHandle, Focusable, IntoElement,
+    ParentElement, Render, Styled, WeakEntity, Window, div, px,
+};
+use ui::prelude::*;
+use workspace::{
+    Workspace,
+    dock::{DockPosition, Panel, PanelEvent},
+};
+
+pub struct DatabasePanel {
+    focus_handle: FocusHandle,
+    workspace: WeakEntity<Workspace>,
+    profiles: Vec<ConnectionProfile>,
+}
+
+impl DatabasePanel {
+    pub fn new(
+        _workspace: &mut Workspace,
+        _window: &mut Window,
+        cx: &mut Context<Workspace>,
+    ) -> Entity<Self> {
+        let weak = cx.entity().downgrade();
+        cx.new(|cx| DatabasePanel {
+            focus_handle: cx.focus_handle(),
+            workspace: weak,
+            profiles: store::load_profiles(),
+        })
+    }
+
+    pub async fn load(
+        workspace: WeakEntity<Workspace>,
+        mut cx: AsyncWindowContext,
+    ) -> Result<Entity<Self>> {
+        workspace.update_in(&mut cx, |workspace, window, cx| {
+            DatabasePanel::new(workspace, window, cx)
+        })
+    }
+}
+
+impl Focusable for DatabasePanel {
+    fn focus_handle(&self, _: &App) -> FocusHandle {
+        self.focus_handle.clone()
+    }
+}
+
+impl EventEmitter<PanelEvent> for DatabasePanel {}
+
+impl Panel for DatabasePanel {
+    fn persistent_name() -> &'static str {
+        "Database Panel"
+    }
+
+    fn panel_key() -> &'static str {
+        "DatabasePanel"
+    }
+
+    fn position(&self, _: &Window, _: &App) -> DockPosition {
+        DockPosition::Left
+    }
+
+    fn position_is_valid(&self, position: DockPosition) -> bool {
+        matches!(position, DockPosition::Left | DockPosition::Right)
+    }
+
+    fn set_position(&mut self, _: DockPosition, _: &mut Window, _: &mut Context<Self>) {}
+
+    fn default_size(&self, _: &Window, _: &App) -> gpui::Pixels {
+        px(260.)
+    }
+
+    fn icon(&self, _: &Window, _: &App) -> Option<IconName> {
+        Some(IconName::DatabaseZap)
+    }
+
+    fn icon_tooltip(&self, _: &Window, _: &App) -> Option<&'static str> {
+        Some("Database")
+    }
+
+    fn toggle_action(&self) -> Box<dyn gpui::Action> {
+        Box::new(ToggleFocus)
+    }
+
+    fn activation_priority(&self) -> u32 {
+        6
+    }
+}
+
+impl Render for DatabasePanel {
+    fn render(&mut self, _: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        div()
+            .key_context("DatabasePanel")
+            .track_focus(&self.focus_handle)
+            .size_full()
+            .p_2()
+            .child(Label::new(format!("{} connection(s)", self.profiles.len())))
+    }
+}
