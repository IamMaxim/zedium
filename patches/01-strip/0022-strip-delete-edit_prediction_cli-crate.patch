-                    }
-                    Ok(())
-                })?;
-            }
-
-            total_uploaded += batch_len;
-            log::info!(
-                "Uploaded batch {} with {} requests ({} total)",
-                batch.id,
-                batch_len,
-                total_uploaded
-            );
-
-            all_batch_ids.push(batch.id);
-        }
-
-        if !all_batch_ids.is_empty() {
-            log::info!(
-                "Finished uploading {} batches with {} total requests",
-                all_batch_ids.len(),
-                total_uploaded
-            );
-        }
-
-        Ok(all_batch_ids)
-    }
