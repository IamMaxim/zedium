-        if libc::ioctl(libc::STDERR_FILENO, libc::TIOCGWINSZ, &mut winsize) == 0
-            && winsize.ws_col > 0
-        {
-            winsize.ws_col as usize
-        } else {
-            80
-        }
-    }
