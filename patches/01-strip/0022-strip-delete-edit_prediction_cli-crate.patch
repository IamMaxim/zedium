-fn chunk_examples(examples: Vec<Example>, max_parallelism: usize) -> VecDeque<Vec<Example>> {
-    if examples.is_empty() || max_parallelism == 0 {
-        return VecDeque::new();
-    }
-
-    let chunk_size = examples.len().div_ceil(max_parallelism);
-    examples
-        .chunks(chunk_size)
-        .map(|chunk| chunk.to_vec())
-        .collect()
-}
