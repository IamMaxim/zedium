-            AnthropicClient::Batch(batching_llm_client) => {
-                batching_llm_client.import_batches(batch_ids).await
-            }
-            AnthropicClient::Dummy => panic!("Dummy LLM client is not expected to be used"),
-        }
-    }
-}
