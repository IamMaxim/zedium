-    if matches!(
-        file_name,
-        "package.json"
-            | "package-lock.json"
-            | "pnpm-lock.yaml"
-            | "Cargo.lock"
-            | "yarn.lock"
-            | "bun.lock"
-            | "bun.lockb"
-            | "go.sum"
-            | "composer.lock"
-            | "Gemfile.lock"
