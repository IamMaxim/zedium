-
-        if let Some(confidence) = qa.confidence {
-            if confidence <= confidence_threshold {
-                return true;
-            }
-        }
-
-        return false;
-    }
-
-    // When QA is unavailable, fall back to computed score signals.
-    if let Some(score) = example.score.first() {
