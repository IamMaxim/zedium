-fn message_content_to_string(content: &[RequestContent]) -> String {
-    content
-        .iter()
-        .filter_map(|c| match c {
-            RequestContent::Text { text, .. } => Some(text.clone()),
-            _ => None,
-        })
-        .collect::<Vec<String>>()
-        .join("\n")
-}
