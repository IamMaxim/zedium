-            DiffTag::Insert => {
-                let inserted_text: String = op.new_range().map(|i| tgt_tokens[i]).collect();
-                push_typed_text_candidates(
-                    &mut candidate_splits,
-                    edit_byte_offset,
-                    &tgt_line,
-                    final_line_byte_offset,
-                    &inserted_text,
