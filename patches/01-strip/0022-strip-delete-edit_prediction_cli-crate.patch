-fn percentile(sorted_values: &[usize], p: usize) -> usize {
-    if sorted_values.is_empty() {
-        return 0;
-    }
-    let idx = (p as f64 / 100.0 * (sorted_values.len() as f64 - 1.0)).round() as usize;
-    sorted_values[idx.min(sorted_values.len() - 1)]
-}
