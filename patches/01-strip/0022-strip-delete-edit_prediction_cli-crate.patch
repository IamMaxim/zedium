-            Level::Debug => "Debug",
-            Level::Trace => "Trace",
-        };
-
-        let message = format!(
-            "{bold}{level_color}{level_label:>12}{reset} {}",
-            record.args()
-        );
-
-        if let Some(progress) = GLOBAL.get() {
