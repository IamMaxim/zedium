-#[derive(Debug, Default, Clone)]
-pub struct Patch {
-    pub header: String,
-    pub hunks: Vec<Hunk>,
-}
-
-pub struct DiffStats {
-    pub added: usize,
-    pub removed: usize,
-}
-
-impl ToString for Patch {
