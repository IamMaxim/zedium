-    match extension {
-        "rs" | "c" | "cpp" | "cc" | "h" | "hpp" | "js" | "ts" | "tsx" | "jsx" | "go" | "java"
-        | "swift" | "kt" | "kts" | "scala" | "cs" | "m" | "mm" | "zig" | "v" | "d" => "//",
-        "py" | "rb" | "sh" | "bash" | "zsh" | "pl" | "pm" | "r" | "jl" | "yaml" | "yml"
-        | "toml" | "coffee" | "cr" | "ex" | "exs" | "elixir" => "#",
-        "lua" | "hs" | "sql" => "--",
-        "lisp" | "clj" | "cljs" | "scm" | "rkt" | "el" => ";",
-        "erl" | "hrl" => "%",
-        _ => "//",
-    }
