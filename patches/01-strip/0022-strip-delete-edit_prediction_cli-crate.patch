-fn header_for_edit(patch: &Patch, edit_index: usize) -> Option<String> {
-    let edit_index = edit_index.try_into().ok()?;
-    let edit_location = locate_edited_line(patch, edit_index)?;
-    header_for_hunk(patch, edit_location.hunk_index)
-}
