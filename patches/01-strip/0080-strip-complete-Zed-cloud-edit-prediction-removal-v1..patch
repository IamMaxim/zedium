-
-fn render_events_with_predicted(events: &[StoredEvent]) -> Vec<String> {
-    events
-        .iter()
-        .map(|e| {
-            let zeta_prompt::Event::BufferChange {
-                diff, predicted, ..
-            } = e.event.as_ref();
-            let prefix = if *predicted { "predicted" } else { "manual" };
-            format!("{}\n{}", prefix, diff)
-        })
-        .collect()
-}
