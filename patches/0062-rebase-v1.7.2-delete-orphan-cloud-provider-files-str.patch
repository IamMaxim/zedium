-    fn stream_completion(
-        &self,
-        request: bedrock::Request,
-        cx: &AsyncApp,
-    ) -> BoxFuture<
-        'static,
-        Result<BoxStream<'static, Result<BedrockStreamingResponse, anyhow::Error>>, BedrockError>,
