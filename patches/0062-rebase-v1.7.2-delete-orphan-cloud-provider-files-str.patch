-    struct RawToolUse {
-        id: String,
-        name: String,
-        input_json: String,
-    }
-
-    struct State {
-        events: Pin<Box<dyn Send + Stream<Item = Result<BedrockStreamingResponse, anyhow::Error>>>>,
-        tool_uses_by_index: HashMap<i32, RawToolUse>,
-        emitted_tool_use: bool,
