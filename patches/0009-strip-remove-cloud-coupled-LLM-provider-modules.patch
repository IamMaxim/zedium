-#[derive(Deserialize)]
-struct TokenResponse {
-    access_token: String,
-    refresh_token: String,
-    #[serde(default)]
-    id_token: Option<String>,
-    expires_in: u64,
-    #[serde(default)]
-    email: Option<String>,
-}
