-            cx.observe_global::<SettingsStore>({
-                let mut last_settings = VercelAiGatewayLanguageModelProvider::settings(cx).clone();
-                move |this: &mut State, cx| {
-                    let current_settings = VercelAiGatewayLanguageModelProvider::settings(cx);
