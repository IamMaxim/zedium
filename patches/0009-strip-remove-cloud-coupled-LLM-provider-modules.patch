-fn deepseek_thinking(
-    model: &deepseek::Model,
-    thinking_allowed: bool,
-) -> Option<deepseek::Thinking> {
-    let kind = match model {
-        deepseek::Model::V4Flash | deepseek::Model::V4Pro => {
-            if thinking_allowed {
