From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Thu, 28 May 2026 22:49:15 +0300
Subject: [PATCH] metadata: rebrand zed package author/description for Zedium
 fork

The crates/zed package keeps its name='zed' to avoid downstream
churn (binary name, build scripts, references throughout the
codebase), but its description and authors fields now reflect the
Zedium fork.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 crates/zed/Cargo.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/zed/Cargo.toml b/crates/zed/Cargo.toml
index 8da856d86d..cc73e940ad 100644
--- a/crates/zed/Cargo.toml
+++ b/crates/zed/Cargo.toml
@@ -1,11 +1,11 @@
 [package]
-description = "The fast, collaborative code editor."
+description = "Zedium - a telemetry-free, cloud-free fork of the Zed editor."
 edition.workspace = true
 name = "zed"
 version = "1.11.3"
 publish.workspace = true
 license = "GPL-3.0-or-later"
-authors = ["Zed Team <hi@zed.dev>"]
+authors = ["Zedium contributors"]
 default-run = "zed"
 
 [lints]
