From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Thu, 11 Jun 2026 21:04:47 +0300
Subject: [PATCH] fix: call title_bar::init(cx) directly in zed::init
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Patch 0002 removed collab_ui::init(cx) from the boot sequence, but
title_bar::init was called inside collab_ui::init. Without it,
workspace.set_titlebar_item is never invoked, so:
- No title bar is rendered → macOS traffic lights overlap the file tree
- PlatformTitleBar::init / SystemWindowTabs::init never run → the macOS
  native window tab bar is never wired up

Fix: call title_bar::init(cx) directly in zed::init, which is already
in the boot sequence (called from main.rs as zed::init(cx)).

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 crates/zed/src/zed.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/crates/zed/src/zed.rs b/crates/zed/src/zed.rs
index e93df89bd5..58156f1ff6 100644
--- a/crates/zed/src/zed.rs
+++ b/crates/zed/src/zed.rs
@@ -172,6 +172,7 @@ pub fn init(cx: &mut App) {
     cx.on_action(|_: &ShowAll, cx| cx.unhide_other_apps());
     cx.on_action(quit);
 
+    title_bar::init(cx);
     cx.on_action(|_: &RestoreBanner, cx| title_bar::restore_banner(cx));
 
     cx.observe_flag::<PanicFeatureFlag, _>({
