Subject: [PATCH] fix(db): clear stale connections/errors on profile reload;
 test tree persistence

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GbHBSdw2MBBgxKxLnVCbf6
---
 crates/database_client/src/panel.rs |  3 +++
 crates/database_client/src/tree.rs  | 11 +++++++++++
 2 files changed, 14 insertions(+)

diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
index 0635d1e7a3..41cedd92d5 100644
--- a/crates/database_client/src/panel.rs
+++ b/crates/database_client/src/panel.rs
@@ -74,6 +74,9 @@ impl DatabasePanel {
     pub(crate) fn reload_profiles(&mut self, cx: &mut Context<Self>) {
         self.profiles = store::load_profiles();
         self.tree = Self::build_tree(&self.profiles);
+        self.connections.clear();
+        self.errors.clear();
+        self.loading.clear();
         cx.notify();
     }
 
diff --git a/crates/database_client/src/tree.rs b/crates/database_client/src/tree.rs
index 2074d1098f..d011da438c 100644
--- a/crates/database_client/src/tree.rs
+++ b/crates/database_client/src/tree.rs
@@ -251,6 +251,17 @@ mod tests {
         assert_eq!(nodes[1].label, "Remote");
     }
 
+    #[test]
+    fn re_expanding_after_collapse_does_not_lose_children() {
+        let mut t = TreeState::new(vec![("p1".into(), "Local".into())]);
+        t.toggle("p1");
+        t.set_schemas("p1", vec!["public".into()]);
+        t.toggle("p1"); // collapse
+        t.toggle("p1"); // re-expand — no set_schemas called again
+        let labels: Vec<_> = t.visible_nodes().iter().map(|n| n.label.clone()).collect();
+        assert_eq!(labels, vec!["Local", "public"]); // data survived
+    }
+
     #[test]
     fn connection_node_has_children() {
         let t = TreeState::new(vec![("p1".into(), "Local".into())]);
