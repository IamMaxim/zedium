From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Thu, 2 Jul 2026 00:03:46 +0300
Subject: [PATCH] docs(db): note header choice for all-empty multi-statement
 batches

---
 crates/database_client/src/connection/client.rs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/crates/database_client/src/connection/client.rs b/crates/database_client/src/connection/client.rs
index 8b9fc88adb..4aa6f922b8 100644
--- a/crates/database_client/src/connection/client.rs
+++ b/crates/database_client/src/connection/client.rs
@@ -92,6 +92,9 @@ pub(crate) fn collect_result(
     for msg in messages {
         match msg {
             RowDescription(cols) => {
+                // Until a data row arrives the latest statement's description
+                // wins, so an all-empty multi-statement batch shows the last
+                // statement's headers.
                 if rows.is_empty() {
                     columns = cols.iter().map(|c| c.name().to_string()).collect();
                 }
