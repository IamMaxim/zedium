+        panel.read_with(cx, |panel, _| {
+            assert!(panel.tree.is_expanded("p1"));
+            assert!(panel.tree.is_expanded("p1/testdb"));
+            assert!(panel.tree.is_expanded("p1/testdb/public"));
+            assert!(panel.tree.is_expanded("p1/testdb/public/tables"));
+        });
+    }
+
