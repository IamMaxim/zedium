From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Thu, 2 Jul 2026 11:41:49 +0300
Subject: [PATCH] feat(db): rework query toolbar with run icon, status dot, row
 info, and load more
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PlayFilled run button (disabled while running), profile + database
names, connection-liveness dot, 1–N of N+/exact row info, Load more
when further pages exist, and ms/s duration formatting.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MQKuAnEREjToPLedE7KAqP
---
 crates/database_client/src/query_view.rs | 94 ++++++++++++++++--------
 1 file changed, 64 insertions(+), 30 deletions(-)

diff --git a/crates/database_client/src/query_view.rs b/crates/database_client/src/query_view.rs
index 21c43880c7..6f2dd8701f 100644
--- a/crates/database_client/src/query_view.rs
+++ b/crates/database_client/src/query_view.rs
@@ -12,6 +12,7 @@ use settings::Settings as _;
 use theme::ActiveTheme;
 use theme_settings::ThemeSettings;
 use ui::prelude::*;
+use ui::{IconButtonShape, Indicator, Tooltip};
 use util::ResultExt as _;
 use workspace::{
     ItemId, SerializableItem, Workspace, WorkspaceId, delete_unloaded_items,
@@ -19,7 +20,6 @@ use workspace::{
 };
 
 use crate::{
-    DEFAULT_RESULT_LIMIT,
     connection::{
         client::{Connection, QueryResult, truncate_rows},
         profile::ConnectionProfile,
@@ -524,11 +524,27 @@ impl Render for QueryView {
             .as_ref()
             .map(|p| SharedString::from(p.name.clone()))
             .unwrap_or_else(|| "No Connection".into());
+        let database_name: Option<SharedString> = self
+            .profile
+            .as_ref()
+            .map(|p| SharedString::from(p.database.clone()));
+
+        let status_color = if self.error.is_some() {
+            Color::Error
+        } else if self.connection.is_some() {
+            Color::Success
+        } else {
+            Color::Muted
+        };
+
+        let page_size = crate::settings::DatabaseClientSettings::get_global(cx).page_size;
+        let non_wrappable_truncated = self.result.as_ref().is_some_and(|r| r.truncated);
 
-        let run_label: &str = if self.running { "Running…" } else { "Run" };
-        let run_button = Button::new("run-query", run_label)
-            .style(ButtonStyle::Filled)
+        let run_button = IconButton::new("run-query", IconName::PlayFilled)
+            .shape(IconButtonShape::Square)
+            .icon_color(Color::Success)
             .disabled(self.running)
+            .tooltip(Tooltip::text("Run Query (⌘↵)"))
             .on_click(cx.listener(|this, _, window, cx| {
                 this.run(&RunQuery, window, cx);
             }));
@@ -539,37 +555,55 @@ impl Render for QueryView {
             .gap_2()
             .border_b_1()
             .border_color(cx.theme().colors().border)
+            .child(run_button)
+            .when(self.running, |toolbar| {
+                toolbar.child(
+                    Label::new("Running…")
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                )
+            })
             .child(
                 Label::new(profile_name)
                     .size(LabelSize::Small)
                     .color(Color::Muted),
             )
-            .child(run_button)
-            .when_some(
-                self.result.as_ref().zip(self.elapsed_ms),
-                |toolbar, (result, elapsed)| {
-                    let row_count = result.rows.len();
-                    let truncated = result.truncated;
-                    toolbar
-                        .child(
-                            Label::new(format!("{} rows", row_count))
-                                .size(LabelSize::Small)
-                                .color(Color::Muted),
-                        )
-                        .child(
-                            Label::new(format!("{} ms", elapsed))
-                                .size(LabelSize::Small)
-                                .color(Color::Muted),
-                        )
-                        .when(truncated, |toolbar| {
-                            toolbar.child(
-                                Label::new(format!("(showing first {})", DEFAULT_RESULT_LIMIT))
-                                    .size(LabelSize::Small)
-                                    .color(Color::Muted),
-                            )
-                        })
-                },
-            );
+            .when_some(database_name, |toolbar, database| {
+                toolbar.child(
+                    Label::new(database)
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                )
+            })
+            .child(Indicator::dot().color(status_color))
+            .when_some(self.result.as_ref(), |toolbar, result| {
+                toolbar.child(
+                    Label::new(row_info_text(result.rows.len(), self.has_more))
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                )
+            })
+            .when(self.has_more && !self.running, |toolbar| {
+                toolbar.child(
+                    Button::new("load-more", "Load more")
+                        .label_size(LabelSize::Small)
+                        .on_click(cx.listener(|this, _, _window, cx| this.load_more(cx))),
+                )
+            })
+            .when_some(self.elapsed_ms, |toolbar, elapsed| {
+                toolbar.child(
+                    Label::new(format_duration(elapsed))
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                )
+            })
+            .when(non_wrappable_truncated, |toolbar| {
+                toolbar.child(
+                    Label::new(format!("(showing first {page_size})"))
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                )
+            });
 
         let results_area: AnyElement = if let Some(error) = &self.error {
             let error_msg = format!("Error: {}", error);
