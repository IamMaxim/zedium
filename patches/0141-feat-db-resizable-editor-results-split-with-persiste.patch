 }
 
@@ -42,29 +46,32 @@ impl QueryDb {
         profile_id: String,
         sql: String,
         database: Option<String>,
+        editor_ratio: Option<f64>,
     ) -> Result<()> {
         self.write(move |conn| {
             let query_str =
-                "INSERT INTO database_query_views (item_id, workspace_id, profile_id, sql, database)
-                VALUES (?1, ?2, ?3, ?4, ?5)
+                "INSERT INTO database_query_views (item_id, workspace_id, profile_id, sql, database, editor_ratio)
+                VALUES (?1, ?2, ?3, ?4, ?5, ?6)
                 ON CONFLICT (item_id, workspace_id) DO UPDATE SET
                     profile_id = excluded.profile_id,
                     sql = excluded.sql,
-                    database = excluded.database";
+                    database = excluded.database,
+                    editor_ratio = excluded.editor_ratio";
             let mut statement = Statement::prepare(conn, query_str)?;
             let mut next_index = statement.bind(&item_id, 1)?;
             next_index = statement.bind(&workspace_id, next_index)?;
             next_index = statement.bind(&profile_id, next_index)?;
             next_index = statement.bind(&sql, next_index)?;
-            statement.bind(&database, next_index)?;
+            next_index = statement.bind(&database, next_index)?;
+            statement.bind(&editor_ratio, next_index)?;
             statement.exec()
         })
         .await
     }
 
     query! {
-        pub fn get_query(item_id: ItemId, workspace_id: WorkspaceId) -> Result<Option<(String, String, Option<String>)>> {
-            SELECT profile_id, sql, database
+        pub fn get_query(item_id: ItemId, workspace_id: WorkspaceId) -> Result<Option<(String, String, Option<String>, Option<f64>)>> {
+            SELECT profile_id, sql, database, editor_ratio
             FROM database_query_views
             WHERE item_id = ? AND workspace_id = ?
         }
@@ -94,11 +101,12 @@ mod tests {
                 "p1".to_string(),
                 "select 1".to_string(),
                 Some("otherdb".to_string()),
+                None,
             )
             .await
             .unwrap();
 
-        let (profile_id, sql, database) = query_db.get_query(1, workspace_id).unwrap().unwrap();
+        let (profile_id, sql, database, _) = query_db.get_query(1, workspace_id).unwrap().unwrap();
         assert_eq!(profile_id, "p1");
         assert_eq!(sql, "select 1");
         assert_eq!(database, Some("otherdb".to_string()));
@@ -118,11 +126,59 @@ mod tests {
                 "p1".to_string(),
                 "select 1".to_string(),
                 None,
+                None,
             )
             .await
             .unwrap();
 
-        let (_, _, database) = query_db.get_query(2, workspace_id).unwrap().unwrap();
+        let (_, _, database, _) = query_db.get_query(2, workspace_id).unwrap().unwrap();
         assert_eq!(database, None);
     }
+
+    #[gpui::test]
+    async fn round_trips_editor_ratio(cx: &mut TestAppContext) {
+        init_test(cx);
+        let workspace_db = cx.update(|cx| WorkspaceDb::global(cx));
+        let workspace_id = workspace_db.next_id().await.unwrap();
+        let query_db = cx.update(|cx| QueryDb::global(cx));
+
+        query_db
+            .save_query(
+                3,
+                workspace_id,
+                "p1".to_string(),
+                "select 1".to_string(),
+                None,
+                Some(0.42),
+            )
+            .await
+            .unwrap();
+
+        let (_, _, _, editor_ratio) = query_db.get_query(3, workspace_id).unwrap().unwrap();
+        assert_eq!(editor_ratio, Some(0.42));
+    }
+
+    #[gpui::test]
+    async fn missing_editor_ratio_loads_as_none(cx: &mut TestAppContext) {
+        init_test(cx);
+        let workspace_db = cx.update(|cx| WorkspaceDb::global(cx));
+        let workspace_id = workspace_db.next_id().await.unwrap();
+        let query_db = cx.update(|cx| QueryDb::global(cx));
+
+        // NULL back-compat: rows written before the editor_ratio migration have NULL.
+        query_db
+            .save_query(
+                4,
+                workspace_id,
+                "p1".to_string(),
+                "select 1".to_string(),
+                None,
+                None,
+            )
+            .await
+            .unwrap();
+
+        let (_, _, _, editor_ratio) = query_db.get_query(4, workspace_id).unwrap().unwrap();
+        assert_eq!(editor_ratio, None);
+    }
 }
