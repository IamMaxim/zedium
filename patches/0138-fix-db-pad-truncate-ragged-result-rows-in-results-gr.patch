From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Thu, 2 Jul 2026 11:28:51 +0300
Subject: [PATCH] fix(db): pad/truncate ragged result rows in results grid
 render

collect_result keeps the first statement's columns for multi-statement
batches but appends every subsequent Row message, so rows can have a
cell count differing from the column list. The uniform_list processor
built one cell per row entry, tripping TableRow::from_vec's rectangular
invariant and panicking (e.g. `SELECT 1; SELECT 1, 2;`). Iterate the
column count instead, rendering NULL for missing cells and dropping
extras, matching the defensive row.get() used everywhere else in the
grid.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MQKuAnEREjToPLedE7KAqP
---
 crates/database_client/src/results_grid.rs | 32 +++++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/crates/database_client/src/results_grid.rs b/crates/database_client/src/results_grid.rs
index 30122c1838..e270c57471 100644
--- a/crates/database_client/src/results_grid.rs
+++ b/crates/database_client/src/results_grid.rs
@@ -446,7 +446,13 @@ impl Render for ResultsGrid {
                                     .child(SharedString::from((row_ix + 1).to_string()))
                                     .into_any_element(),
                             );
-                            for (col_ix, cell) in row.iter().enumerate() {
+                            // Multi-statement batches can yield ragged rows
+                            // (cell counts differing from the column list);
+                            // pad with NULL / truncate to the column count so
+                            // Table's rectangular row invariant holds instead
+                            // of panicking.
+                            for col_ix in 0..data_cols {
+                                let cell = row.get(col_ix).unwrap_or(&None);
                                 cells.push(this.render_cell(
                                     row_ix, col_ix, cell, row_height, selected, &numeric, cx,
                                 ));
@@ -720,4 +726,28 @@ mod tests {
         });
         cx.run_until_parked();
     }
+
+    #[gpui::test]
+    async fn grid_renders_ragged_rows_without_panicking(cx: &mut gpui::TestAppContext) {
+        init_test(cx);
+        // Multi-statement batches (e.g. `SELECT 1; SELECT 1, 2;`) can produce
+        // rows whose cell count differs from the column list; the grid must
+        // pad/truncate such rows instead of panicking in Table's row builder.
+        let (_grid, cx) = cx.add_window_view(|_window, cx| {
+            let mut grid = ResultsGrid::new(cx);
+            let result = QueryResult {
+                columns: vec!["id".into()],
+                rows: vec![
+                    vec![Some("1".into())],
+                    vec![Some("1".into()), Some("2".into())],
+                    vec![],
+                ],
+                command_tag: None,
+                truncated: false,
+            };
+            grid.set_result(Some(result), true, cx);
+            grid
+        });
+        cx.run_until_parked();
+    }
 }
