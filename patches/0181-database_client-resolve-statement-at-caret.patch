From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Sat, 4 Jul 2026 17:49:43 +0300
Subject: [PATCH] database_client: resolve statement at caret

---
 crates/database_client/src/sql_statements.rs | 61 ++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/crates/database_client/src/sql_statements.rs b/crates/database_client/src/sql_statements.rs
index 975dd1b52b..52dce47665 100644
--- a/crates/database_client/src/sql_statements.rs
+++ b/crates/database_client/src/sql_statements.rs
@@ -51,6 +51,23 @@ pub fn split(text: &str) -> Vec<StatementRange> {
     ranges
 }
 
+/// Returns the statement whose range the caret belongs to. A caret inside a
+/// statement returns that statement; a caret in the whitespace/comment gap
+/// between statements maps to the *following* statement; a caret past the last
+/// statement maps to the last one. Returns `None` for empty / whitespace-only
+/// text.
+pub fn statement_at(text: &str, cursor_offset: usize) -> Option<StatementRange> {
+    let statements = split(text);
+    // First statement whose end is at/after the caret: forward-maps a caret
+    // that sits before or between statements onto the following statement,
+    // while `<=` keeps an end-of-statement caret on the statement it just left.
+    statements
+        .iter()
+        .find(|statement| cursor_offset <= statement.end)
+        .copied()
+        .or_else(|| statements.last().copied())
+}
+
 /// Advances past a quoted string that opens at `open` (the opening quote byte).
 /// Doubled quotes (`''`, `""`) are in-string escapes. Returns the index just
 /// past the closing quote, or the end of input when unterminated.
@@ -268,4 +285,48 @@ mod tests {
         // `$1` (a placeholder) is not a dollar-quote opener.
         assert_eq!(texts("select $1; select 2"), vec!["select $1", "select 2"]);
     }
+
+    #[test]
+    fn statement_at_returns_the_enclosing_statement() {
+        let text = "select 1; select 2; select 3";
+        // Offset inside "select 2" (starts at 10).
+        let range = statement_at(text, 12).expect("cursor is inside a statement");
+        assert_eq!(&text[range.start..range.end], "select 2");
+    }
+
+    #[test]
+    fn statement_at_caret_at_end_of_a_statement_selects_it() {
+        let text = "select 1; select 2";
+        // Offset 8 == just after "select 1", before the ';'.
+        let range = statement_at(text, 8).expect("end-of-statement caret");
+        assert_eq!(&text[range.start..range.end], "select 1");
+    }
+
+    #[test]
+    fn statement_at_in_gap_maps_to_the_following_statement() {
+        let text = "select 1;   select 2";
+        // Offset 10 sits in the whitespace gap before "select 2".
+        let range = statement_at(text, 10).expect("gap maps forward");
+        assert_eq!(&text[range.start..range.end], "select 2");
+    }
+
+    #[test]
+    fn statement_at_leading_whitespace_maps_to_first_statement() {
+        let text = "   select 1; select 2";
+        let range = statement_at(text, 0).expect("leading whitespace maps forward");
+        assert_eq!(&text[range.start..range.end], "select 1");
+    }
+
+    #[test]
+    fn statement_at_past_last_statement_maps_to_last() {
+        let text = "select 1; select 2   ";
+        let range = statement_at(text, text.len()).expect("trailing caret maps to last");
+        assert_eq!(&text[range.start..range.end], "select 2");
+    }
+
+    #[test]
+    fn statement_at_empty_text_is_none() {
+        assert_eq!(statement_at("", 0), None);
+        assert_eq!(statement_at("   \n ", 2), None);
+    }
 }
