index 0000000000..975dd1b52b
--- /dev/null
+++ b/crates/database_client/src/sql_statements.rs
@@ -0,0 +1,271 @@
+//! Pure SQL statement splitting for granular execution and history. Scans raw
+//! buffer text into byte-offset ranges, skipping quoted strings, dollar-quoted
+//! bodies, and `--` / `/* */` comments so that only top-level `;` delimit.
+//!
+//! `split`/`StatementRange` are not yet wired into callers (that lands in a
+//! later task), so allow dead code here in the meantime.
+#![allow(dead_code)]
+
+/// Byte-offset range of one SQL statement within the buffer text. `start..end`
+/// is a valid char-boundary slice of the source string.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct StatementRange {
+    pub start: usize,
+    pub end: usize,
+}
+
+/// Splits `text` into top-level SQL statements. Semicolons delimit statements;
+/// the final statement need not be terminated. Semicolons inside single/double
+/// quoted strings, dollar-quoted bodies (`$tag$…$tag$`), `--` line comments and
+/// `/* … */` (nesting) block comments are not delimiters. Whitespace-only
+/// fragments are dropped, and each returned range is trimmed of surrounding
+/// whitespace.
+pub fn split(text: &str) -> Vec<StatementRange> {
+    let bytes = text.as_bytes();
+    let mut ranges = Vec::new();
+    let mut statement_start = 0usize;
+    let mut index = 0usize;
+    while index < bytes.len() {
+        let byte = bytes[index];
+        match byte {
+            b'\'' | b'"' => index = skip_quoted(bytes, index, byte),
+            b'-' if bytes.get(index + 1) == Some(&b'-') => {
+                index = skip_line_comment(bytes, index + 2);
+            }
+            b'/' if bytes.get(index + 1) == Some(&b'*') => {
+                index = skip_block_comment(bytes, index + 2);
+            }
+            b'$' => match dollar_quote(bytes, index) {
+                Some(past_close) => index = past_close,
+                None => index += 1,
+            },
+            b';' => {
+                push_statement(text, &mut ranges, statement_start, index);
+                index += 1;
+                statement_start = index;
+            }
+            _ => index += 1,
+        }
+    }
+    push_statement(text, &mut ranges, statement_start, bytes.len());
+    ranges
+}
+
+/// Advances past a quoted string that opens at `open` (the opening quote byte).
+/// Doubled quotes (`''`, `""`) are in-string escapes. Returns the index just
+/// past the closing quote, or the end of input when unterminated.
+fn skip_quoted(bytes: &[u8], open: usize, quote: u8) -> usize {
+    let mut index = open + 1;
+    while index < bytes.len() {
+        if bytes[index] == quote {
+            if bytes.get(index + 1) == Some(&quote) {
+                index += 2;
+                continue;
+            }
+            return index + 1;
+        }
+        index += 1;
+    }
+    bytes.len()
+}
+
+/// Advances from `from` to the newline that ends a `--` comment (or to the end
+/// of input). The newline itself is left for the main loop to consume.
+fn skip_line_comment(bytes: &[u8], from: usize) -> usize {
+    let mut index = from;
+    while index < bytes.len() && bytes[index] != b'\n' {
+        index += 1;
+    }
+    index
+}
+
+/// Advances past a `/* … */` block comment whose body starts at `from`.
+/// Postgres block comments nest, so track depth. Returns the index just past
+/// the outermost `*/`, or the end of input when unterminated.
+fn skip_block_comment(bytes: &[u8], from: usize) -> usize {
+    let mut index = from;
+    let mut depth = 1usize;
+    while index < bytes.len() {
+        if bytes[index] == b'/' && bytes.get(index + 1) == Some(&b'*') {
+            depth += 1;
+            index += 2;
+        } else if bytes[index] == b'*' && bytes.get(index + 1) == Some(&b'/') {
+            depth -= 1;
+            index += 2;
+            if depth == 0 {
+                return index;
+            }
+        } else {
+            index += 1;
+        }
+    }
+    bytes.len()
+}
+
+/// If a dollar-quote opens at `dollar` (a `$`), returns the index just past its
+/// matching close tag (or end of input when unterminated). Returns `None` when
+/// `dollar` is not a valid opener (e.g. `$1`), so the caller treats `$` as an
+/// ordinary character. A valid tag is `$$` or `$ident$` where `ident` starts
+/// with a letter/underscore.
+fn dollar_quote(bytes: &[u8], dollar: usize) -> Option<usize> {
+    let mut cursor = dollar + 1;
+    while cursor < bytes.len() && bytes[cursor] != b'$' {
+        let byte = bytes[cursor];
+        let is_first = cursor == dollar + 1;
+        let valid =
+            byte == b'_' || byte.is_ascii_alphabetic() || (!is_first && byte.is_ascii_digit());
+        if !valid {
+            return None;
+        }
+        cursor += 1;
+    }
+    if cursor >= bytes.len() || bytes[cursor] != b'$' {
+        return None;
+    }
+    let Some(tag) = bytes.get(dollar..=cursor) else {
+        return None;
+    };
+    let tag_len = tag.len();
+    let mut index = cursor + 1;
+    while index + tag_len <= bytes.len() {
+        if bytes.get(index..index + tag_len) == Some(tag) {
+            return Some(index + tag_len);
+        }
+        index += 1;
+    }
+    Some(bytes.len())
+}
+
+/// Pushes the statement occupying `start..end` after trimming surrounding
+/// whitespace; a whitespace-only fragment is dropped. Uses checked slicing so a
+/// malformed offset can never panic.
+fn push_statement(text: &str, ranges: &mut Vec<StatementRange>, start: usize, end: usize) {
+    let Some(fragment) = text.get(start..end) else {
+        return;
+    };
+    let trimmed = fragment.trim();
+    if trimmed.is_empty() {
+        return;
+    }
+    let leading = fragment.len() - fragment.trim_start().len();
+    let real_start = start + leading;
+    ranges.push(StatementRange {
+        start: real_start,
+        end: real_start + trimmed.len(),
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn texts(text: &str) -> Vec<&str> {
+        split(text)
+            .into_iter()
+            .map(|range| &text[range.start..range.end])
+            .collect()
+    }
+
+    #[test]
+    fn split_single_statement_without_trailing_semicolon() {
+        assert_eq!(texts("select 1"), vec!["select 1"]);
+    }
+
+    #[test]
+    fn split_trims_surrounding_whitespace_of_each_statement() {
+        let text = "  select 1 ;\n\n  select 2  ";
+        assert_eq!(texts(text), vec!["select 1", "select 2"]);
+        // Offsets point at the trimmed slice, not the whitespace.
+        let first = split(text)[0];
+        assert_eq!(&text[first.start..first.end], "select 1");
+    }
+
+    #[test]
+    fn split_ignores_empty_fragments_and_trailing_semicolon() {
+        assert_eq!(texts("select 1;;\n  ;  "), vec!["select 1"]);
+        assert_eq!(texts(""), Vec::<&str>::new());
+        assert_eq!(texts("   \n  "), Vec::<&str>::new());
+    }
+
+    #[test]
+    fn split_multiple_statements() {
+        assert_eq!(
+            texts("select 1; update t set a = 2; delete from t"),
+            vec!["select 1", "update t set a = 2", "delete from t"]
+        );
+    }
+
+    #[test]
+    fn split_semicolon_inside_single_quoted_string_is_not_a_delimiter() {
+        assert_eq!(
+            texts("select 'a;b' as x; select 2"),
+            vec!["select 'a;b' as x", "select 2"]
+        );
+    }
+
+    #[test]
+    fn split_doubled_single_quote_is_an_escape_not_a_terminator() {
+        // 'it''s; fine' is ONE string literal containing a semicolon.
+        assert_eq!(texts("select 'it''s; fine'"), vec!["select 'it''s; fine'"]);
+    }
+
+    #[test]
+    fn split_semicolon_inside_double_quoted_identifier_is_not_a_delimiter() {
+        assert_eq!(
+            texts(r#"select 1 as "a;b"; select 2"#),
+            vec![r#"select 1 as "a;b""#, "select 2"]
+        );
+    }
+
+    #[test]
+    fn split_semicolon_inside_anonymous_dollar_quote_is_not_a_delimiter() {
+        assert_eq!(
+            texts("select $$a;b$$; select 2"),
+            vec!["select $$a;b$$", "select 2"]
+        );
+    }
+
+    #[test]
+    fn split_semicolon_inside_tagged_dollar_quote_is_not_a_delimiter() {
+        // A tagged body that itself contains `$$` must only close on `$fn$`.
+        let text =
+            "create function f() returns int language sql as $fn$ select 1; $$x$$ ; $fn$; select 2";
+        assert_eq!(
+            texts(text),
+            vec![
+                "create function f() returns int language sql as $fn$ select 1; $$x$$ ; $fn$",
+                "select 2"
+            ]
+        );
+    }
+
+    #[test]
+    fn split_semicolon_inside_line_comment_is_not_a_delimiter() {
+        assert_eq!(
+            texts("select 1 -- a;b\n; select 2"),
+            vec!["select 1 -- a;b", "select 2"]
+        );
+    }
+
+    #[test]
+    fn split_semicolon_inside_block_comment_is_not_a_delimiter() {
+        assert_eq!(
+            texts("select 1 /* a;b */; select 2"),
+            vec!["select 1 /* a;b */", "select 2"]
+        );
+    }
+
+    #[test]
+    fn split_nested_block_comment_closes_at_matching_depth() {
+        assert_eq!(
+            texts("select 1 /* outer /* inner ; */ still ; */; select 2"),
+            vec!["select 1 /* outer /* inner ; */ still ; */", "select 2"]
+        );
+    }
+
+    #[test]
+    fn split_bare_dollar_sign_is_an_ordinary_char() {
+        // `$1` (a placeholder) is not a dollar-quote opener.
+        assert_eq!(texts("select $1; select 2"), vec!["select $1", "select 2"]);
+    }
+}
