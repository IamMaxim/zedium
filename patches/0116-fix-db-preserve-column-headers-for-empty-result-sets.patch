From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 23:21:12 +0300
Subject: [PATCH] fix(db): preserve column headers for empty result sets

---
 .../database_client/src/connection/client.rs  | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/crates/database_client/src/connection/client.rs b/crates/database_client/src/connection/client.rs
index 14e3febad2..d4e5e6cb46 100644
--- a/crates/database_client/src/connection/client.rs
+++ b/crates/database_client/src/connection/client.rs
@@ -93,6 +93,11 @@ pub(crate) fn collect_result(
     let mut command_tag = None;
     for msg in messages {
         match msg {
+            RowDescription(cols) => {
+                if columns.is_empty() {
+                    columns = cols.iter().map(|c| c.name().to_string()).collect();
+                }
+            }
             Row(row) => {
                 if columns.is_empty() {
                     columns = row.columns().iter().map(|c| c.name().to_string()).collect();
@@ -170,4 +175,30 @@ mod tests {
         assert_eq!(result.columns, vec!["one".to_string(), "n".to_string()]);
         assert_eq!(result.rows, vec![vec![Some("1".to_string()), None]]);
     }
+
+    // Zero-row results must still carry column headers (RowDescription arrives
+    // before any data row, even when there are no rows).
+    #[gpui::test]
+    #[ignore]
+    async fn live_empty_result_preserves_column_headers(cx: &mut gpui::TestAppContext) {
+        let Ok(url) = std::env::var("DATABASE_CLIENT_TEST_PG_URL") else {
+            return;
+        };
+        cx.executor().allow_parking();
+        cx.update(|cx| gpui_tokio::init(cx));
+        let profile = crate::connection::profile::ConnectionProfile::from_url(&url).unwrap();
+        let password = profile_password_from_url(&url);
+        let conn = cx
+            .update(|cx| Connection::connect(profile, password, cx))
+            .await
+            .unwrap();
+        let result = cx
+            .update(|cx| {
+                conn.execute("select 1 as one, 'x' as label where false".into(), 500, cx)
+            })
+            .await
+            .unwrap();
+        assert_eq!(result.columns, vec!["one".to_string(), "label".to_string()]);
+        assert!(result.rows.is_empty());
+    }
 }
