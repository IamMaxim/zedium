From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Sat, 4 Jul 2026 13:47:04 +0300
Subject: [PATCH] docs(db): document the new density settings in default.json

---
 assets/settings/default.json | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/assets/settings/default.json b/assets/settings/default.json
index f703597fc7..3f66b2b3e4 100644
--- a/assets/settings/default.json
+++ b/assets/settings/default.json
@@ -2684,7 +2684,40 @@
     // Defaults to the buffer font size when null.
     "results_font_size": null,
     // Number of rows fetched per page of query results (minimum 50).
-    "page_size": 500
+    "page_size": 500,
+    // Horizontal padding (px, per side) of results-grid cells. Clamped to
+    // the range 0-24. Defaults to 6 when null.
+    "results_row_padding": null,
+    // Line height of the query results grid, decoupled from the global
+    // `ui_line_height`. Can be "comfortable", "standard", or
+    // {"custom": N}. Falls back to the global `ui_line_height` when null.
+    "results_line_height": null,
+    // Density settings for the sidebar connection/database/schema/table tree.
+    "sidebar": {
+      // Vertical padding (px) added to each tree row, on top of the row's
+      // content height. Clamped to the range 0-40. Unset = current row
+      // height, unchanged.
+      "padding": null,
+      // Font size (px) of tree row labels. Defaults to the UI font size
+      // when null.
+      "font_size": null,
+      // Icon size (px) of node and disclosure icons. Clamped to the range
+      // 6-48. Defaults to 14 when null.
+      "icon_size": null
+    },
+    // Density settings for the query console toolbar (Run button, status
+    // labels).
+    "toolbar": {
+      // Vertical padding (px) of the toolbar. Clamped to the range 0-40.
+      // Defaults to the current 4px padding when null.
+      "padding": null,
+      // Font size (px) of toolbar labels and buttons. Unset = current
+      // fixed sizes.
+      "font_size": null,
+      // Icon size (px) of the Run button. Clamped to the range 6-48.
+      // Unset = current icon size.
+      "icon_size": null
+    }
   },
   "debugger": {
     "stepping_granularity": "line",
