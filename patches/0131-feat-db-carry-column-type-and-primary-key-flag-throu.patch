+    #[test]
+    fn column_nodes_carry_type_and_primary_key() {
+        let mut t = loaded_tree();
+        t.toggle("p1/db1/public/users");
+        t.set_columns(
+            "p1/db1/public/users",
+            vec![
+                ColumnInfo {
+                    name: "id".into(),
+                    data_type: "integer".into(),
+                    is_primary_key: true,
+                },
+                ColumnInfo {
+                    name: "email".into(),
+                    data_type: "text".into(),
+                    is_primary_key: false,
+                },
+            ],
+        );
+        let nodes = t.visible_nodes();
+        assert_eq!(nodes[4].column_data_type.as_deref(), Some("integer"));
+        assert!(nodes[4].is_primary_key);
+        assert_eq!(nodes[5].column_data_type.as_deref(), Some("text"));
+        assert!(!nodes[5].is_primary_key);
+        assert!(
+            nodes[0].column_data_type.is_none(),
+            "non-column nodes carry no type"
+        );
+    }
+
