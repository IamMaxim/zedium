From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Tue, 23 Jun 2026 23:02:05 +0300
Subject: [PATCH] agent_servers: select qwen subagent-grouping adapter by agent
 name

AcpConnection now carries an optional SubagentGrouping chosen from the agent's
self-reported name ("qwen-code" -> QwenSubagentGrouping) and exposes it via
AgentConnection::subagent_grouping(), so qwen subagent tool calls are classified
into the thread's SubagentIndex at ingest. NativeAgentConnection is intentionally
left on its existing path this iteration (see .overnight worklog).

Verified: cargo check -p agent_servers (exit 0).

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018eQmq1oThzqNcQsJ1hT2Tg
---
 crates/agent_servers/src/acp.rs | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/crates/agent_servers/src/acp.rs b/crates/agent_servers/src/acp.rs
index d5f5ae376c..b03477f1dd 100644
--- a/crates/agent_servers/src/acp.rs
+++ b/crates/agent_servers/src/acp.rs
@@ -37,7 +37,10 @@ use util::process::Child;
 use anyhow::{Context as _, Result};
 use gpui::{App, AppContext as _, AsyncApp, Entity, SharedString, Subscription, Task, WeakEntity};
 
-use acp_thread::{AcpThread, AuthRequired, LoadError, TerminalProviderEvent};
+use acp_thread::{
+    AcpThread, AuthRequired, LoadError, QwenSubagentGrouping, SubagentGrouping,
+    TerminalProviderEvent,
+};
 use terminal::TerminalBuilder;
 use terminal::terminal_settings::{AlternateScroll, CursorShape};
 
@@ -427,6 +430,7 @@ pub struct AcpConnection {
     defaults: AcpConnectionDefaults,
     child: Option<Child>,
     session_list: Option<Rc<AcpSessionList>>,
+    subagent_grouping: Option<Rc<dyn SubagentGrouping>>,
     debug_log: AcpDebugLog,
     _settings_subscription: Subscription,
     _io_task: Task<()>,
@@ -1060,6 +1064,14 @@ impl AcpConnection {
         } else {
             response.auth_methods
         };
+        // Select a subagent-grouping adapter from the agent's self-reported name.
+        // qwen-code expresses subagents as flat same-session tool calls tagged via
+        // meta, which the Qwen adapter reconstructs into a tree.
+        let subagent_grouping: Option<Rc<dyn SubagentGrouping>> = match telemetry_id.as_ref() {
+            "qwen-code" => Some(Rc::new(QwenSubagentGrouping)),
+            _ => None,
+        };
+
         let defaults = AcpConnectionDefaults::new(default_mode, default_config_options);
         let settings_subscription = cx.update({
             let agent_id = agent_id.clone();
@@ -1079,6 +1091,7 @@ impl AcpConnection {
             agent_capabilities: response.agent_capabilities,
             defaults,
             session_list,
+            subagent_grouping,
             debug_log,
             _settings_subscription: settings_subscription,
             _io_task: io_task,
@@ -1120,6 +1133,7 @@ impl AcpConnection {
             defaults,
             child: None,
             session_list: None,
+            subagent_grouping: None,
             debug_log: AcpDebugLog::default(),
             _settings_subscription: settings_subscription,
             _io_task: io_task,
@@ -1530,6 +1544,10 @@ impl AgentConnection for AcpConnection {
         self.agent_version.clone()
     }
 
+    fn subagent_grouping(&self) -> Option<Rc<dyn SubagentGrouping>> {
+        self.subagent_grouping.clone()
+    }
+
     fn new_session(
         self: Rc<Self>,
         project: Entity<Project>,
