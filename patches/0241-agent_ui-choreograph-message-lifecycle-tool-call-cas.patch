+    #[gpui::test]
+    fn test_follow_tail_snap_throttle(cx: &mut TestAppContext) {
+        let cx = cx.add_empty_window();
+
+        // 10 items x 50px = 500px total, 200px viewport.
+        let item_height = Rc::new(Cell::new(50));
+        let state = ListState::new(10, crate::ListAlignment::Top, px(0.));
+
+        struct TestView {
+            state: ListState,
+            item_height: Rc<Cell<usize>>,
+        }
+        impl Render for TestView {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                let height = self.item_height.get();
+                list(self.state.clone(), move |_, _, _| {
+                    div().h(px(height as f32)).w_full().into_any()
+                })
+                .w_full()
+                .h_full()
+            }
+        }
+
+        let view = cx.update(|_, cx| {
+            cx.new(|_| TestView {
+                state: state.clone(),
+                item_height: item_height.clone(),
+            })
+        });
+
+        state.set_follow_mode(FollowMode::Tail);
+        state.set_follow_snap_throttle(Some(Duration::from_millis(100)));
+
+        // First layout snaps to the tail (no previous snap recorded):
+        // 500px content - 200px viewport => item 6, offset 0.
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(200.)), |_, _| {
+            view.clone().into_any_element()
+        });
+        let offset = state.logical_scroll_top();
+        assert_eq!(offset.item_ix, 6);
+        assert_eq!(offset.offset_in_item, px(0.));
+        assert!(state.is_following_tail());
+
+        // Items grow (streaming): a layout inside the throttle window keeps
+        // the previous anchor instead of re-snapping.
+        item_height.set(80);
+        state.remeasure();
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(200.)), |_, _| {
+            view.clone().into_any_element()
+        });
+        let offset = state.logical_scroll_top();
+        assert_eq!(offset.item_ix, 6, "snap should be throttled");
+        assert_eq!(offset.offset_in_item, px(0.));
+        assert!(state.is_following_tail());
+
+        // Once the throttle elapses, the next layout re-anchors to the tail:
+        // 800px content - 200px viewport = 600px => item 7, offset 40px.
+        cx.executor().advance_clock(Duration::from_millis(120));
+        cx.draw(point(px(0.), px(0.)), size(px(100.), px(200.)), |_, _| {
+            view.into_any_element()
+        });
+        let offset = state.logical_scroll_top();
+        assert_eq!(offset.item_ix, 7);
+        assert_eq!(offset.offset_in_item, px(40.));
+        assert!(state.is_following_tail());
+    }
 }
