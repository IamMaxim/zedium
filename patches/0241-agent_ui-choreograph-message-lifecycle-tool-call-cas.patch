@@ -94,6 +94,48 @@ pub trait DefaultAnimations: Styled + Sized + Element {
     fn animate_in_from_top(self, fade: bool) -> AnimationElement<Self> {
         self.animate_in(AnimationDirection::FromTop, fade)
     }
+
+    /// A subtle entrance: optional fade from 40% opacity plus an 8px rise over
+    /// 150ms with `ease_out_quint`. Unlike [`Self::animate_in`], the element
+    /// ends at its natural position (no residual inset), so it is safe to use
+    /// on persistent content such as list entries.
+    fn animate_in_subtle(self, fade: bool) -> AnimationElement<Self> {
+        let animation_id = self.id().map_or_else(
+            || ElementId::from("animate_in_subtle"),
+            |id| (id, "animate_in_subtle").into(),
+        );
+
+        self.with_animation(
+            animation_id,
+            gpui::Animation::new(AnimationDuration::Fast.into()).with_easing(ease_out_quint()),
+            move |mut this, delta| {
+                if fade {
+                    let start_opacity = 0.4;
+                    this = this.opacity(start_opacity + delta * (1.0 - start_opacity));
+                }
+                let rise = 8.0;
+                this.bottom(px(rise * (delta - 1.0)))
+            },
+        )
+    }
+
+    /// An opacity-only entrance (40% -> 100% over 150ms). Used as the
+    /// reduced-motion counterpart of [`Self::animate_in_subtle`].
+    fn fade_in(self) -> AnimationElement<Self> {
+        let animation_id = self.id().map_or_else(
+            || ElementId::from("fade_in"),
+            |id| (id, "fade_in").into(),
+        );
+
+        self.with_animation(
+            animation_id,
+            gpui::Animation::new(AnimationDuration::Fast.into()).with_easing(ease_out_quint()),
+            move |this, delta| {
+                let start_opacity = 0.4;
+                this.opacity(start_opacity + delta * (1.0 - start_opacity))
+            },
+        )
+    }
 }
 
 impl<E: Styled + Element> DefaultAnimations for E {}
