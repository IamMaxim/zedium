+    /// the jumpiness of stick-to-bottom scrolling during streaming content.
+    /// `None` (the default) snaps on every layout pass.
+    pub fn set_follow_snap_throttle(&self, throttle: Option<Duration>) {
+        self.0.borrow_mut().follow_snap_throttle = throttle;
+    }
