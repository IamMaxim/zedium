From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Tue, 23 Jun 2026 23:10:18 +0300
Subject: [PATCH] agent_ui: render same-session subagents as a grouped,
 expandable card

External ACP providers (qwen) tag subagent steps as flat tool calls on the main
session. Hide those members from the flat transcript and render their root tool
call as a subagent group: the root's summary plus a disclosure that reveals the
member steps inline (reusing render_entry). Members are skipped at the list
processor (zero-height slot keeps list indexing aligned); roots are intercepted
in render_any_tool_call, gated on SubagentIndex::is_same_thread_root so the
native separate-session subagent path is untouched.

Verified: cargo test -p acp_thread (76 passed), cargo check -p agent_ui (clean).
Runtime/visual verification with a live qwen --acp session still pending.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018eQmq1oThzqNcQsJ1hT2Tg
---
 crates/acp_thread/src/acp_thread.rs           |  10 ++
 .../src/conversation_view/thread_view.rs      | 123 +++++++++++++++++-
 2 files changed, 132 insertions(+), 1 deletion(-)

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index 32a47d2879..f3e20940d8 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -393,6 +393,16 @@ impl SubagentIndex {
         self.roots.contains_key(id)
     }
 
+    /// Whether `id` is a root whose subtree lives in this same thread (e.g. qwen),
+    /// as opposed to a separately-loaded child session (native). Only same-thread
+    /// roots are rendered by the generalized group/pop-out path.
+    pub fn is_same_thread_root(&self, id: &acp::ToolCallId) -> bool {
+        matches!(
+            self.roots.get(id).map(|root| &root.subtree),
+            Some(SubagentSubtree::SameThread)
+        )
+    }
+
     pub fn is_member(&self, id: &acp::ToolCallId) -> bool {
         self.membership.contains_key(id)
     }
diff --git a/crates/agent_ui/src/conversation_view/thread_view.rs b/crates/agent_ui/src/conversation_view/thread_view.rs
index e7e56d3178..2eb4e94919 100644
--- a/crates/agent_ui/src/conversation_view/thread_view.rs
+++ b/crates/agent_ui/src/conversation_view/thread_view.rs
@@ -5361,6 +5361,18 @@ impl ThreadView {
             cx.processor(move |this, index: usize, window, cx| {
                 let entries = this.thread.read(cx).entries();
                 if let Some(entry) = entries.get(index) {
+                    // Same-thread subagent members are not shown in the flat transcript;
+                    // they render inside their root's subagent group instead. The list
+                    // slot is kept (zero-height) so list indexing stays aligned.
+                    if let AgentThreadEntry::ToolCall(tool_call) = entry
+                        && this
+                            .thread
+                            .read(cx)
+                            .subagent_index()
+                            .is_member(&tool_call.id)
+                    {
+                        return Empty.into_any();
+                    }
                     let rendered = this.render_entry(index, entries.len(), entry, window, cx);
                     centered_container(rendered.into_any_element()).into_any_element()
                 } else if this.generating_indicator_in_list {
@@ -7147,8 +7159,23 @@ impl ThreadView {
     ) -> Div {
         let has_terminals = tool_call.terminals().next().is_some();
 
+        let is_same_thread_subagent_root = self
+            .thread
+            .read(cx)
+            .subagent_index()
+            .is_same_thread_root(&tool_call.id);
+
         div().w_full().map(|this| {
-            if tool_call.is_subagent() {
+            if is_same_thread_subagent_root {
+                this.child(self.render_subagent_group(
+                    active_session_id,
+                    entry_ix,
+                    tool_call,
+                    focus_handle,
+                    window,
+                    cx,
+                ))
+            } else if tool_call.is_subagent() {
                 this.child(
                     self.render_subagent_tool_call(
                         active_session_id,
@@ -8924,6 +8951,100 @@ impl ThreadView {
             .into_any_element()
     }
 
+    /// Renders a same-thread (e.g. qwen) subagent root: the root tool call's
+    /// summary plus a disclosure that reveals the subagent's member steps inline.
+    /// The members are otherwise hidden from the flat transcript.
+    fn render_subagent_group(
+        &self,
+        active_session_id: &acp::SessionId,
+        entry_ix: usize,
+        tool_call: &ToolCall,
+        focus_handle: &FocusHandle,
+        window: &Window,
+        cx: &Context<Self>,
+    ) -> Div {
+        let thread = self.thread.read(cx);
+        let index = thread.subagent_index();
+        let label = index
+            .root_label(&tool_call.id)
+            .unwrap_or_else(|| "Subagent".into());
+        let member_ids = index.members_of(&tool_call.id);
+
+        let entries = thread.entries();
+        let total_entries = entries.len();
+        let member_indices: Vec<usize> = entries
+            .iter()
+            .enumerate()
+            .filter_map(|(ix, entry)| match entry {
+                AgentThreadEntry::ToolCall(call) if member_ids.contains(&call.id) => Some(ix),
+                _ => None,
+            })
+            .collect();
+        let member_count = member_indices.len();
+
+        let is_expanded = self.expanded_tool_calls.contains(&tool_call.id);
+
+        let summary = self.render_tool_call(
+            active_session_id,
+            entry_ix,
+            tool_call,
+            focus_handle,
+            ToolCallLayout::Standalone,
+            window,
+            cx,
+        );
+
+        let member_rows = (is_expanded && member_count > 0).then(|| {
+            v_flex()
+                .w_full()
+                .gap_1()
+                .children(member_indices.iter().copied().filter_map(|ix| {
+                    entries
+                        .get(ix)
+                        .map(|entry| self.render_entry(ix, total_entries, entry, window, cx))
+                }))
+        });
+
+        let toggle = (member_count > 0).then(|| {
+            h_flex()
+                .id(SharedString::from(format!("subagent-group-toggle-{entry_ix}")))
+                .gap_1p5()
+                .cursor_pointer()
+                .child(
+                    Disclosure::new(
+                        SharedString::from(format!("subagent-group-disclosure-{entry_ix}")),
+                        is_expanded,
+                    )
+                    .opened_icon(IconName::ChevronUp)
+                    .closed_icon(IconName::ChevronDown),
+                )
+                .child(
+                    Label::new(format!("{label} subagent · {member_count} steps"))
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                )
+                .on_click(cx.listener({
+                    let id = tool_call.id.clone();
+                    move |this, _event, _window, cx| {
+                        if this.expanded_tool_calls.contains(&id) {
+                            this.expanded_tool_calls.remove(&id);
+                        } else {
+                            this.expanded_tool_calls.insert(id.clone());
+                        }
+                        cx.notify();
+                    }
+                }))
+        });
+
+        v_flex()
+            .mx_5()
+            .my_1p5()
+            .gap_1p5()
+            .when_some(toggle, |this, toggle| this.child(toggle))
+            .when_some(member_rows, |this, rows| this.child(rows))
+            .child(summary)
+    }
+
     fn render_subagent_tool_call(
         &self,
         active_session_id: &acp::SessionId,
