+        // 28px at 14px/s = 2s
+        assert_eq!(walk.duration(), Duration::from_secs(2));
+        assert_eq!(walk.direction(), WalkDirection::Left);
+        let start = walk.started_at;
+        assert!((walk.position_at(start) - 16.).abs() < 0.01);
+        assert!((walk.position_at(start + Duration::from_secs(1)) - 30.).abs() < 0.01);
+        assert!((walk.position_at(start + Duration::from_secs(10)) - 44.).abs() < 0.01);
+        let back = Walk {
+            from: 44.,
+            to: 16.,
+            started_at: start,
+        };
+        assert_eq!(back.direction(), WalkDirection::Right);
+    }
