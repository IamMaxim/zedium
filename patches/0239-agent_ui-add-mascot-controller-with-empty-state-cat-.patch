+    async fn test_controller(cx: &mut TestAppContext) -> Entity<MascotController> {
+        cx.update(|cx| {
+            let settings_store = SettingsStore::test(cx);
+            cx.set_global(settings_store);
+            AgentSettings::register(cx);
+        });
+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, [], cx).await;
+        let connection = Rc::new(StubAgentConnection::new());
+        let thread = cx
+            .update(|cx| {
+                connection.new_session(project, PathList::new(&[Path::new(path!("/test"))]), cx)
+            })
+            .await
+            .expect("stub connection always creates a session");
+        cx.new(|cx| MascotController::new(thread, cx))
+    }
+
+    #[gpui::test]
+    async fn fidget_fires_within_its_window_and_rearms(cx: &mut TestAppContext) {
+        let controller = test_controller(cx).await;
+        controller.update(cx, |controller, _cx| {
+            assert!(
+                controller.next_fidget_at.is_some(),
+                "fidget should be armed on creation"
+            );
+        });
+        cx.executor()
+            .advance_clock(FIDGET_MAX_DELAY + Duration::from_millis(100));
+        cx.run_until_parked();
+        controller.update(cx, |controller, _cx| {
+            let (state, _) = controller
+                .transient
+                .expect("a fidget transient should have fired within FIDGET_MAX_DELAY");
+            assert!(
+                matches!(
+                    state,
+                    MascotState::Blink
+                        | MascotState::TailFlick
+                        | MascotState::Look
+                        | MascotState::Groom
+                        | MascotState::Stretch
+                ),
+                "fired transient should be a fidget, got {state:?}"
+            );
+            assert!(
+                controller.next_fidget_at.is_some(),
+                "fidget should be re-armed after firing"
+            );
+        });
+    }
+
+    #[gpui::test]
+    async fn sleeping_parks_all_timers(cx: &mut TestAppContext) {
+        let controller = test_controller(cx).await;
+        // Long enough that the sleep threshold has passed and every previously
+        // armed fidget/walk deadline has fired and been cleared.
+        cx.executor()
+            .advance_clock(SLEEP_AFTER + WALK_MAX_DELAY + FIDGET_MAX_DELAY);
+        cx.run_until_parked();
+        controller.update(cx, |controller, cx| {
+            assert!(controller.is_asleep(cx));
+            assert!(
+                controller.next_fidget_at.is_none(),
+                "asleep cat must not keep a fidget deadline"
+            );
+            assert!(
+                controller.next_walk_at.is_none(),
+                "asleep cat must not keep a walk deadline"
+            );
+            assert!(
+                controller._poll_task.is_none(),
+                "asleep cat must be fully parked with no pending wakeup"
+            );
+        });
+    }
