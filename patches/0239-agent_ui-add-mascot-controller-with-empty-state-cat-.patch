+    /// Lazily creates the mascot controller. Re-checked on every call so
+    /// toggling `agent.mascot` at runtime adds/removes the cat without a
+    /// panel restart. Subagent views never get their own cat.
+    fn ensure_mascot(&mut self, cx: &mut Context<Self>) -> Option<Entity<MascotController>> {
+        if self.is_subagent() || !AgentSettings::get_global(cx).mascot {
+            self.mascot = None;
+            return None;
+        }
+        if self.mascot.is_none() {
+            let thread = self.thread.clone();
+            let mascot = cx.new(|cx| MascotController::new(thread, cx));
+            self._subscriptions
+                .push(cx.observe(&mascot, |_, _, cx| cx.notify()));
+            self.mascot = Some(mascot);
+        }
+        self.mascot.clone()
+    }
+
+    /// Reads (state, crossfade_from, animated) for a mascot render. Must be
+    /// called at most once per frame: it consumes the cross-fade source and
+    /// prunes expired one-shots.
+    fn mascot_render_params(
+        &self,
+        mascot: &Entity<MascotController>,
+        cx: &mut App,
+    ) -> (MascotState, Option<MascotState>, bool) {
+        let animated = AgentSettings::get_global(cx).animations == AnimationLevel::Full;
+        let (state, crossfade_from) = mascot.update(cx, |mascot, cx| {
+            let state = mascot.current_state(cx);
+            let crossfade_from = if animated {
+                mascot.take_crossfade_from()
+            } else {
+                None
+            };
+            (state, crossfade_from)
+        });
+        (state, crossfade_from, animated)
+    }
+
+    fn render_empty_state_mascot(
+        &self,
+        mascot: &Entity<MascotController>,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        const GREETINGS: [&str; 4] = [
+            "What are we building?",
+            "Ready when you are.",
+            "Let's make something.",
+            "All ears.",
+        ];
+        let greeting = GREETINGS[self.thread.entity_id().as_u64() as usize % GREETINGS.len()];
+        let (state, crossfade_from, animated) = self.mascot_render_params(mascot, cx);
+        v_flex()
+            .w_full()
+            .items_center()
+            .pt_8()
+            .pb_2()
+            .gap_2()
+            .child(
+                div()
+                    .id("mascot-empty-state")
+                    .cursor_pointer()
+                    .on_click(cx.listener(|this, _, _, cx| {
+                        if let Some(mascot) = &this.mascot {
+                            mascot.update(cx, |mascot, cx| mascot.pet(cx));
+                        }
+                    }))
+                    .child(
+                        MascotPlayer::new("mascot-empty-player", state)
+                            .size(px(96.))
+                            .animated(animated)
+                            .crossfade_from(crossfade_from),
+                    ),
+            )
+            .child(
+                Label::new(greeting)
+                    .size(LabelSize::Small)
+                    .color(Color::Muted),
+            )
+            .into_any_element()
+    }
+
+    /// The 24px companion that "sits on" the composer's top border during an
+    /// active conversation. Positioned absolutely so it overlaps the border
+    /// (2px of the cat below the line, the rest above it). Walks along the
+    /// border and hops on completion when full animations are enabled.
+    fn render_mascot_companion(
+        &self,
+        mascot: &Entity<MascotController>,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        let (state, crossfade_from, animated) = self.mascot_render_params(mascot, cx);
+        let motion = mascot.update(cx, |mascot, cx| mascot.companion_motion(cx));
+        let base = div()
+            .absolute()
+            .top(px(-22.))
+            .id("mascot-companion")
+            .cursor_pointer()
+            .on_click(cx.listener(|this, _, _, cx| {
+                if let Some(mascot) = &this.mascot {
+                    mascot.update(cx, |mascot, cx| mascot.pet(cx));
+                }
+            }))
+            .child(
+                MascotPlayer::new("mascot-companion-player", state)
+                    .size(px(24.))
+                    .animated(animated)
+                    .crossfade_from(crossfade_from),
+            );
+        match (animated, motion.walk, motion.hop) {
+            (true, Some((walk_seq, from, to, duration)), _) => base
+                .with_animation(
+                    ("mascot-walk", walk_seq),
+                    Animation::new(duration),
+                    move |this, delta| this.right(px(from + (to - from) * delta)),
+                )
+                .into_any_element(),
+            (true, None, Some(hop_seq)) => base
+                .right(px(motion.offset))
+                .with_animation(
+                    ("mascot-hop", hop_seq),
+                    Animation::new(HOP_DURATION),
+                    move |this, delta| {
+                        this.top(px(-22. - 10. * (delta * std::f32::consts::PI).sin()))
+                    },
+                )
+                .into_any_element(),
+            _ => base.right(px(motion.offset)).into_any_element(),
+        }
+    }
