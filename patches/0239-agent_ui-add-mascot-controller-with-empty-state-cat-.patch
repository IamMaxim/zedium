@@ -0,0 +1,883 @@
+use std::time::{Duration, Instant};
+
+use acp_thread::{AcpThread, AcpThreadEvent, AgentThreadEntry, ThreadStatus};
+use agent_settings::AgentSettings;
+use gpui::{App, Context, Entity, Subscription, Task};
+use settings::{AnimationLevel, Settings};
+use ui::MascotState;
+
+pub const LISTENING_WINDOW: Duration = Duration::from_secs(2);
+pub const SLEEP_AFTER: Duration = Duration::from_secs(5 * 60);
+pub const FIDGET_MIN_DELAY: Duration = Duration::from_secs(20);
+pub const FIDGET_MAX_DELAY: Duration = Duration::from_secs(60);
+pub const GLANCE_MIN_DELAY: Duration = Duration::from_secs(8);
+pub const GLANCE_MAX_DELAY: Duration = Duration::from_secs(15);
+pub const PERK_DURATION: Duration = Duration::from_millis(1500);
+pub const WALK_MIN_DELAY: Duration = Duration::from_secs(120);
+pub const WALK_MAX_DELAY: Duration = Duration::from_secs(300);
+pub const WALK_SPEED_PX_PER_SEC: f32 = 14.0;
+pub const WALK_OFFSET_MIN: f32 = 16.0;
+pub const WALK_OFFSET_MAX: f32 = 160.0;
+/// Walks shorter than this read as jitter; the walk opportunity is skipped
+/// (the scheduler simply re-arms for the next one).
+pub const MIN_WALK_DISTANCE: f32 = 24.0;
+pub const HOP_DURATION: Duration = Duration::from_millis(300);
+
+/// The executor clock, which gpui's test executor can fake; `Instant::now()`
+/// must never appear in this controller or deadline tests would flake.
+fn executor_now(cx: &App) -> Instant {
+    cx.background_executor().now()
+}
+
+/// Spec 2026-07-10 §4.1 weights: blink 40%, tail flick 25%, look 15%,
+/// groom 10%, stretch 10%.
+pub fn pick_fidget(roll: f32) -> MascotState {
+    if roll < 0.40 {
+        MascotState::Blink
+    } else if roll < 0.65 {
+        MascotState::TailFlick
+    } else if roll < 0.80 {
+        MascotState::Look
+    } else if roll < 0.90 {
+        MascotState::Groom
+    } else {
+        MascotState::Stretch
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum WalkDirection {
+    Left,
+    Right,
+}
+
+/// Offsets are measured from the composer's right edge, so a growing offset
+/// moves the cat left.
+#[derive(Debug, Clone, Copy)]
+pub struct Walk {
+    pub from: f32,
+    pub to: f32,
+    pub started_at: Instant,
+}
+
+impl Walk {
+    pub fn duration(&self) -> Duration {
+        Duration::from_secs_f32(((self.to - self.from).abs() / WALK_SPEED_PX_PER_SEC).max(0.01))
+    }
+
+    pub fn end(&self) -> Instant {
+        self.started_at + self.duration()
+    }
+
+    pub fn direction(&self) -> WalkDirection {
+        if self.to > self.from {
+            WalkDirection::Left
+        } else {
+            WalkDirection::Right
+        }
+    }
+
+    pub fn position_at(&self, now: Instant) -> f32 {
+        let progress = (now.saturating_duration_since(self.started_at).as_secs_f32()
+            / self.duration().as_secs_f32())
+        .clamp(0., 1.);
+        self.from + (self.to - self.from) * progress
+    }
+}
+
+pub fn walk_target(roll: f32) -> f32 {
+    WALK_OFFSET_MIN + (WALK_OFFSET_MAX - WALK_OFFSET_MIN) * roll.clamp(0., 0.999)
+}
+
+/// Snapshot of everything that influences which mascot clip should render.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MascotInputs {
+    pub generating: bool,
+    pub typing: bool,
+    /// The active one-shot/held state, plus whether its deadline has passed.
+    pub transient: Option<(MascotState, bool)>,
+    pub asleep: bool,
+    pub walking: Option<WalkDirection>,
+}
+
+/// Spec §2.2 priority: petted > concerned > happy > thinking > listening >
+/// sleeping > idle. Transients (petted/concerned/happy/stretch) outrank all
+/// base states while unexpired; expired transients are ignored.
+pub fn resolve(inputs: MascotInputs) -> MascotState {
+    if let Some((state, expired)) = inputs.transient
+        && !expired
+    {
+        return state;
+    }
+    if inputs.generating {
+        MascotState::Thinking
+    } else if inputs.typing {
+        MascotState::Listening
+    } else if let Some(direction) = inputs.walking {
+        match direction {
+            WalkDirection::Left => MascotState::WalkLeft,
+            WalkDirection::Right => MascotState::WalkRight,
+        }
+    } else if inputs.asleep {
+        MascotState::Sleeping
+    } else {
+        MascotState::Idle
+    }
+}
+
+fn transient_priority(state: MascotState) -> u8 {
+    match state {
+        MascotState::Petted => 4,
+        MascotState::Concerned => 3,
+        MascotState::Happy => 2,
+        MascotState::Stretch => 1,
+        _ => 0,
+    }
+}
+
+/// Whether `incoming` may claim the single transient slot.
+fn should_replace_transient(current: Option<(MascotState, bool)>, incoming: MascotState) -> bool {
+    match current {
+        Some((state, expired)) => {
+            expired || transient_priority(incoming) >= transient_priority(state)
+        }
+        None => true,
+    }
+}
+
+pub struct MascotController {
+    thread: Entity<AcpThread>,
+    typing_until: Option<Instant>,
+    /// One-shot/held state. `None` deadline = hold until the next interaction
+    /// (only `Concerned` uses this).
+    transient: Option<(MascotState, Option<Instant>)>,
+    last_interaction: Instant,
+    previous_state: Option<MascotState>,
+    /// Last state handed out by `current_state`, used to detect changes and
+    /// populate `previous_state` for the cross-fade.
+    last_resolved: Option<MascotState>,
+    next_fidget_at: Option<Instant>,
+    next_walk_at: Option<Instant>,
+    walk: Option<Walk>,
+    walk_seq: usize,
+    /// Resting x-offset from the composer's right edge (px). 16 matches the
+    /// original hardcoded `right_4()`.
+    position_offset: f32,
+    hop_seq: usize,
+    hop_until: Option<Instant>,
+    _poll_task: Option<Task<()>>,
+    _thread_subscription: Subscription,
+}
+
+impl MascotController {
+    pub fn new(thread: Entity<AcpThread>, cx: &mut Context<Self>) -> Self {
+        let thread_subscription = cx.subscribe(&thread, |this, thread, event, cx| match event {
+            AcpThreadEvent::NewEntry => {
+                let new_entry_is_tool_call = thread
+                    .read(cx)
+                    .entries()
+                    .last()
+                    .is_some_and(|entry| matches!(entry, AgentThreadEntry::ToolCall(_)));
+                if new_entry_is_tool_call {
+                    this.notify_tool_call(cx);
+                }
+            }
+            AcpThreadEvent::ToolAuthorizationRequested(_) => {
+                this.notify_permission_requested(cx)
+            }
+            AcpThreadEvent::ToolAuthorizationReceived(_) => this.notify_permission_resolved(cx),
+            _ => {}
+        });
+        let mut this = Self {
+            thread,
+            typing_until: None,
+            transient: None,
+            last_interaction: executor_now(cx),
+            previous_state: None,
+            last_resolved: None,
+            next_fidget_at: None,
+            next_walk_at: None,
+            walk: None,
+            walk_seq: 0,
+            position_offset: WALK_OFFSET_MIN,
+            hop_seq: 0,
+            hop_until: None,
+            _poll_task: None,
+            _thread_subscription: thread_subscription,
+        };
+        this.schedule_wake(cx);
+        this.arm_schedules(cx);
+        this
+    }
+
+    fn is_generating(&self, cx: &App) -> bool {
+        self.thread.read(cx).status() != ThreadStatus::Idle
+    }
+
+    fn is_asleep(&self, cx: &App) -> bool {
+        executor_now(cx).saturating_duration_since(self.last_interaction) >= SLEEP_AFTER
+            && !self.is_generating(cx)
+    }
+
+    fn animations_full(cx: &App) -> bool {
+        AgentSettings::get_global(cx).animations == AnimationLevel::Full
+    }
+
+    fn schedule_fidget(&mut self, now: Instant, cx: &App) {
+        let (min, max) = if self.is_generating(cx) {
+            (GLANCE_MIN_DELAY, GLANCE_MAX_DELAY)
+        } else {
+            (FIDGET_MIN_DELAY, FIDGET_MAX_DELAY)
+        };
+        let jitter = (max - min).mul_f32(rand::random::<f32>());
+        self.next_fidget_at = Some(now + min + jitter);
+    }
+
+    fn settle_walk(&mut self, now: Instant) {
+        if let Some(walk) = &self.walk
+            && now >= walk.end()
+        {
+            self.position_offset = walk.to;
+            self.walk = None;
+        }
+    }
+
+    /// Stops a walk mid-stride, keeping the cat where it currently stands.
+    fn interrupt_walk(&mut self, now: Instant) {
+        if let Some(walk) = self.walk.take() {
+            self.position_offset = walk.position_at(now);
+        }
+    }
+
+    fn schedule_walk(&mut self, now: Instant) {
+        let jitter = (WALK_MAX_DELAY - WALK_MIN_DELAY).mul_f32(rand::random::<f32>());
+        self.next_walk_at = Some(now + WALK_MIN_DELAY + jitter);
+    }
+
+    fn start_walk(&mut self, now: Instant) {
+        let target = walk_target(rand::random::<f32>());
+        if (target - self.position_offset).abs() < MIN_WALK_DISTANCE {
+            return;
+        }
+        self.walk = Some(Walk {
+            from: self.position_offset,
+            to: target,
+            started_at: now,
+        });
+        self.walk_seq += 1;
+    }
+
+    fn arm_schedules(&mut self, cx: &mut Context<Self>) {
+        if !Self::animations_full(cx) {
+            self.next_fidget_at = None;
+            self.next_walk_at = None;
+            return;
+        }
+        let now = executor_now(cx);
+        if self.next_fidget_at.is_none() {
+            self.schedule_fidget(now, cx);
+        }
+        if self.next_walk_at.is_none() {
+            self.schedule_walk(now);
+        }
+        self.schedule_wake(cx);
+    }
+
+    /// True when the cat is visibly at rest: not generating, not mid-typing
+    /// attention, not asleep.
+    fn is_resting(&self, now: Instant, cx: &App) -> bool {
+        !self.is_generating(cx)
+            && !self.typing_until.is_some_and(|until| now < until)
+            && !self.is_asleep(cx)
+    }
+
+    fn tick(&mut self, cx: &mut Context<Self>) {
+        if !Self::animations_full(cx) {
+            self.next_fidget_at = None;
+            self.next_walk_at = None;
+            return;
+        }
+        let now = executor_now(cx);
+        if self.is_asleep(cx) {
+            // Park both schedulers so a sleeping cat costs zero timer wakeups;
+            // `wake` re-arms them (via `arm_schedules`) on the next interaction.
+            self.settle_walk(now);
+            self.next_fidget_at = None;
+            self.next_walk_at = None;
+            return;
+        }
+        if self.next_fidget_at.is_some_and(|at| now >= at) {
+            self.next_fidget_at = None;
+            if self.is_generating(cx) {
+                // glance up at the streaming text (spec §4.2)
+                let duration = MascotState::Look.clip_duration();
+                self.set_transient(MascotState::Look, Some(now + duration), cx);
+            } else if self.is_resting(now, cx) && self.walk.is_none() {
+                let fidget = pick_fidget(rand::random::<f32>());
+                self.set_transient(fidget, Some(now + fidget.clip_duration()), cx);
+            }
+            self.schedule_fidget(now, cx);
+        }
+        self.settle_walk(now);
+        if self.next_walk_at.is_some_and(|at| now >= at) {
+            self.next_walk_at = None;
+            if self.is_resting(now, cx) && self.transient.is_none() && self.walk.is_none() {
+                self.start_walk(now);
+            }
+            self.schedule_walk(now);
+        }
+    }
+
+    fn set_transient(
+        &mut self,
+        state: MascotState,
+        deadline: Option<Instant>,
+        cx: &mut Context<Self>,
+    ) {
+        let now = executor_now(cx);
+        let current = self
+            .transient
+            .map(|(state, deadline)| (state, deadline.is_some_and(|deadline| now >= deadline)));
+        if should_replace_transient(current, state) {
+            self.transient = Some((state, deadline));
+            self.schedule_wake(cx);
+            cx.notify();
+        }
+    }
+
+    /// Records user activity: resets the sleep timer, releases a held
+    /// `Concerned` pose, and plays `Stretch` when waking from sleep.
+    fn wake(&mut self, cx: &mut Context<Self>) {
+        self.interrupt_walk(executor_now(cx));
+        let was_asleep = self.is_asleep(cx);
+        self.last_interaction = executor_now(cx);
+        if let Some((MascotState::Concerned, None)) = self.transient {
+            self.transient = None;
+        }
+        if was_asleep {
+            let duration = MascotState::Stretch.clip_duration();
+            self.set_transient(MascotState::Stretch, Some(executor_now(cx) + duration), cx);
+        }
+        self.schedule_wake(cx);
+        cx.notify();
+        self.arm_schedules(cx);
+    }
+
+    pub fn notify_typing(&mut self, cx: &mut Context<Self>) {
+        self.typing_until = Some(executor_now(cx) + LISTENING_WINDOW);
+        self.wake(cx);
+    }
+
+    pub fn notify_generation_started(&mut self, cx: &mut Context<Self>) {
+        self.wake(cx);
+    }
+
+    pub fn notify_completed(&mut self, cx: &mut Context<Self>) {
+        let now = executor_now(cx);
+        self.last_interaction = now;
+        let duration = MascotState::Happy.clip_duration();
+        self.set_transient(MascotState::Happy, Some(now + duration), cx);
+        self.hop_seq += 1;
+        self.hop_until = Some(now + HOP_DURATION);
+    }
+
+    pub fn notify_error(&mut self, cx: &mut Context<Self>) {
+        self.last_interaction = executor_now(cx);
+        self.set_transient(MascotState::Concerned, None, cx);
+    }
+
+    /// Brief perk when the agent starts using a tool (spec §4.2). Reuses the
+    /// Listening clip; lowest transient priority so it never masks reactions.
+    pub fn notify_tool_call(&mut self, cx: &mut Context<Self>) {
+        let now = executor_now(cx);
+        self.set_transient(MascotState::Listening, Some(now + PERK_DURATION), cx);
+    }
+
+    /// Held attentive pose while a tool authorization is pending (spec §4.2).
+    pub fn notify_permission_requested(&mut self, cx: &mut Context<Self>) {
+        self.set_transient(MascotState::Concerned, None, cx);
+    }
+
+    pub fn notify_permission_resolved(&mut self, cx: &mut Context<Self>) {
+        if matches!(self.transient, Some((MascotState::Concerned, None))) {
+            self.transient = None;
+            cx.notify();
+        }
+    }
+
+    pub fn pet(&mut self, cx: &mut Context<Self>) {
+        self.interrupt_walk(executor_now(cx));
+        self.last_interaction = executor_now(cx);
+        let duration = MascotState::Petted.clip_duration();
+        self.set_transient(MascotState::Petted, Some(executor_now(cx) + duration), cx);
+        self.schedule_wake(cx);
+    }
+
+    pub fn current_state(&mut self, cx: &App) -> MascotState {
+        let now = executor_now(cx);
+        if let Some((_, Some(deadline))) = self.transient
+            && now >= deadline
+        {
+            self.transient = None;
+        }
+        self.settle_walk(now);
+        let inputs = MascotInputs {
+            generating: self.is_generating(cx),
+            typing: self.typing_until.is_some_and(|until| now < until),
+            transient: self
+                .transient
+                .map(|(state, deadline)| (state, deadline.is_some_and(|deadline| now >= deadline))),
+            asleep: self.is_asleep(cx),
+            walking: self.walk.as_ref().map(|walk| walk.direction()),
+        };
+        let state = resolve(inputs);
+        if self.last_resolved != Some(state) {
+            self.previous_state = self.last_resolved;
+            self.last_resolved = Some(state);
+        }
+        state
+    }
+
+    pub fn take_crossfade_from(&mut self) -> Option<MascotState> {
+        self.previous_state.take()
+    }
+
+    /// Sleeps until the next deadline that can change the resolved state
+    /// (typing window end, transient end, fidget/walk deadlines, or the sleep
+    /// threshold), then notifies and reschedules. Parks (no task) when no
+    /// deadline is pending — once `tick` clears the fidget/walk schedules at
+    /// the sleep threshold, a sleeping cat costs zero timer wakeups.
+    fn schedule_wake(&mut self, cx: &mut Context<Self>) {
+        let now = executor_now(cx);
+        let mut next_deadline: Option<Instant> = None;
+        let mut consider = |deadline: Instant| {
+            if deadline > now && next_deadline.is_none_or(|next| deadline < next) {
+                next_deadline = Some(deadline);
+            }
+        };
+        if let Some(until) = self.typing_until {
+            consider(until);
+        }
+        if let Some((_, Some(deadline))) = self.transient {
+            consider(deadline);
+        }
+        if let Some(at) = self.next_fidget_at {
+            consider(at);
+        }
+        if let Some(at) = self.next_walk_at {
+            consider(at);
+        }
+        if let Some(walk) = &self.walk {
+            consider(walk.end());
+        }
+        consider(self.last_interaction + SLEEP_AFTER);
+        let Some(next) = next_deadline else {
+            self._poll_task = None;
+            return;
+        };
+        let delay = next.saturating_duration_since(now) + Duration::from_millis(50);
+        self._poll_task = Some(cx.spawn(async move |this, cx| {
+            cx.background_executor().timer(delay).await;
+            this.update(cx, |this, cx| {
+                this.tick(cx);
+                cx.notify();
+                this.schedule_wake(cx);
+            })
+            .ok();
+        }));
+    }
+
+    pub fn companion_motion(&mut self, cx: &App) -> CompanionMotion {
+        let now = executor_now(cx);
+        self.settle_walk(now);
+        CompanionMotion {
+            offset: self
+                .walk
+                .as_ref()
+                .map_or(self.position_offset, |walk| walk.position_at(now)),
+            walk: self
+                .walk
+                .as_ref()
+                .map(|walk| (self.walk_seq, walk.from, walk.to, walk.duration())),
+            hop: self
+                .hop_until
+                .is_some_and(|until| now < until)
+                .then_some(self.hop_seq),
+        }
+    }
+}
+
+pub struct CompanionMotion {
+    /// Current x-offset from the composer's right edge, in px.
+    pub offset: f32,
+    /// (walk_seq, from, to, duration) while a walk is in flight.
+    pub walk: Option<(usize, f32, f32, Duration)>,
+    /// hop_seq while a completion hop is fresh.
+    pub hop: Option<usize>,
+}
