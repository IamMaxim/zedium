+    #[gpui::test]
+    async fn generation_start_interrupts_walk_and_snaps_position(cx: &mut TestAppContext) {
+        let controller = test_controller(cx).await;
+        let (from, to) = (16.0_f32, 100.0_f32);
+        controller.update(cx, |controller, cx| {
+            controller.position_offset = from;
+            controller.walk = Some(Walk {
+                from,
+                to,
+                started_at: executor_now(cx),
+            });
+        });
+        // 84px at 14px/s = 6s; stop partway through the stride.
+        cx.executor().advance_clock(Duration::from_secs(3));
+        cx.run_until_parked();
+        controller.update(cx, |controller, cx| {
+            controller.notify_generation_started(cx);
+            assert!(
+                controller.walk.is_none(),
+                "generation start must interrupt the walk"
