+/// qwen-code tags subagent activity with camelCase meta keys that are distinct
+/// from Zed's own snake_case keys (e.g. `tool_name`). These are qwen's keys.
+pub const QWEN_TOOL_NAME_META_KEY: &str = "toolName";
+pub const QWEN_PROVENANCE_META_KEY: &str = "provenance";
+pub const QWEN_SUBAGENT_TYPE_META_KEY: &str = "subagentType";
+pub const QWEN_PARENT_TOOL_CALL_ID_META_KEY: &str = "parentToolCallId";
+
+/// Where a subagent's members live relative to the thread that owns the root.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SubagentSubtree {
+    /// Members live in this same thread (e.g. qwen): entries linked by parent pointers.
+    SameThread,
+    /// Subtree lives in a separately-loaded child session (e.g. native agent).
+    ExternalSession(acp::SessionId),
+}
+
+/// A tool call that owns a subagent subtree.
+#[derive(Clone, Debug)]
+pub struct SubagentRoot {
+    pub tool_call_id: acp::ToolCallId,
+    /// May be empty if not yet known (qwen roots carry no type; it is resolved from children).
+    pub subagent_type: SharedString,
+    pub subtree: SubagentSubtree,
+}
+
+/// A same-thread tool call that belongs to some root's subtree.
+#[derive(Clone, Debug)]
+pub struct SubagentMembership {
+    pub parent: acp::ToolCallId,
+    pub subagent_type: SharedString,
+}
+
+/// Result of classifying one tool call (by id + raw ACP meta) for subagent grouping.
+pub enum SubagentClassification {
+    Root {
+        subagent_type: Option<SharedString>,
+        subtree: SubagentSubtree,
+    },
+    Member {
+        parent: acp::ToolCallId,
+        subagent_type: SharedString,
+    },
+    NotSubagent,
+}
+
+/// Per-provider adapter that reconstructs a normalized subagent grouping from a
+/// provider's own raw tool call meta.
+pub trait SubagentGrouping {
+    fn classify(
+        &self,
+        tool_call_id: &acp::ToolCallId,
+        meta: Option<&acp::Meta>,
+    ) -> SubagentClassification;
+}
+
+/// Reads qwen-code's parent-pointer subagent shape from raw tool call meta.
+pub struct QwenSubagentGrouping;
+
+impl SubagentGrouping for QwenSubagentGrouping {
+    fn classify(
+        &self,
+        _tool_call_id: &acp::ToolCallId,
+        meta: Option<&acp::Meta>,
+    ) -> SubagentClassification {
+        let Some(meta) = meta else {
+            return SubagentClassification::NotSubagent;
+        };
+        let tool_name = meta
+            .get(QWEN_TOOL_NAME_META_KEY)
+            .and_then(|value| value.as_str());
+        let provenance = meta
+            .get(QWEN_PROVENANCE_META_KEY)
+            .and_then(|value| value.as_str());
+
+        if tool_name == Some("agent") {
+            return SubagentClassification::Root {
+                subagent_type: None,
+                subtree: SubagentSubtree::SameThread,
+            };
+        }
+
+        if provenance == Some("subagent") {
+            if let Some(parent) = meta
+                .get(QWEN_PARENT_TOOL_CALL_ID_META_KEY)
+                .and_then(|value| value.as_str())
+            {
+                let subagent_type = meta
+                    .get(QWEN_SUBAGENT_TYPE_META_KEY)
+                    .and_then(|value| value.as_str())
+                    .unwrap_or_default();
+                return SubagentClassification::Member {
+                    parent: acp::ToolCallId::new(parent),
+                    subagent_type: SharedString::from(subagent_type.to_owned()),
+                };
+            }
+        }
+
+        SubagentClassification::NotSubagent
+    }
+}
+
+/// Reads the native agent's separate-session subagent shape from raw tool call meta.
+pub struct NativeSubagentGrouping;
+
+impl SubagentGrouping for NativeSubagentGrouping {
+    fn classify(
+        &self,
+        _tool_call_id: &acp::ToolCallId,
+        meta: Option<&acp::Meta>,
+    ) -> SubagentClassification {
+        // `subagent_session_info_from_meta` takes an owned `Option<acp::Meta>`.
+        match subagent_session_info_from_meta(&meta.cloned()) {
+            Some(info) => SubagentClassification::Root {
+                subagent_type: None,
+                subtree: SubagentSubtree::ExternalSession(info.session_id),
+            },
+            // The native agent's child steps live in the child session, so it
+            // never yields a same-thread member in this thread.
+            None => SubagentClassification::NotSubagent,
+        }
+    }
+}
+
+/// Side-index on `AcpThread` that holds the normalized subagent grouping, keyed
+/// by `acp::ToolCallId`. Membership is resolved lazily by walking parent
+/// pointers, so out-of-order arrival of roots and members is tolerated.
+#[derive(Default)]
+pub struct SubagentIndex {
+    roots: collections::IndexMap<acp::ToolCallId, SubagentRoot>,
+    membership: HashMap<acp::ToolCallId, SubagentMembership>,
+}
+
+impl SubagentIndex {
+    /// Cap on parent-pointer walks, guarding against infinite loops on malformed
+    /// (cyclic) input.
+    const MAX_WALK_DEPTH: usize = 64;
+
+    pub fn apply(&mut self, id: &acp::ToolCallId, classification: SubagentClassification) {
+        match classification {
+            SubagentClassification::Root {
+                subagent_type,
+                subtree,
+            } => {
+                let subagent_type = subagent_type.unwrap_or_default();
+                match self.roots.get_mut(id) {
+                    Some(existing) => {
+                        existing.subtree = subtree;
+                        // Don't overwrite a known type with an empty one.
+                        if !subagent_type.is_empty() {
+                            existing.subagent_type = subagent_type;
+                        }
+                    }
+                    None => {
+                        self.roots.insert(
+                            id.clone(),
+                            SubagentRoot {
+                                tool_call_id: id.clone(),
+                                subagent_type,
+                                subtree,
+                            },
+                        );
+                    }
+                }
+            }
+            SubagentClassification::Member {
+                parent,
+                subagent_type,
+            } => {
+                self.membership.insert(
+                    id.clone(),
+                    SubagentMembership {
+                        parent,
+                        subagent_type,
+                    },
+                );
+            }
+            SubagentClassification::NotSubagent => {}
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.roots.is_empty() && self.membership.is_empty()
+    }
+
+    pub fn is_root(&self, id: &acp::ToolCallId) -> bool {
+        self.roots.contains_key(id)
+    }
+
+    pub fn is_member(&self, id: &acp::ToolCallId) -> bool {
+        self.membership.contains_key(id)
+    }
+
+    pub fn membership_of(&self, id: &acp::ToolCallId) -> Option<&SubagentMembership> {
+        self.membership.get(id)
+    }
+
+    /// Walks `membership[id].parent` upward until reaching a registered root.
+    /// Returns `None` if a parent link is missing before a root is reached or the
+    /// walk exceeds [`Self::MAX_WALK_DEPTH`] (cycle guard).
+    pub fn root_of(&self, id: &acp::ToolCallId) -> Option<acp::ToolCallId> {
+        let mut current = id.clone();
+        for _ in 0..Self::MAX_WALK_DEPTH {
+            if self.roots.contains_key(&current) {
+                return Some(current);
+            }
+            let membership = self.membership.get(&current)?;
+            current = membership.parent.clone();
+        }
+        None
+    }
+
+    /// Number of parent hops from `id` up to its root. A direct child of a root
+    /// has depth 1; a root itself has depth 0. Returns 0 if no root is reachable
+    /// within [`Self::MAX_WALK_DEPTH`].
+    pub fn depth_of(&self, id: &acp::ToolCallId) -> usize {
+        if self.roots.contains_key(id) {
+            return 0;
+        }
+        let mut current = id.clone();
+        for hops in 0..Self::MAX_WALK_DEPTH {
+            let Some(membership) = self.membership.get(&current) else {
+                return 0;
+            };
+            if self.roots.contains_key(&membership.parent) {
+                return hops + 1;
+            }
+            current = membership.parent.clone();
+        }
+        0
+    }
+
+    /// For a root id: its own `subagent_type` if non-empty, else the type of any
+    /// member resolving to this root, else `None`.
+    pub fn root_label(&self, id: &acp::ToolCallId) -> Option<SharedString> {
+        let root = self.roots.get(id)?;
+        if !root.subagent_type.is_empty() {
+            return Some(root.subagent_type.clone());
+        }
+        self.membership.iter().find_map(|(member_id, membership)| {
+            if membership.subagent_type.is_empty() {
+                return None;
+            }
+            if self.root_of(member_id).as_ref() == Some(id) {
+                Some(membership.subagent_type.clone())
+            } else {
+                None
+            }
+        })
+    }
+
+    pub fn roots(&self) -> impl Iterator<Item = &SubagentRoot> {
+        self.roots.values()
+    }
+
+    pub fn members_of(&self, root: &acp::ToolCallId) -> Vec<acp::ToolCallId> {
+        self.membership
+            .keys()
+            .filter(|member_id| self.root_of(member_id).as_ref() == Some(root))
+            .cloned()
+            .collect()
+    }
+}
+
