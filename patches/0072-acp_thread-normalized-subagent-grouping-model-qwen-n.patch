+
+        let root_id = acp::ToolCallId::new("call_4ca2caa145844a0e9d467403");
+        let roots: Vec<_> = index.roots().collect();
+        assert_eq!(roots.len(), 1);
+        assert!(index.is_root(&root_id));
+
+        // The committed live-capture fixture carries four distinct subagent
+        // members (one `glob` plus three `read_file`), all direct children of
+        // the single `agent` root.
+        let members = index.members_of(&root_id);
+        assert_eq!(members.len(), 4);
+        for member in &members {
+            assert_eq!(index.root_of(member).as_ref(), Some(&root_id));
+            assert_eq!(index.depth_of(member), 1);
+        }
