+    #[test]
+    fn subagent_index_handles_nested_depth() {
+        let mut index = SubagentIndex::default();
+        let root = acp::ToolCallId::new("R");
+        let middle = acp::ToolCallId::new("A");
+        let leaf = acp::ToolCallId::new("B");
+
+        index.apply(
+            &root,
+            SubagentClassification::Root {
+                subagent_type: Some(SharedString::from("Explore")),
+                subtree: SubagentSubtree::SameThread,
+            },
+        );
+        index.apply(
+            &middle,
+            SubagentClassification::Member {
+                parent: root.clone(),
+                subagent_type: SharedString::from("Explore"),
+            },
+        );
+        index.apply(
+            &leaf,
+            SubagentClassification::Member {
+                parent: middle.clone(),
+                subagent_type: SharedString::from("Explore"),
+            },
+        );
+
+        assert_eq!(index.depth_of(&leaf), 2);
+        assert_eq!(index.root_of(&leaf).as_ref(), Some(&root));
+
+        // A self-cycle must terminate (cycle guard) and report no root.
+        let mut cyclic = SubagentIndex::default();
+        let node = acp::ToolCallId::new("self");
+        cyclic.apply(
+            &node,
+            SubagentClassification::Member {
+                parent: node.clone(),
+                subagent_type: SharedString::default(),
+            },
+        );
+        assert_eq!(cyclic.root_of(&node), None);
+        assert_eq!(cyclic.depth_of(&node), 0);
+
+        // A member whose parent never resolves to a root has no root.
+        let mut orphan = SubagentIndex::default();
+        let child = acp::ToolCallId::new("child");
+        orphan.apply(
+            &child,
+            SubagentClassification::Member {
+                parent: acp::ToolCallId::new("missing"),
+                subagent_type: SharedString::default(),
+            },
+        );
+        assert_eq!(orphan.root_of(&child), None);
+    }
+
+    #[test]
+    fn subagent_index_resolves_out_of_order() {
+        let mut index = SubagentIndex::default();
+        let root = acp::ToolCallId::new("R");
+        let member = acp::ToolCallId::new("child");
+
+        // Member arrives before its root.
+        index.apply(
+            &member,
+            SubagentClassification::Member {
+                parent: root.clone(),
+                subagent_type: SharedString::from("Explore"),
+            },
+        );
+        assert_eq!(index.root_of(&member), None);
+
+        index.apply(
+            &root,
+            SubagentClassification::Root {
+                subagent_type: None,
+                subtree: SubagentSubtree::SameThread,
+            },
+        );
+        assert_eq!(index.root_of(&member).as_ref(), Some(&root));
+        assert_eq!(index.root_label(&root), Some(SharedString::from("Explore")));
+    }
