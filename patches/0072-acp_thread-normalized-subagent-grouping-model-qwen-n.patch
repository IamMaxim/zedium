+    #[test]
+    fn qwen_grouping_classifies_root_and_members() {
+        let root_meta = acp::Meta::from_iter([
+            (QWEN_TOOL_NAME_META_KEY.into(), json!("agent")),
+            (QWEN_PROVENANCE_META_KEY.into(), json!("builtin")),
+        ]);
+        let root = QwenSubagentGrouping.classify(&acp::ToolCallId::new("root"), Some(&root_meta));
+        match root {
+            SubagentClassification::Root {
+                subagent_type,
+                subtree,
+            } => {
+                assert_eq!(subagent_type, None);
+                assert_eq!(subtree, SubagentSubtree::SameThread);
+            }
+            _ => panic!("expected qwen agent tool call to classify as a root"),
+        }
+
+        let member_meta = acp::Meta::from_iter([
+            (QWEN_TOOL_NAME_META_KEY.into(), json!("read_file")),
+            (QWEN_PROVENANCE_META_KEY.into(), json!("subagent")),
+            (QWEN_SUBAGENT_TYPE_META_KEY.into(), json!("Explore")),
+            (QWEN_PARENT_TOOL_CALL_ID_META_KEY.into(), json!("root")),
+        ]);
+        let member =
+            QwenSubagentGrouping.classify(&acp::ToolCallId::new("child"), Some(&member_meta));
+        match member {
+            SubagentClassification::Member {
+                parent,
+                subagent_type,
+            } => {
+                assert_eq!(parent, acp::ToolCallId::new("root"));
+                assert_eq!(subagent_type, SharedString::from("Explore"));
+            }
+            _ => panic!("expected qwen subagent tool call to classify as a member"),
+        }
+
+        assert!(matches!(
+            QwenSubagentGrouping.classify(&acp::ToolCallId::new("plain"), None),
+            SubagentClassification::NotSubagent
+        ));
+    }
+
