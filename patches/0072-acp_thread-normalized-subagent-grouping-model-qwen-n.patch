+        let fs = FakeFs::new(cx.executor());
+        let project = Project::test(fs, [], cx).await;
+        let plain_connection = Rc::new(FakeAgentConnection::new());
+        let plain_thread = cx
+            .update(|cx| {
+                plain_connection.new_session(
+                    project.clone(),
+                    PathList::new(&[Path::new(path!("/test"))]),
+                    cx,
+                )
+            })
+            .await
+            .unwrap();
+        plain_thread.update(cx, |thread, cx| {
+            for update in &updates {
+                thread
+                    .handle_session_update(update.clone(), cx)
+                    .expect("session update applies");
+            }
+            assert!(thread.subagent_index().is_empty());
