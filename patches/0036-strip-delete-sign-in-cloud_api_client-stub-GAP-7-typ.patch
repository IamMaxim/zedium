diff --git a/crates/cloud_api_client/src/cloud_api_client.rs b/crates/cloud_api_client/src/cloud_api_client.rs
index eabaccb938..767aec9700 100644
--- a/crates/cloud_api_client/src/cloud_api_client.rs
+++ b/crates/cloud_api_client/src/cloud_api_client.rs
@@ -1,3 +1,25 @@
+//! Zedium residual surface (GAP-7 closed).
+//!
+//! Sign-in and all Zed-cloud network transport were removed (patches 0014/0015
+//! gutted the websocket/REST client; the `sign_in_with_optional_connect` entry
+//! point and the boot `authenticate()` path were deleted in patch 0037). No
+//! method in this crate contacts a remote service.
+//!
+//! The crate is retained ONLY as a shared TYPE crate for kept consumers. Each
+//! remaining exported symbol and the consumer that keeps it alive:
+//!   - `CloudApiClient`  — `client/src/client.rs`: a no-op handle whose methods
+//!                         return `CloudDisabled`/`NotSignedIn`; no transport.
+//!   - `ClientApiError`  — `client/src/client.rs`: error enum.
+//!   - `LlmApiToken`     — `client/src/{client,llm_token}.rs`, `language_models`:
+//!                         BYO-key LLM token cache (no Zed account).
+//!   - re-exported `cloud_api_types::*` (incl. `websocket_protocol::MessageToClient`,
+//!                         `Plan`, `Organization*`, `GetAuthenticatedUserResponse`)
+//!                       — `client/src/user.rs`: local account/plan + message
+//!                         types; the websocket is gone, only the enums remain.
+//!
+//! If any consumer above is later stripped, delete the matching export here
+//! rather than leaving it dormant.
+
 mod llm_token;
 
 use std::sync::Arc;
