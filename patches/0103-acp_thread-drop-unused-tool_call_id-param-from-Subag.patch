From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 01:05:43 +0300
Subject: [PATCH] acp_thread: drop unused tool_call_id param from
 SubagentGrouping::classify

classify() never reads the id in either adapter; dropping it lets
non-tool-call entries (text/thought chunks, Task 2) be classified
through the same trait without inventing a placeholder id.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015pwsNfhcLdUaT7p6VBfYnJ
---
 crates/acp_thread/src/acp_thread.rs | 32 +++++++++--------------------
 1 file changed, 10 insertions(+), 22 deletions(-)

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index f3e20940d8..74c54a3aab 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -253,22 +253,14 @@ pub enum SubagentClassification {
 /// Per-provider adapter that reconstructs a normalized subagent grouping from a
 /// provider's own raw tool call meta.
 pub trait SubagentGrouping {
-    fn classify(
-        &self,
-        tool_call_id: &acp::ToolCallId,
-        meta: Option<&acp::Meta>,
-    ) -> SubagentClassification;
+    fn classify(&self, meta: Option<&acp::Meta>) -> SubagentClassification;
 }
 
 /// Reads qwen-code's parent-pointer subagent shape from raw tool call meta.
 pub struct QwenSubagentGrouping;
 
 impl SubagentGrouping for QwenSubagentGrouping {
-    fn classify(
-        &self,
-        _tool_call_id: &acp::ToolCallId,
-        meta: Option<&acp::Meta>,
-    ) -> SubagentClassification {
+    fn classify(&self, meta: Option<&acp::Meta>) -> SubagentClassification {
         let Some(meta) = meta else {
             return SubagentClassification::NotSubagent;
         };
@@ -310,11 +302,7 @@ impl SubagentGrouping for QwenSubagentGrouping {
 pub struct NativeSubagentGrouping;
 
 impl SubagentGrouping for NativeSubagentGrouping {
-    fn classify(
-        &self,
-        _tool_call_id: &acp::ToolCallId,
-        meta: Option<&acp::Meta>,
-    ) -> SubagentClassification {
+    fn classify(&self, meta: Option<&acp::Meta>) -> SubagentClassification {
         // `subagent_session_info_from_meta` takes an owned `Option<acp::Meta>`.
         match subagent_session_info_from_meta(&meta.cloned()) {
             Some(info) => SubagentClassification::Root {
@@ -2568,7 +2556,7 @@ impl AcpThread {
 
     fn classify_subagent(&mut self, id: &acp::ToolCallId, meta: Option<&acp::Meta>) {
         if let Some(grouping) = self.connection.subagent_grouping() {
-            let classification = grouping.classify(id, meta);
+            let classification = grouping.classify(meta);
             self.subagent_index.apply(id, classification);
         }
     }
@@ -3917,7 +3905,7 @@ mod tests {
             (QWEN_TOOL_NAME_META_KEY.into(), json!("agent")),
             (QWEN_PROVENANCE_META_KEY.into(), json!("builtin")),
         ]);
-        let root = QwenSubagentGrouping.classify(&acp::ToolCallId::new("root"), Some(&root_meta));
+        let root = QwenSubagentGrouping.classify(Some(&root_meta));
         match root {
             SubagentClassification::Root {
                 subagent_type,
@@ -3936,7 +3924,7 @@ mod tests {
             (QWEN_PARENT_TOOL_CALL_ID_META_KEY.into(), json!("root")),
         ]);
         let member =
-            QwenSubagentGrouping.classify(&acp::ToolCallId::new("child"), Some(&member_meta));
+            QwenSubagentGrouping.classify(Some(&member_meta));
         match member {
             SubagentClassification::Member {
                 parent,
@@ -3949,7 +3937,7 @@ mod tests {
         }
 
         assert!(matches!(
-            QwenSubagentGrouping.classify(&acp::ToolCallId::new("plain"), None),
+            QwenSubagentGrouping.classify(None),
             SubagentClassification::NotSubagent
         ));
     }
@@ -3968,7 +3956,7 @@ mod tests {
         )]);
 
         let classification =
-            NativeSubagentGrouping.classify(&acp::ToolCallId::new("spawn"), Some(&meta));
+            NativeSubagentGrouping.classify(Some(&meta));
         match classification {
             SubagentClassification::Root {
                 subagent_type,
@@ -3981,7 +3969,7 @@ mod tests {
         }
 
         assert!(matches!(
-            NativeSubagentGrouping.classify(&acp::ToolCallId::new("plain"), None),
+            NativeSubagentGrouping.classify(None),
             SubagentClassification::NotSubagent
         ));
     }
@@ -4007,7 +3995,7 @@ mod tests {
     fn subagent_index_builds_tree_from_qwen_fixture() {
         let mut index = SubagentIndex::default();
         for (id, meta) in qwen_fixture_entries() {
-            let classification = QwenSubagentGrouping.classify(&id, meta.as_ref());
+            let classification = QwenSubagentGrouping.classify(meta.as_ref());
             index.apply(&id, classification);
         }
 
