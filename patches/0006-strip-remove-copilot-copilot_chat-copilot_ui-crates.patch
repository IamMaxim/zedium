-        match event {
-            copilot_responses::StreamEvent::OutputItemAdded { item, .. } => match item {
-                copilot_responses::ResponseOutputItem::Message { id, .. } => {
-                    vec![Ok(LanguageModelCompletionEvent::StartMessage {
-                        message_id: id,
-                    })]
-                }
