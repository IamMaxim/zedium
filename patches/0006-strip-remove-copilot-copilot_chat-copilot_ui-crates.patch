-        match details {
-            Ok(details) => vec![Ok(LanguageModelCompletionEvent::ReasoningDetails(details))],
-            Err(error) => vec![Err(LanguageModelCompletionError::Other(anyhow!(error)))],
-        }
-    }
-}
