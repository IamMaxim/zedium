-    let max_budget = max_budget.unwrap_or(max_output_tokens.saturating_sub(1));
-    let normalized = configured_budget.max(min_budget);
-    Some(
-        normalized
-            .min(max_budget)
-            .min(max_output_tokens.saturating_sub(1)),
-    )
-}
