From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Sat, 27 Jun 2026 23:13:42 +0300
Subject: [PATCH] fix(db): enforce Require TLS, keychain-after-save, hide
 empty-node arrows, per-table tab titles, and review nits

---
 crates/database_client/Cargo.toml             |  1 +
 .../database_client/src/connection/profile.rs | 17 ++++++++++++-
 .../database_client/src/connection_modal.rs   | 20 +++++++++-------
 crates/database_client/src/panel.rs           |  2 ++
 crates/database_client/src/query_view.rs      | 23 +++++++++++++-----
 crates/database_client/src/tree.rs            | 24 ++++++++++++++++---
 6 files changed, 69 insertions(+), 18 deletions(-)

diff --git a/crates/database_client/Cargo.toml b/crates/database_client/Cargo.toml
index a3e04cc3f5..9303062449 100644
--- a/crates/database_client/Cargo.toml
+++ b/crates/database_client/Cargo.toml
@@ -41,6 +41,7 @@ workspace.workspace = true
 zed_actions.workspace = true
 
 [dev-dependencies]
+db = { workspace = true, features = ["test-support"] }
 gpui = { workspace = true, features = ["test-support"] }
 tempfile.workspace = true
 
diff --git a/crates/database_client/src/connection/profile.rs b/crates/database_client/src/connection/profile.rs
index 77a18fa2e4..e0998639e2 100644
--- a/crates/database_client/src/connection/profile.rs
+++ b/crates/database_client/src/connection/profile.rs
@@ -68,11 +68,17 @@ impl ConnectionProfile {
     /// the caller based on `ssl_mode`; this only fills the connection fields.
     pub fn pg_config(&self, password: Option<&str>) -> tokio_postgres::Config {
         let mut cfg = tokio_postgres::Config::new();
+        let pg_ssl = match self.ssl_mode {
+            SslMode::Disable => tokio_postgres::config::SslMode::Disable,
+            SslMode::Prefer => tokio_postgres::config::SslMode::Prefer,
+            SslMode::Require => tokio_postgres::config::SslMode::Require,
+        };
         cfg.host(&self.host)
             .port(self.port)
             .dbname(&self.database)
             .user(&self.user)
-            .application_name("Zedium");
+            .application_name("Zedium")
+            .ssl_mode(pg_ssl);
         if let Some(pw) = password {
             cfg.password(pw);
         }
@@ -124,4 +130,13 @@ mod tests {
         assert_eq!(cfg.get_dbname(), Some("mydb"));
         assert_eq!(cfg.get_user(), Some("alice"));
     }
+
+    #[test]
+    fn pg_config_sets_ssl_mode() {
+        let mut p = sample();
+        p.ssl_mode = SslMode::Require;
+        assert_eq!(p.pg_config(None).get_ssl_mode(), tokio_postgres::config::SslMode::Require);
+        p.ssl_mode = SslMode::Disable;
+        assert_eq!(p.pg_config(None).get_ssl_mode(), tokio_postgres::config::SslMode::Disable);
+    }
 }
diff --git a/crates/database_client/src/connection_modal.rs b/crates/database_client/src/connection_modal.rs
index 62d4ea9acc..ad2499c52c 100644
--- a/crates/database_client/src/connection_modal.rs
+++ b/crates/database_client/src/connection_modal.rs
@@ -159,11 +159,15 @@ impl ConnectionModal {
             };
             let mut profiles = store::load_profiles();
             store::replace_profile_by_id(&mut profiles, profile.clone());
-            if let Err(e) = store::save_profiles(&profiles) {
-                log::error!("failed to save connection profiles: {e}");
-            }
-            if !password.is_empty() {
-                store::store_password(cx, &profile, &password).detach_and_log_err(cx);
+            match store::save_profiles(&profiles) {
+                Ok(()) => {
+                    if !password.is_empty() {
+                        store::store_password(cx, &profile, &password).detach_and_log_err(cx);
+                    }
+                }
+                Err(e) => {
+                    log::error!("failed to save connection profiles: {e}");
+                }
             }
         } else {
             // Add mode: append a new profile.
@@ -184,10 +188,10 @@ impl ConnectionModal {
 
             let mut profiles = store::load_profiles();
             profiles.push(profile.clone());
-            if let Err(e) = store::save_profiles(&profiles) {
-                log::error!("failed to save connection profiles: {e}");
+            match store::save_profiles(&profiles) {
+                Ok(()) => { store::store_password(cx, &profile, &password).detach_and_log_err(cx); }
+                Err(e) => { log::error!("failed to save connection profile: {e}"); }
             }
-            store::store_password(cx, &profile, &password).detach_and_log_err(cx);
         }
 
         self.panel.update(cx, |panel, cx| {
diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
