+                .unwrap()
+                .to_string()
+                .contains("ui_line_height.custom must be at least 1.0")
+        );
+        assert!(
+            serde_json::from_value::<UiLineHeight>(json!({"custom": 0.0}))
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("ui_line_height.custom must be at least 1.0")
+        );
+        assert!(
+            serde_json::from_value::<UiLineHeight>(json!({"custom": -1.0}))
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("ui_line_height.custom must be at least 1.0")
+        );
+    }
