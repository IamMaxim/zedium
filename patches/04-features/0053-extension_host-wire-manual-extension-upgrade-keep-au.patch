-        anyhow::Ok(())
+    pub fn check_for_updates(&mut self, _cx: &mut Context<Self>) {
+        // Zedium does not auto-update extensions: the local registry is operator-managed
+        // and upgrades are an explicit, manual action (the Extensions view "Upgrade"
+        // button calls `upgrade_extension` directly). This deliberately does nothing so
+        // the startup call cannot silently bump installed extensions.
     }
 
     fn fetch_extensions_from_api(
@@ -874,11 +799,12 @@ impl ExtensionStore {
     pub fn upgrade_extension(
         &mut self,
         extension_id: Arc<str>,
-        _version: Arc<str>,
-        _cx: &mut Context<Self>,
+        version: Arc<str>,
+        cx: &mut Context<Self>,
     ) -> Task<Result<()>> {
-        log::warn!("remote extension upgrades are disabled in Zedium; ignoring {extension_id}");
-        Task::ready(Ok(()))
+        // Upgrades reuse the install path: install_prebuilt_extension uninstalls the
+        // existing copy before installing the requested version from the local registry.
+        self.install_or_upgrade_extension(extension_id, version, ExtensionOperation::Upgrade, cx)
     }
 
     fn install_or_upgrade_extension(
diff --git a/crates/extension_host/src/extension_store_test.rs b/crates/extension_host/src/extension_store_test.rs
index 5e5629c1fe..be94021d6e 100644
--- a/crates/extension_host/src/extension_store_test.rs
+++ b/crates/extension_host/src/extension_store_test.rs
@@ -1683,6 +1683,176 @@ async fn test_installed_extensions_metadata(cx: &mut TestAppContext) {
     });
 }
 
+#[gpui::test]
+async fn test_upgrade_extension_from_local_registry(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.executor().allow_parking();
+
+    let theme_family_json = r#"{
+        "name": "Airgap",
+        "author": "Someone",
+        "themes": [
+            { "name": "Airgap Dark", "appearance": "dark", "style": {} }
+        ]
+    }"#;
+    let extension_id = "airgap-theme";
+
+    let fs = Arc::new(RealFs::new(None, cx.executor()));
+    let extensions_tree = TempTree::new(json!({
+        "installed": {}, "work": {}, "staging": {},
+    }));
+    let extensions_dir = extensions_tree.path().canonicalize().unwrap();
+
+    let proxy = Arc::new(ExtensionHostProxy::new());
+    let theme_registry = Arc::new(ThemeRegistry::new(Box::new(())));
+    theme_extension::init(proxy.clone(), theme_registry.clone(), cx.executor());
+    let language_registry = Arc::new(LanguageRegistry::test(cx.executor()));
+    language_extension::init(LspAccess::Noop, proxy.clone(), language_registry.clone());
+    let node_runtime = NodeRuntime::unavailable();
+    let http_client = FakeHttpClient::with_404_response();
+
+    let extension_store = cx.new(|cx| {
+        ExtensionStore::new(
+            extensions_dir.clone(),
+            None,
+            proxy,
+            fs.clone(),
+            http_client.clone(),
+            http_client.clone(),
+            node_runtime,
+            cx,
+        )
+    });
+
+    let mut events = cx.events(&extension_store);
+    let executor = cx.executor();
+    let _task = cx.executor().spawn(async move {
+        while let Some(event) = events.next().await {
+            if let Event::StartedReloading = event {
+                executor.advance_clock(RELOAD_DEBOUNCE_DURATION);
+            }
+        }
+    });
+
+    // Install version 1.0.0 directly from a fixture (no registry needed yet).
+    let fixture_tree_v1 = TempTree::new(json!({
+        "extension.toml": format!(
+            "id = \"{extension_id}\"\nname = \"Airgap Theme\"\nversion = \"1.0.0\"\nschema_version = 1\nthemes = [\"themes/airgap.json\"]\n"
+        ),
+        "themes": { "airgap.json": theme_family_json },
+    }));
+    let fixture_dir_v1 = fixture_tree_v1.path().canonicalize().unwrap();
+    extension_store
+        .update(cx, |store, cx| {
+            store.install_prebuilt_extension(fixture_dir_v1.clone(), cx)
+        })
+        .await
+        .unwrap();
+    cx.executor().run_until_parked();
+
+    extension_store.read_with(cx, |store, _| {
+        assert_eq!(
+            store
+                .extension_index
+                .extensions
+                .get(extension_id)
+                .expect("v1.0.0 should be installed")
+                .manifest
+                .version
+                .as_ref(),
+            "1.0.0"
+        );
+    });
+
+    // Build a directory registry that offers version 1.0.1.
+    let upgraded_version = "1.0.1";
+    let fixture_tree_v2 = TempTree::new(json!({
+        "extension.toml": format!(
+            "id = \"{extension_id}\"\nname = \"Airgap Theme\"\nversion = \"{upgraded_version}\"\nschema_version = 1\nthemes = [\"themes/airgap.json\"]\n"
+        ),
+        "themes": { "airgap.json": theme_family_json },
+    }));
+    let fixture_dir_v2 = fixture_tree_v2.path().canonicalize().unwrap();
+
+    let mut archive_bytes = Vec::<u8>::new();
+    {
+        let mut tar_bytes = Vec::<u8>::new();
+        {
+            let mut archive = async_tar::Builder::new(&mut tar_bytes);
+            archive.append_dir_all(".", &fixture_dir_v2).await.unwrap();
+            archive.into_inner().await.unwrap();
+        }
+        let mut encoder = GzipEncoder::new(BufReader::new(tar_bytes.as_slice()));
+        encoder.read_to_end(&mut archive_bytes).await.unwrap();
+    }
+
+    let index_json = format!(
+        r#"{{"data":[{{"id":"{extension_id}","name":"Airgap Theme","version":"{upgraded_version}","description":null,"authors":["Someone"],"repository":"https://example.invalid/airgap","schema_version":1,"wasm_api_version":null,"provides":["themes"],"published_at":"2024-01-02T00:00:00Z","download_count":0}}]}}"#
+    );
+
+    let registry_tree = TempTree::new(json!({
+        "index.json": index_json,
+        "extensions": { "airgap-theme": { "1.0.1": {} } },
+    }));
+    let registry_dir = registry_tree.path().canonicalize().unwrap();
+    std::fs::write(
+        registry_dir
+            .join("extensions")
+            .join(extension_id)
+            .join(upgraded_version)
+            .join("archive.tar.gz"),
+        &archive_bytes,
+    )
+    .unwrap();
+
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store.update_user_settings(cx, |content| {
+                content.extension.local_registry =
+                    Some(registry_dir.to_string_lossy().into_owned());
+            });
+        });
+    });
+
+    extension_store.update(cx, |store, cx| {
+        store
+            .upgrade_extension(Arc::from(extension_id), Arc::from(upgraded_version), cx)
+            .detach();
+    });
+
+    // The upgrade task is async + real-fs, so settle in a bounded loop until the
+    // index reports the new version.
+    for _ in 0..200 {
+        cx.executor().run_until_parked();
+        let upgraded = extension_store.read_with(cx, |store, _| {
+            store
+                .extension_index
+                .extensions
+                .get(extension_id)
+                .map_or(false, |entry| entry.manifest.version.as_ref() == upgraded_version)
+        });
+        if upgraded {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+        cx.executor().advance_clock(RELOAD_DEBOUNCE_DURATION);
+    }
+
+    extension_store.read_with(cx, |store, _| {
+        let entry = store
+            .extension_index
+            .extensions
+            .get(extension_id)
+            .expect("extension should remain installed after upgrade");
+        assert_eq!(
+            entry.manifest.version.as_ref(),
+            upgraded_version,
+            "manual upgrade should bump the installed version via the local registry"
+        );
+        assert!(!entry.dev, "registry upgrade must be a non-dev install");
+    });
+}
+
 fn init_test(cx: &mut TestAppContext) {
     cx.update(|cx| {
         let store = SettingsStore::test(cx);
