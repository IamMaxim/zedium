+#[gpui::test]
+async fn test_install_prebuilt_extension(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.executor().allow_parking();
+
+    let theme_family_json = r#"{
+        "name": "Airgap",
+        "author": "Someone",
+        "themes": [
+            {
+                "name": "Airgap Dark",
+                "appearance": "dark",
+                "style": {}
+            }
+        ]
+    }"#;
+
+    // A theme-only extension carries no Cargo.toml and no extension.wasm, so it
+    // exercises the no-compile install path.
+    let extension_id = "airgap-theme";
+    let fixture_tree = TempTree::new(json!({
+        "extension.toml": format!(
+            "id = \"{extension_id}\"\n\
+             name = \"Airgap Theme\"\n\
+             version = \"1.0.0\"\n\
+             schema_version = 1\n\
+             themes = [\"themes/airgap.json\"]\n"
+        ),
+        "themes": {
+            "airgap.json": theme_family_json,
+        },
+    }));
+    let fixture_dir = fixture_tree.path().canonicalize().unwrap();
+
+    let fs = Arc::new(RealFs::new(None, cx.executor()));
+    let extensions_tree = TempTree::new(json!({
+        "installed": {},
+        "work": {},
+        "staging": {},
+    }));
+    let extensions_dir = extensions_tree.path().canonicalize().unwrap();
+
+    let proxy = Arc::new(ExtensionHostProxy::new());
+    let theme_registry = Arc::new(ThemeRegistry::new(Box::new(())));
+    theme_extension::init(proxy.clone(), theme_registry.clone(), cx.executor());
+    let language_registry = Arc::new(LanguageRegistry::test(cx.executor()));
+    language_extension::init(LspAccess::Noop, proxy.clone(), language_registry.clone());
+    let node_runtime = NodeRuntime::unavailable();
+    let http_client = FakeHttpClient::with_404_response();
+
+    let extension_store = cx.new(|cx| {
+        ExtensionStore::new(
+            extensions_dir.clone(),
+            None,
+            proxy,
+            fs.clone(),
+            http_client.clone(),
+            http_client.clone(),
+            node_runtime,
+            cx,
+        )
+    });
+
+    // Keep reload debounces firing.
+    let mut events = cx.events(&extension_store);
+    let executor = cx.executor();
+    let _task = cx.executor().spawn(async move {
+        while let Some(event) = events.next().await {
+            if let Event::StartedReloading = event {
+                executor.advance_clock(RELOAD_DEBOUNCE_DURATION);
+            }
+        }
+    });
+
+    // Case 1: install from an unpacked directory.
+    extension_store
+        .update(cx, |store, cx| {
+            store.install_prebuilt_extension(fixture_dir.clone(), cx)
+        })
+        .await
+        .unwrap();
+    cx.executor().run_until_parked();
+
+    extension_store.read_with(cx, |store, _| {
+        let entry = store
+            .extension_index
+            .extensions
+            .get(extension_id)
+            .expect("extension should be in the index after directory install");
+        assert!(!entry.dev, "prebuilt extension must be a non-dev install");
+        assert!(
+            store
+                .extension_index
+                .themes
+                .contains_key(&Arc::from("Airgap Dark")),
+            "theme should be registered in the index"
+        );
+    });
+    assert!(
+        theme_registry
+            .list_names()
+            .iter()
+            .any(|name| name == "Airgap Dark"),
+        "theme should be registered in the theme registry after directory install"
+    );
+
+    // Case 2: install the same fixture packed as a .tar.gz archive. The archive is binary,
+    // so write the raw bytes directly rather than through a string-based fs API.
+    let archive_path = extensions_dir.join("airgap-theme.tar.gz");
+    std::fs::write(&archive_path, {
+        let mut tar_bytes = Vec::<u8>::new();
+        {
+            let mut archive = async_tar::Builder::new(&mut tar_bytes);
+            archive.append_dir_all(".", &fixture_dir).await.unwrap();
+            archive.into_inner().await.unwrap();
+        }
+        let mut gzipped_bytes = Vec::new();
+        let mut encoder = GzipEncoder::new(BufReader::new(tar_bytes.as_slice()));
+        encoder.read_to_end(&mut gzipped_bytes).await.unwrap();
+        gzipped_bytes
+    })
+    .unwrap();
+
+    extension_store
+        .update(cx, |store, cx| {
+            store.install_prebuilt_extension(archive_path.clone(), cx)
+        })
+        .await
+        .unwrap();
+    cx.executor().run_until_parked();
+
+    extension_store.read_with(cx, |store, _| {
+        let entry = store
+            .extension_index
+            .extensions
+            .get(extension_id)
+            .expect("extension should be in the index after archive install");
+        assert!(!entry.dev, "prebuilt extension must be a non-dev install");
+    });
+}
+
 fn init_test(cx: &mut TestAppContext) {
     cx.update(|cx| {
         let store = SettingsStore::test(cx);
