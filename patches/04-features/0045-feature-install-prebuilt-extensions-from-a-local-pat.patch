+    /// Installs a prebuilt extension from a local path, with no network access and
+    /// no compilation. This is intended for air-gapped environments: the operator
+    /// transfers an extension that was already built on a networked machine (either an
+    /// unpacked directory or the `.tar.gz` archive that `tools/snapshot-extensions.sh`
+    /// produces and the upstream registry serves) and installs it as a regular (non-dev)
+    /// extension.
+    pub fn install_prebuilt_extension(
+        &mut self,
+        source: PathBuf,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<()>> {
+        let fs = self.fs.clone();
+        let installed_dir = self.installed_dir.clone();
+        let staging_dir = self.staging_dir.clone();
+
+        cx.spawn(async move |this, cx| {
+            // Resolve `source` to an unpacked extension directory. A regular file is
+            // treated as a gzip tarball and unpacked into a fresh temp dir under
+            // `staging_dir`; a directory is used directly. When we unpack a tarball we
+            // can later move the temp dir into place, but a user-provided directory must
+            // be copied rather than moved.
+            let source_metadata = fs
+                .metadata(&source)
+                .await?
+                .with_context(|| format!("source path {source:?} does not exist"))?;
+
+            let staged_temp_dir;
+            let unpacked_dir: PathBuf;
+            let move_into_place;
+            if source_metadata.is_dir {
+                staged_temp_dir = None;
+                unpacked_dir = source.clone();
+                move_into_place = false;
+            } else {
+                let tar_gz_bytes = fs
+                    .load_bytes(&source)
+                    .await
+                    .with_context(|| format!("reading extension archive {source:?}"))?;
+
+                fs.create_dir(&staging_dir).await?;
+                let temp_dir = tempfile::tempdir_in(&staging_dir)?;
+
+                let decompressed_bytes = GzipDecoder::new(BufReader::new(tar_gz_bytes.as_slice()));
+                let archive = Archive::new(decompressed_bytes);
+                archive
+                    .unpack(temp_dir.path())
+                    .await
+                    .with_context(|| format!("unpacking extension archive {source:?}"))?;
+
+                unpacked_dir = temp_dir.path().to_path_buf();
+                staged_temp_dir = Some(temp_dir);
+                move_into_place = true;
+            }
+
+            let manifest = ExtensionManifest::load(fs.clone(), &unpacked_dir).await?;
+            let extension_id = manifest.id.clone();
+
+            // Air-gap guard: refuse to install an extension that ships Rust source but
+            // no compiled artifact, since compiling it would require the wasm toolchain
+            // (and, in practice, network access). Themes and grammars have neither file.
+            let ships_source = fs.is_file(&unpacked_dir.join("Cargo.toml")).await;
+            let has_wasm = fs.is_file(&unpacked_dir.join("extension.wasm")).await;
+            if ships_source && !has_wasm {
+                bail!(
+                    "extension '{extension_id}' ships source but no compiled extension.wasm; \
+                     build it on a networked machine (it requires the Rust/wasm toolchain) \
+                     and install the resulting archive"
+                );
+            }
+
+            if let Some(uninstall_task) = this
+                .update(cx, |this, cx| {
+                    this.extension_index
+                        .extensions
+                        .contains_key(extension_id.as_ref())
+                        .then(|| this.uninstall_extension(extension_id.clone(), cx))
+                })
+                .ok()
+                .flatten()
+            {
+                uninstall_task.await.log_err();
+            }
+
+            if !this.update(cx, |this, cx| {
+                match this.outstanding_operations.entry(extension_id.clone()) {
+                    btree_map::Entry::Occupied(_) => return false,
+                    btree_map::Entry::Vacant(e) => e.insert(ExtensionOperation::Install),
+                };
+                cx.notify();
+                true
+            })? {
+                return Ok(());
+            }
+
+            let _finish = cx.on_drop(&this, {
+                let extension_id = extension_id.clone();
+                move |this, cx| {
+                    this.outstanding_operations.remove(extension_id.as_ref());
+                    cx.notify();
+                }
+            });
+
+            let extension_dir = installed_dir.join(extension_id.as_ref());
+            cx.background_spawn({
+                let fs = fs.clone();
+                async move {
+                    fs.remove_dir(
+                        &extension_dir,
+                        RemoveOptions {
+                            recursive: true,
+                            ignore_if_not_exists: true,
+                        },
+                    )
+                    .await?;
+
+                    if move_into_place {
+                        fs.rename(
+                            &unpacked_dir,
+                            &extension_dir,
+                            RenameOptions {
+                                overwrite: true,
+                                ignore_if_exists: true,
+                                create_parents: true,
+                            },
+                        )
+                        .await?;
+                        // The temp dir was renamed into place; release the guard without
+                        // attempting to delete the (now moved) directory.
+                        if let Some(temp_dir) = staged_temp_dir {
+                            let _ = temp_dir.keep();
+                        }
+                    } else {
+                        fs::copy_recursive(
+                            &*fs,
+                            &unpacked_dir,
+                            &extension_dir,
+                            fs::CopyOptions {
+                                overwrite: true,
+                                ignore_if_exists: false,
+                            },
+                        )
+                        .await?;
+                    }
+
+                    anyhow::Ok(())
+                }
+            })
+            .await?;
+
+            this.update(cx, |this, cx| this.reload(Some(extension_id.clone()), cx))?
+                .await;
+
+            this.update(cx, |this, cx| {
+                cx.emit(Event::ExtensionInstalled(extension_id.clone()));
+                if let Some(events) = ExtensionEvents::try_global(cx)
+                    && let Some(manifest) = this.extension_manifest_for_id(&extension_id)
+                {
+                    events.update(cx, |this, cx| {
+                        this.emit(extension::Event::ExtensionInstalled(manifest.clone()), cx)
+                    });
+                }
+            })?;
+
+            Ok(())
+        })
+    }
+
