From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Mon, 15 Jun 2026 13:28:55 +0300
Subject: [PATCH] Add sidebar-independent activate/cycle/reorder project group
 methods

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 crates/workspace/src/multi_workspace.rs       | 61 +++++++++++++++++++
 crates/workspace/src/multi_workspace_tests.rs | 47 ++++++++++++++
 2 files changed, 108 insertions(+)

diff --git a/crates/workspace/src/multi_workspace.rs b/crates/workspace/src/multi_workspace.rs
index e26f31b2b1..27c34f177a 100644
--- a/crates/workspace/src/multi_workspace.rs
+++ b/crates/workspace/src/multi_workspace.rs
@@ -809,6 +809,63 @@ impl MultiWorkspace {
             .collect()
     }
 
+    /// Activate the workspace for `key`, loading it from disk if it is a known
+    /// project group that is not currently retained.
+    pub fn activate_project_group(
+        &mut self,
+        key: &ProjectGroupKey,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if let Some(workspace) = self
+            .last_active_workspace_for_group(key, cx)
+            .or_else(|| self.workspace_for_paths(key.path_list(), key.host().as_ref(), cx))
+        {
+            self.activate(workspace, None, window, cx);
+            return;
+        }
+        self.find_or_create_local_workspace(
+            key.path_list().clone(),
+            Some(key.clone()),
+            &[],
+            None,
+            OpenMode::Activate,
+            window,
+            cx,
+        )
+        .detach_and_log_err(cx);
+    }
+
+    /// Activate the next/previous project group in tab order.
+    pub fn cycle_project(&mut self, forward: bool, window: &mut Window, cx: &mut Context<Self>) {
+        let len = self.project_groups.len();
+        if len < 2 {
+            return;
+        }
+        let active = self.project_group_key_for_workspace(&self.workspace().clone(), cx);
+        let current = self.project_groups.iter().position(|g| g.key == active);
+        let next_ix = match current {
+            Some(i) if forward => (i + 1) % len,
+            Some(i) => (i + len - 1) % len,
+            None => 0,
+        };
+        let key = self.project_groups[next_ix].key.clone();
+        self.activate_project_group(&key, window, cx);
+    }
+
+    /// Reorder a project group tab from index `from` to index `to`.
+    pub fn move_project_group(&mut self, from: usize, to: usize, cx: &mut Context<Self>) {
+        let len = self.project_groups.len();
+        if from >= len || to >= len || from == to {
+            return;
+        }
+        let group = self.project_groups.remove(from);
+        self.project_groups.insert(to, group);
+        cx.emit(MultiWorkspaceEvent::ProjectGroupsChanged);
+        self.serialize(cx);
+        cx.notify();
+    }
+
     fn derived_project_groups(&self, cx: &App) -> Vec<ProjectGroup> {
         self.project_groups
             .iter()
@@ -2206,12 +2263,16 @@ impl Render for MultiWorkspace {
                     .on_action(cx.listener(|this: &mut Self, _: &NextProject, window, cx| {
                         if let Some(sidebar) = &this.sidebar {
                             sidebar.cycle_project(true, window, cx);
+                        } else {
+                            this.cycle_project(true, window, cx);
                         }
                     }))
                     .on_action(
                         cx.listener(|this: &mut Self, _: &PreviousProject, window, cx| {
                             if let Some(sidebar) = &this.sidebar {
                                 sidebar.cycle_project(false, window, cx);
+                            } else {
+                                this.cycle_project(false, window, cx);
                             }
                         }),
                     )
diff --git a/crates/workspace/src/multi_workspace_tests.rs b/crates/workspace/src/multi_workspace_tests.rs
index 3739de50aa..caa6f5eeaf 100644
--- a/crates/workspace/src/multi_workspace_tests.rs
+++ b/crates/workspace/src/multi_workspace_tests.rs
@@ -1102,3 +1102,50 @@ async fn test_project_tabs_setting_defaults_true(cx: &mut TestAppContext) {
         );
     });
 }
+
+#[gpui::test]
+async fn test_cycle_and_reorder_project_groups(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(path!("/a"), json!({ "x.txt": "" })).await;
+    fs.insert_tree(path!("/b"), json!({ "y.txt": "" })).await;
+
+    let project_a = Project::test(fs.clone(), [path!("/a").as_ref()], cx).await;
+    let (mw, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project_a, window, cx));
+
+    let project_b = Project::test(fs.clone(), [path!("/b").as_ref()], cx).await;
+    mw.update_in(cx, |mw, window, cx| {
+        mw.test_add_workspace(project_b, window, cx);
+    });
+    cx.run_until_parked();
+
+    mw.read_with(cx, |mw, _cx| {
+        assert_eq!(
+            mw.project_group_keys().len(),
+            2,
+            "expected two distinct project groups before cycling"
+        );
+    });
+
+    let (before, after) = mw.update_in(cx, |mw, window, cx| {
+        let before = mw.project_group_key_for_workspace(&mw.workspace().clone(), cx);
+        mw.cycle_project(true, window, cx);
+        let after = mw.project_group_key_for_workspace(&mw.workspace().clone(), cx);
+        (before, after)
+    });
+    cx.run_until_parked();
+    assert_ne!(before, after, "cycle_project should change the active group");
+
+    mw.update(cx, |mw, cx| {
+        let keys_before = mw.project_group_keys();
+        assert_eq!(keys_before.len(), 2, "expected two project groups");
+        mw.move_project_group(0, 1, cx);
+        let keys_after = mw.project_group_keys();
+        assert_eq!(
+            keys_before[0], keys_after[1],
+            "moved group lands at new index"
+        );
+        assert_eq!(keys_before[1], keys_after[0]);
+    });
+}
