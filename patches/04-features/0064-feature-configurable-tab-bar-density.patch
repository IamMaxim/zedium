+    /// Content-driven tab bar height when `tab_bar.padding` is set, so the bar
+    /// sizes to its content with the configured vertical padding. `None` keeps
+    /// the default fixed height path.
+    fn tab_bar_height_override(&self, cx: &App) -> Option<Pixels> {
+        let settings = TabBarSettings::get_global(cx);
+        let padding = settings.padding?;
+        let font_px = settings.font_size.unwrap_or(14.);
+        let icon_px = settings.icon_size.unwrap_or(14.);
+        let content = (font_px * 1.5).max(icon_px);
+        Some(px(content + 2. * ui::clamp_bar_padding(padding)))
+    }
