+    /// Overrides the side length of the square that wraps the end slot (the
+    /// close/pin button). The default reserves [`END_TAB_SLOT_SIZE`]; a larger
+    /// icon button (e.g. a per-bar `icon_size`) needs the slot to match its full
+    /// square so its hover background does not overflow into the tab padding.
+    pub fn end_slot_size(mut self, size: impl Into<Option<Pixels>>) -> Self {
+        self.end_slot_size = size.into();
+        self
+    }
+
+    pub fn vertical_padding(mut self, padding: impl Into<Option<Pixels>>) -> Self {
+        self.vertical_padding = padding.into();
+        self
+    }
+
     pub fn position(mut self, position: TabPosition) -> Self {
         self.position = position;
         self
@@ -83,6 +101,19 @@ impl Tab {
     pub fn container_height(cx: &App) -> Pixels {
         DynamicSpacing::Base32.px(cx)
     }
+
+    /// Like [`Tab::container_height`], but resolved against the window rem size
+    /// so the tab bar scales with a per-bar `WithRemSize` override. At the
+    /// default rem size (which equals `ui_font_size`) this is identical to
+    /// [`Tab::container_height`].
+    pub fn scaled_container_height(window: &Window, cx: &App) -> Pixels {
+        DynamicSpacing::Base32.rems(cx).to_pixels(window.rem_size())
+    }
+
+    /// Window-rem-aware counterpart to [`Tab::content_height`].
+    pub fn scaled_content_height(window: &Window, cx: &App) -> Pixels {
+        Self::scaled_container_height(window, cx) - px(1.)
+    }
 }
 
