From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Mon, 15 Jun 2026 14:06:37 +0300
Subject: [PATCH] Bind project tab next/previous/new in default keymaps

---
 assets/keymaps/default-linux.json   | 2 ++
 assets/keymaps/default-macos.json   | 2 ++
 assets/keymaps/default-windows.json | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/assets/keymaps/default-linux.json b/assets/keymaps/default-linux.json
index 4f7f48f080..6e544b5652 100644
--- a/assets/keymaps/default-linux.json
+++ b/assets/keymaps/default-linux.json
@@ -667,6 +667,8 @@
       "ctrl-j": "workspace::ToggleBottomDock",
       "ctrl-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
       "ctrl-alt-;": "multi_workspace::FocusWorkspaceSidebar",
+      "ctrl-shift-]": "multi_workspace::NextProject",
+      "ctrl-shift-[": "multi_workspace::PreviousProject",
       "ctrl-alt-y": "workspace::ToggleAllDocks",
       "ctrl-alt-0": "workspace::ResetActiveDockSize",
       // For 0px parameter, uses UI font size value.
diff --git a/assets/keymaps/default-macos.json b/assets/keymaps/default-macos.json
index d863532f0d..f3eb0906da 100644
--- a/assets/keymaps/default-macos.json
+++ b/assets/keymaps/default-macos.json
@@ -724,6 +724,8 @@
       "cmd-j": "workspace::ToggleBottomDock",
       "cmd-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
       "cmd-alt-;": "multi_workspace::FocusWorkspaceSidebar",
+      "cmd-shift-]": "multi_workspace::NextProject",
+      "cmd-shift-[": "multi_workspace::PreviousProject",
       "alt-cmd-y": "workspace::ToggleAllDocks",
       // For 0px parameter, uses UI font size value.
       "ctrl-alt-0": "workspace::ResetActiveDockSize",
diff --git a/assets/keymaps/default-windows.json b/assets/keymaps/default-windows.json
index b95f88b8fc..703d2cd8dc 100644
--- a/assets/keymaps/default-windows.json
+++ b/assets/keymaps/default-windows.json
@@ -658,6 +658,8 @@
       "ctrl-j": "workspace::ToggleBottomDock",
       "ctrl-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
       "ctrl-alt-;": "multi_workspace::FocusWorkspaceSidebar",
+      "ctrl-shift-]": "multi_workspace::NextProject",
+      "ctrl-shift-[": "multi_workspace::PreviousProject",
       "ctrl-shift-y": "workspace::ToggleAllDocks",
       "alt-r": "workspace::ResetActiveDockSize",
       // For 0px parameter, uses UI font size value.
