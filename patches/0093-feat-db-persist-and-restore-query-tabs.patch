+impl SerializableItem for QueryView {
+    fn serialized_item_kind() -> &'static str {
+        "DatabaseQueryView"
+    }
+
+    fn cleanup(
+        workspace_id: WorkspaceId,
+        alive_items: Vec<ItemId>,
+        _window: &mut Window,
+        cx: &mut App,
+    ) -> Task<anyhow::Result<()>> {
+        let db = QueryDb::global(cx);
+        delete_unloaded_items(alive_items, workspace_id, "database_query_views", &db, cx)
+    }
+
+    fn serialize(
+        &mut self,
+        _workspace: &mut Workspace,
+        item_id: ItemId,
+        _closing: bool,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<Task<anyhow::Result<()>>> {
+        if !self.needs_serialize {
+            return None;
+        }
+
+        let workspace_id = self.workspace_id?;
+        let profile_id = self.profile.as_ref()?.id.clone();
+        let sql = self.editor.read(cx).text(cx);
+        self.needs_serialize = false;
+
+        let db = QueryDb::global(cx);
+        Some(cx.background_spawn(async move {
+            db.save_query(item_id, workspace_id, profile_id, sql).await
+        }))
+    }
+
+    fn should_serialize(&self, _event: &Self::Event) -> bool {
+        self.needs_serialize
+    }
+
+    fn deserialize(
+        _project: Entity<Project>,
+        workspace: WeakEntity<Workspace>,
+        workspace_id: WorkspaceId,
+        item_id: ItemId,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Task<anyhow::Result<Entity<Self>>> {
+        let db = QueryDb::global(cx);
+        let loaded = db.get_query(item_id, workspace_id).log_err().flatten();
+        window.spawn(cx, async move |cx| {
+            let (profile_id, sql) = match loaded {
+                Some(row) => row,
+                None => (String::new(), String::new()),
+            };
+            let profile = store::load_profiles()
+                .into_iter()
+                .find(|p| p.id == profile_id);
+            cx.update(|window, cx| {
+                Ok(cx.new(|cx| {
+                    QueryView::new(profile, None, sql, workspace.clone(), Some(workspace_id), window, cx)
+                }))
+            })?
+        })
+    }
+}
