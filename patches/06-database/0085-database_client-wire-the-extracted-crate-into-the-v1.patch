+/// Settings for the database client's query results grid and pagination.
+#[with_fallible_options]
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize, JsonSchema, MergeFrom)]
+pub struct DatabaseSettingsContent {
+    /// Sets the font family for the query results grid.
+    ///
+    /// If this option is not included, the results grid will default to
+    /// matching the buffer's font family.
+    pub results_font_family: Option<FontFamilyName>,
+    /// Sets the font size for the query results grid.
+    ///
+    /// If this option is not included, the results grid will default to
+    /// matching the buffer's font size.
+    pub results_font_size: Option<FontSize>,
+    /// Number of rows fetched per page of query results.
+    /// Values below 50 are clamped to 50.
+    ///
+    /// Default: 500
+    pub page_size: Option<usize>,
+    /// Horizontal padding (px), per side, of results-grid cells.
+    /// Values are clamped to the range 0-24.
+    ///
+    /// If this option is not included, defaults to 6 (the current density).
+    pub results_row_padding: Option<f32>,
+    /// Line height of the query results grid, decoupled from the global
+    /// `ui_line_height` setting.
+    ///
+    /// If this option is not included, the results grid falls back to the
+    /// global `ui_line_height`.
+    pub results_line_height: Option<UiLineHeight>,
+    /// Density settings for the sidebar connection/database/schema/table tree.
+    pub sidebar: Option<DatabaseSidebarSettingsContent>,
+    /// Density settings for the query console toolbar (Run button, status
+    /// labels).
+    pub toolbar: Option<DatabaseToolbarSettingsContent>,
+    /// Enables the one-time schema metadata sweep that powers SQL autocomplete
+    /// in query editors.
+    ///
+    /// Default: true
+    pub metadata_cache: Option<bool>,
+    /// String written for SQL `NULL` values in CSV export.
+    ///
+    /// If this option is not included, NULLs export as an empty field.
+    pub export_null_string: Option<String>,
+    /// Confirm before submitting grid DML edits.
+    ///
+    /// Default: true
+    pub confirm_edits: Option<bool>,
+    /// Global read-only default; disables all edit/DML affordances.
+    /// A per-profile `read_only` also forces this on for that connection.
+    ///
+    /// Default: false
+    pub read_only: Option<bool>,
+    /// Default commit mode for new query tabs: "auto" or "manual".
+    ///
+    /// Default: "auto"
+    pub commit_mode: Option<String>,
+    /// Executed-statement history retention (oldest pruned beyond this).
+    ///
+    /// Default: 1000
+    pub history_limit: Option<usize>,
+}
+
+/// Density settings for the database client sidebar tree.
+#[with_fallible_options]
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize, JsonSchema, MergeFrom)]
+pub struct DatabaseSidebarSettingsContent {
+    /// Vertical padding (px) added to each tree row, on top of the row's
+    /// content height. Values are clamped to the range 0-40.
+    pub padding: Option<f32>,
+    /// Font size (px) of tree row labels.
+    pub font_size: Option<f32>,
+    /// Icon size (px) of node and disclosure icons. Values are clamped to
+    /// the range 6-48.
+    pub icon_size: Option<f32>,
+}
+
+/// Density settings for the database client's query console toolbar.
+#[with_fallible_options]
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize, JsonSchema, MergeFrom)]
+pub struct DatabaseToolbarSettingsContent {
+    /// Vertical padding (px) of the query console toolbar. Values are
+    /// clamped to the range 0-40.
+    pub padding: Option<f32>,
+    /// Font size (px) of toolbar labels and buttons.
+    pub font_size: Option<f32>,
+    /// Icon size (px) of the Run button. Values are clamped to the range
+    /// 6-48.
+    pub icon_size: Option<f32>,
+}
