From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 01:09:18 +0300
Subject: [PATCH] acp_thread: add entry-index-keyed subagent membership for
 text entries
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

AssistantMessage/thought entries have no ToolCallId, so membership for
them needs a second map keyed by their stable index into AcpThread's
append-only entries Vec. Pure data layer — no ingest wiring yet.
---
 crates/acp_thread/src/acp_thread.rs | 68 ++++++++++++++++++++++++++++-
 1 file changed, 67 insertions(+), 1 deletion(-)

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index 74c54a3aab..68d1c22efd 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -231,7 +231,7 @@ pub struct SubagentRoot {
 }
 
 /// A same-thread tool call that belongs to some root's subtree.
-#[derive(Clone, Debug)]
+#[derive(Clone, Debug, PartialEq)]
 pub struct SubagentMembership {
     pub parent: acp::ToolCallId,
     pub subagent_type: SharedString,
@@ -323,6 +323,7 @@ impl SubagentGrouping for NativeSubagentGrouping {
 pub struct SubagentIndex {
     roots: collections::IndexMap<acp::ToolCallId, SubagentRoot>,
     membership: HashMap<acp::ToolCallId, SubagentMembership>,
+    entry_membership: HashMap<usize, SubagentMembership>,
 }
 
 impl SubagentIndex {
@@ -464,6 +465,35 @@ impl SubagentIndex {
             .cloned()
             .collect()
     }
+
+    /// Like `apply`, but for transcript entries that have no `ToolCallId` of their
+    /// own (text/thought chunks). Only the `Member` arm is meaningful here — a text
+    /// entry can never itself be a subagent root (only tool calls spawn subagents),
+    /// so `Root` classifications are silently ignored to keep this defensive against
+    /// a future adapter bug rather than panicking on it.
+    pub fn apply_entry(&mut self, entry_ix: usize, classification: SubagentClassification) {
+        if let SubagentClassification::Member {
+            parent,
+            subagent_type,
+        } = classification
+        {
+            self.entry_membership.insert(
+                entry_ix,
+                SubagentMembership {
+                    parent,
+                    subagent_type,
+                },
+            );
+        }
+    }
+
+    pub fn is_text_member(&self, entry_ix: usize) -> bool {
+        self.entry_membership.contains_key(&entry_ix)
+    }
+
+    pub fn entry_membership_of(&self, entry_ix: usize) -> Option<&SubagentMembership> {
+        self.entry_membership.get(&entry_ix)
+    }
 }
 
 #[derive(Debug)]
@@ -4075,6 +4105,42 @@ mod tests {
         assert_eq!(orphan.root_of(&child), None);
     }
 
+    #[test]
+    fn subagent_index_tracks_text_entry_membership() {
+        let mut index = SubagentIndex::default();
+        let root = acp::ToolCallId::new("R");
+
+        index.apply(
+            &root,
+            SubagentClassification::Root {
+                subagent_type: Some(SharedString::from("Explore")),
+                subtree: SubagentSubtree::SameThread,
+            },
+        );
+
+        // Entry index 3 in the thread's `entries` Vec is a streamed AssistantMessage
+        // tagged as belonging to `root`.
+        index.apply_entry(
+            3,
+            SubagentClassification::Member {
+                parent: root.clone(),
+                subagent_type: SharedString::from("Explore"),
+            },
+        );
+
+        assert!(index.is_text_member(3));
+        assert!(!index.is_text_member(4));
+        assert_eq!(
+            index.entry_membership_of(3).map(|m| m.parent.clone()),
+            Some(root)
+        );
+        assert_eq!(index.entry_membership_of(4), None);
+
+        // A NotSubagent classification must not register membership.
+        index.apply_entry(5, SubagentClassification::NotSubagent);
+        assert!(!index.is_text_member(5));
+    }
+
     #[test]
     fn subagent_index_resolves_out_of_order() {
         let mut index = SubagentIndex::default();
