From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 02:39:50 +0300
Subject: [PATCH] agent_ui: fix clippy redundant-clone in subagent pop-out
 button

The unified subagent titlebar chrome added a `.when_some(same_thread_root.clone(), ...)` call where same_thread_root is not used afterward, tripping clippy::redundant_clone under `./script/clippy`.
---
 crates/agent_ui/src/conversation_view/thread_view.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/agent_ui/src/conversation_view/thread_view.rs b/crates/agent_ui/src/conversation_view/thread_view.rs
index 26ed72222e..e407990378 100644
--- a/crates/agent_ui/src/conversation_view/thread_view.rs
+++ b/crates/agent_ui/src/conversation_view/thread_view.rs
@@ -9479,7 +9479,7 @@ impl ThreadView {
                                 ),
                         )
                     })
-                    .when_some(same_thread_root.clone(), |buttons, root| {
+                    .when_some(same_thread_root, |buttons, root| {
                         buttons.child(
                             IconButton::new(
                                 SharedString::from(format!("subagent-group-open-{entry_ix}")),
