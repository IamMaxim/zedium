From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Thu, 2 Jul 2026 12:36:36 +0300
Subject: [PATCH] fix(client): remove strip-patch clippy residue blocking
 ./script/clippy

The zedium strip patch removed the cloud sign-in caller of
connect_to_cloud, leaving an unused `feature_flags::FeatureFlagAppExt`
import and the never-called connect_to_cloud / run_cloud_connection /
handle_message_to_client chain, which made `./script/clippy` (deny
warnings) exit 101 for every crate that builds `client`. Drop the import
and gate the orphaned methods with allow(dead_code) comments so upstream
merges stay clean.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MQKuAnEREjToPLedE7KAqP
---
 crates/client/src/client.rs | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/crates/client/src/client.rs b/crates/client/src/client.rs
index e0c6f2c339..ea2c719fe1 100644
--- a/crates/client/src/client.rs
+++ b/crates/client/src/client.rs
@@ -18,7 +18,6 @@ use cloud_api_client::websocket_protocol::MessageToClient;
 use cloud_api_client::{ClientApiError, CloudApiClient};
 use cloud_api_types::OrganizationId;
 use credentials_provider::CredentialsProvider;
-use feature_flags::FeatureFlagAppExt as _;
 use futures::{
     FutureExt, SinkExt, Stream, StreamExt, TryFutureExt as _, TryStreamExt,
     channel::{mpsc, oneshot},
@@ -937,6 +936,9 @@ impl Client {
     ///
     /// The connection is re-established with exponential backoff if it drops or fails to
     /// establish.
+    // The zedium strip patch removed this method's only caller (cloud sign-in);
+    // the method chain is kept intact so upstream merges stay clean.
+    #[allow(dead_code)]
     fn connect_to_cloud(self: &Arc<Self>, cx: &AsyncApp) {
         let this = self.clone();
         let task = cx.spawn(async move |cx| {
@@ -969,6 +971,8 @@ impl Client {
 
     /// Runs a single attempt of the cloud websocket connection, returning once the connection
     /// closes (cleanly or otherwise) or fails to establish.
+    // Only reachable from `connect_to_cloud`, which the zedium strip patch orphaned.
+    #[allow(dead_code)]
     async fn run_cloud_connection(self: &Arc<Self>, cx: &mut AsyncApp) -> Result<()> {
         let connect_task = cx.update({
             let cloud_client = self.cloud_client.clone();
@@ -1660,6 +1664,8 @@ impl Client {
             .push(Box::new(handler));
     }
 
+    // Only reachable from `run_cloud_connection`, which the zedium strip patch orphaned.
+    #[allow(dead_code)]
     fn handle_message_to_client(self: &Arc<Client>, message: MessageToClient, cx: &AsyncApp) {
         cx.update(|cx| {
             for handler in self.message_to_client_handlers.lock().iter() {
@@ -1667,7 +1673,6 @@ impl Client {
             }
         });
     }
-
 }
 
 impl ProtoClient for Client {
