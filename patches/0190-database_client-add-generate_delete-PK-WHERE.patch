From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Sat, 4 Jul 2026 18:33:36 +0300
Subject: [PATCH] database_client: add generate_delete (PK WHERE)

---
 crates/database_client/src/connection/edit.rs | 34 +++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/crates/database_client/src/connection/edit.rs b/crates/database_client/src/connection/edit.rs
index 79c27120d8..5d76335021 100644
--- a/crates/database_client/src/connection/edit.rs
+++ b/crates/database_client/src/connection/edit.rs
@@ -118,6 +118,22 @@ pub fn generate_insert(
     )
 }
 
+/// Approach-A `DELETE` for a row identified by its primary-key columns only.
+#[allow(dead_code)]
+pub fn generate_delete(
+    schema: &str,
+    table: &str,
+    pk: &[(String, String)],
+    col_types: &HashMap<String, String>,
+) -> String {
+    format!(
+        "DELETE FROM {}.{} WHERE {}",
+        quote_ident(schema),
+        quote_ident(table),
+        pk_predicate(pk, col_types)
+    )
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
@@ -234,4 +250,22 @@ mod tests {
              VALUES ('9'::integer, NULL, ''::text)"
         );
     }
+
+    #[test]
+    fn delete_targets_row_by_full_pk() {
+        assert_eq!(
+            generate_delete("app", "users", &[("id".into(), "7".into())], &types()),
+            "DELETE FROM \"app\".\"users\" WHERE \"id\" = '7'::integer"
+        );
+    }
+
+    #[test]
+    fn delete_uses_composite_pk_and_quotes() {
+        let pk = vec![("id".into(), "7".into()), ("tenant".into(), "t'1".into())];
+        assert_eq!(
+            generate_delete("app", "users", &pk, &types()),
+            "DELETE FROM \"app\".\"users\" \
+             WHERE \"id\" = '7'::integer AND \"tenant\" = 't''1'::uuid"
+        );
+    }
 }
