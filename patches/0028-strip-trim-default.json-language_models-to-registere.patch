From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Sun, 31 May 2026 12:55:08 +0300
Subject: [PATCH] strip: trim default.json language_models to registered
 providers

Upstream shipped hosted-vendor provider defaults (anthropic, google,
openai, open_router, deepseek, mistral, x_ai, bedrock, vercel, zed.dev,
opencode) with hardcoded endpoints. Those provider crates were deleted
and the cloud chat providers are not registered. Reduce the default
block to what Zedium actually registers: Ollama, OpenAI-compatible,
LM Studio. Removes the dead endpoint defaults from shipped settings.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 assets/settings/default.json | 32 +++-----------------------------
 1 file changed, 3 insertions(+), 29 deletions(-)

diff --git a/assets/settings/default.json b/assets/settings/default.json
index e5055cdffd..969d89ff90 100644
--- a/assets/settings/default.json
+++ b/assets/settings/default.json
@@ -2347,43 +2347,17 @@
     },
   },
   // Different settings for specific language models.
+  // Zedium registers only user-configured, self-hosted/BYO chat providers:
+  // Ollama, LM Studio, and OpenAI-compatible. The hosted-vendor provider
+  // defaults from upstream Zed were removed along with their crates.
   "language_models": {
-    "anthropic": {
-      "api_url": "https://api.anthropic.com",
-    },
-    "bedrock": {},
-    "google": {
-      "api_url": "https://generativelanguage.googleapis.com",
-    },
     "ollama": {
       "api_url": "http://localhost:11434",
     },
-    "openai": {
-      "api_url": "https://api.openai.com/v1",
-    },
     "openai_compatible": {},
-    "opencode": {
-      "api_url": "https://opencode.ai/zen",
-    },
-    "open_router": {
-      "api_url": "https://openrouter.ai/api/v1",
-    },
     "lmstudio": {
       "api_url": "http://localhost:1234/api/v0",
     },
-    "deepseek": {
-      "api_url": "https://api.deepseek.com/v1",
-    },
-    "mistral": {
-      "api_url": "https://api.mistral.ai/v1",
-    },
-    "vercel_ai_gateway": {
-      "api_url": "https://ai-gateway.vercel.sh/v1",
-    },
-    "x_ai": {
-      "api_url": "https://api.x.ai/v1",
-    },
-    "zed.dev": {},
   },
   "session": {
     // Whether or not to restore unsaved buffers on restart.
