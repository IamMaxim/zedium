+        /// tool calls (`auto`, `qwen`, or `none`).
+        ///
+        /// Default: auto
+        acp_flavor: Option<AcpFlavor>,
     },
     // Used for the ACP extension migration
     #[serde(alias = "extension")]
@@ -777,6 +809,11 @@ pub enum CustomAgentServerSettings {
         /// Default: {}
         #[serde(default, skip_serializing_if = "HashMap::is_empty")]
         favorite_config_option_values: HashMap<String, Vec<String>>,
+        /// Which ACP provider's subagent convention to use for grouping subagent
+        /// tool calls (`auto`, `qwen`, or `none`).
+        ///
+        /// Default: auto
+        acp_flavor: Option<AcpFlavor>,
     },
 }
 
