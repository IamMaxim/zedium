+/// Which ACP provider's subagent convention to use when grouping subagent tool
+/// calls. `Auto` detects from the agent's self-reported name; the other values
+/// force a specific behavior, useful when an agent reports a name Zed does not
+/// recognize.
+#[derive(
+    Clone,
+    Copy,
+    Debug,
+    Default,
+    PartialEq,
+    Eq,
+    Serialize,
+    Deserialize,
+    JsonSchema,
+    MergeFrom,
+)]
+#[serde(rename_all = "snake_case")]
+pub enum AcpFlavor {
+    /// Detect the subagent convention from the agent's reported name.
+    #[default]
+    Auto,
+    /// Force qwen-code's same-session, parent-pointer subagent grouping.
+    Qwen,
+    /// Disable subagent grouping for this agent.
+    None,
+}
+
 #[with_fallible_options]
 #[derive(Deserialize, Serialize, Clone, JsonSchema, MergeFrom, Debug, PartialEq)]
 #[serde(tag = "type", rename_all = "snake_case")]
