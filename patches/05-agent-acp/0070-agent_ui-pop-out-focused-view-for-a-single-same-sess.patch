+    /// Whether an entry should appear in the flat transcript list. In normal mode
+    /// same-thread subagent members are hidden (shown inside their root's group);
+    /// in focused mode only the focused subagent's subtree is shown.
+    fn is_entry_visible(&self, entry: &AgentThreadEntry, cx: &App) -> bool {
+        let index = self.thread.read(cx).subagent_index();
+        match &self.focused_subagent {
+            Some(root) => match entry {
+                AgentThreadEntry::ToolCall(tool_call) => {
+                    &tool_call.id == root || index.root_of(&tool_call.id).as_ref() == Some(root)
+                }
+                _ => false,
+            },
+            None => match entry {
+                AgentThreadEntry::ToolCall(tool_call) => !index.is_member(&tool_call.id),
+                _ => true,
+            },
+        }
+    }
+
+    /// Breadcrumb shown above the transcript while focused on a single subagent,
+    /// with a button to return to the full transcript.
+    fn render_focused_subagent_bar(&self, cx: &Context<Self>) -> Option<Div> {
