From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Mon, 15 Jun 2026 13:35:58 +0300
Subject: [PATCH] Add NewProjectTab and CloseProjectTab actions

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 crates/workspace/src/multi_workspace.rs       | 17 ++++++++++
 crates/workspace/src/multi_workspace_tests.rs | 31 +++++++++++++++++++
 2 files changed, 48 insertions(+)

diff --git a/crates/workspace/src/multi_workspace.rs b/crates/workspace/src/multi_workspace.rs
index 5ea8f82927..f97c348ff3 100644
--- a/crates/workspace/src/multi_workspace.rs
+++ b/crates/workspace/src/multi_workspace.rs
@@ -54,6 +54,10 @@ actions!(
         NewThread,
         /// Moves the active project to a new window.
         MoveProjectToNewWindow,
+        /// Opens the Recent Projects picker to open another project as a new tab.
+        NewProjectTab,
+        /// Closes the active project tab.
+        CloseProjectTab,
     ]
 );
 
@@ -2270,6 +2274,19 @@ impl Render for MultiWorkspace {
                             }
                         }),
                     )
+                    .on_action(cx.listener(|_this: &mut Self, _: &NewProjectTab, window, cx| {
+                        window.dispatch_action(
+                            Box::new(zed_actions::OpenRecent {
+                                create_new_window: false,
+                            }),
+                            cx,
+                        );
+                    }))
+                    .on_action(cx.listener(|this: &mut Self, _: &CloseProjectTab, window, cx| {
+                        let key = this.project_group_key_for_workspace(this.workspace(), cx);
+                        this.remove_project_group(&key, window, cx)
+                            .detach_and_log_err(cx);
+                    }))
                     .on_action(cx.listener(|this: &mut Self, _: &NextThread, window, cx| {
                         if let Some(sidebar) = &this.sidebar {
                             sidebar.cycle_thread(true, window, cx);
diff --git a/crates/workspace/src/multi_workspace_tests.rs b/crates/workspace/src/multi_workspace_tests.rs
index eceb159307..e02a459639 100644
--- a/crates/workspace/src/multi_workspace_tests.rs
+++ b/crates/workspace/src/multi_workspace_tests.rs
@@ -2,6 +2,7 @@ use std::path::PathBuf;
 
 use super::*;
 use crate::item::test::TestItem;
+use crate::multi_workspace::CloseProjectTab;
 use client::proto;
 use fs::{FakeFs, Fs};
 use gpui::{TestAppContext, VisualTestContext};
@@ -962,3 +963,33 @@ async fn test_cycle_and_reorder_project_groups(cx: &mut TestAppContext) {
         assert_eq!(keys_before[1], keys_after[0]);
     });
 }
+
+#[gpui::test]
+async fn test_close_active_project_tab_activates_neighbor(cx: &mut TestAppContext) {
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(path!("/a"), json!({ "x.txt": "" })).await;
+    fs.insert_tree(path!("/b"), json!({ "y.txt": "" })).await;
+
+    let project_a = Project::test(fs.clone(), [path!("/a").as_ref()], cx).await;
+    let (mw, cx) =
+        cx.add_window_view(|window, cx| MultiWorkspace::test_new(project_a, window, cx));
+    let project_b = Project::test(fs.clone(), [path!("/b").as_ref()], cx).await;
+    mw.update_in(cx, |mw, window, cx| {
+        mw.test_add_workspace(project_b, window, cx);
+    });
+    cx.run_until_parked();
+
+    mw.update_in(cx, |_mw, window, cx| {
+        window.dispatch_action(Box::new(CloseProjectTab), cx);
+    });
+    cx.run_until_parked();
+
+    mw.read_with(cx, |mw, _cx| {
+        assert_eq!(
+            mw.project_group_keys().len(),
+            1,
+            "one tab remains after closing the active one"
+        );
+    });
+}
