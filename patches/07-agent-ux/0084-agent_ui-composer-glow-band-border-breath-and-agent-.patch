+    /// One 800ms border "exhale" on the composer after a turn completes
+    /// successfully (spec §3.4). Full animation level only.
+    pub(crate) fn trigger_completion_glow(&mut self, cx: &mut Context<Self>) {
+        if !matches!(Self::animation_level(cx), AnimationLevel::Full) {
+            return;
+        }
+        self.completion_glow_seq += 1;
+        self.completion_glow_until = Some(Instant::now() + Self::COMPLETION_GLOW_DURATION);
+        self._completion_glow_task = Some(cx.spawn(async move |this, cx| {
+            cx.background_executor()
+                .timer(Self::COMPLETION_GLOW_DURATION)
+                .await;
+            this.update(cx, |this, cx| {
+                this.completion_glow_until = None;
+                cx.notify();
+            })
+            .ok();
+        }));
+        cx.notify();
+    }
