 impl RenderOnce for Disclosure {
     fn render(self, _window: &mut Window, _cx: &mut App) -> impl IntoElement {
+        if let Some(degrees) = self.eased_rotation {
+            let icon_color = if self.disabled {
+                Color::Disabled
+            } else {
+                Color::Muted
+            };
+            let is_open = self.is_open;
+            let total_rotation = degrees.to_radians();
+            let icon = Icon::new(self.closed_icon)
+                .size(IconSize::Small)
+                .color(icon_color)
+                .with_animation(
+                    (self.id.clone(), if is_open { "open" } else { "closed" }),
+                    Animation::new(Duration::from_millis(120)).with_easing(ease_in_out),
+                    move |icon, delta| {
+                        let angle = if is_open {
+                            total_rotation * delta
+                        } else {
+                            total_rotation * (1.0 - delta)
+                        };
+                        icon.transform(Transformation::rotate(radians(angle)))
+                    },
+                );
+
+            return ButtonLike::new(self.id)
+                .child(icon)
+                .disabled(self.disabled)
+                .toggle_state(self.selected)
+                .when_some(self.visible_on_hover.clone(), |this, group_name| {
