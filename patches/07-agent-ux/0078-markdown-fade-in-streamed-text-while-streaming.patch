+const MAX_RECENT_APPENDS: usize = 32;
+const MAX_RECENT_APPEND_AGE: Duration = Duration::from_secs(1);
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct RecentAppend {
+    pub start: usize,
+    pub at: Instant,
+}
+
+fn eased_fade_alpha(
+    appends: &VecDeque<RecentAppend>,
+    source_offset: usize,
+    now: Instant,
+    fade: Duration,
+) -> Option<f32> {
+    if fade.is_zero() {
+        return None;
+    }
+    let append = appends
+        .iter()
+        .rev()
+        .find(|append| append.start <= source_offset)?;
+    let elapsed = now.saturating_duration_since(append.at);
+    if elapsed >= fade {
+        return None;
+    }
+    let progress = (elapsed.as_secs_f32() / fade.as_secs_f32()).clamp(0.0, 1.0);
+    Some(1.0 - (1.0 - progress) * (1.0 - progress))
+}
