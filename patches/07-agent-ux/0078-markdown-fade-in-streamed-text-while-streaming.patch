+    #[test]
+    fn test_fade_alpha_for_offset() {
+        let fade = Duration::from_millis(250);
+        let start_time = Instant::now();
+        let mut appends = VecDeque::new();
+        appends.push_back(RecentAppend {
+            start: 100,
+            at: start_time,
+        });
+
+        // Offsets before the first recorded append are fully opaque.
+        assert_eq!(eased_fade_alpha(&appends, 0, start_time, fade), None);
+        assert_eq!(eased_fade_alpha(&appends, 99, start_time, fade), None);
+
+        // A fresh append starts (nearly) fully transparent.
+        let fresh = eased_fade_alpha(&appends, 100, start_time, fade).unwrap();
+        assert!(fresh < 0.01, "fresh alpha should be ~0, got {fresh}");
+
+        // Halfway through the window the alpha has increased; with ease-out it
+        // is already past the halfway alpha.
+        let halfway =
+            eased_fade_alpha(&appends, 100, start_time + Duration::from_millis(125), fade).unwrap();
+        assert!(halfway > fresh && halfway < 1.0);
+        assert!(halfway > 0.5, "ease-out should front-load, got {halfway}");
+
+        // Once the window has elapsed the offset is opaque again.
+        assert_eq!(eased_fade_alpha(&appends, 100, start_time + fade, fade), None);
+
+        // The youngest append at-or-before the offset wins.
+        let second_time = start_time + Duration::from_millis(200);
+        appends.push_back(RecentAppend {
+            start: 140,
+            at: second_time,
+        });
+        assert!(eased_fade_alpha(&appends, 150, second_time, fade).unwrap() < 0.01);
+        // Offset 120 belongs to the first (older) append, which has expired here.
+        assert_eq!(eased_fade_alpha(&appends, 120, second_time + fade, fade), None);
+
+        // Zero duration disables fading entirely.
+        assert_eq!(
+            eased_fade_alpha(&appends, 150, second_time, Duration::ZERO),
+            None
+        );
+    }
+
+    #[gpui::test]
+    async fn test_recent_appends_recorded_and_cleared(cx: &mut TestAppContext) {
+        ensure_theme_initialized(cx);
+        let markdown = cx.new(|cx| Markdown::new("hello".into(), None, None, cx));
+        markdown.update(cx, |markdown, cx| {
+            markdown.append(" world", cx);
+            assert_eq!(markdown.recent_appends.len(), 1);
+            assert_eq!(markdown.recent_appends[0].start, 5);
+
+            markdown.append("!", cx);
+            assert_eq!(markdown.recent_appends.len(), 2);
+            assert_eq!(markdown.recent_appends[1].start, 11);
+
+            markdown.append("", cx);
+            assert_eq!(markdown.recent_appends.len(), 2, "empty append records nothing");
+
+            markdown.replace("fresh", cx);
+            assert!(markdown.recent_appends.is_empty(), "replace clears the deque");
+
+            markdown.append("!", cx);
+            assert_eq!(markdown.recent_appends.len(), 1);
+            markdown.reset("reset".into(), cx);
+            assert!(markdown.recent_appends.is_empty(), "reset clears the deque");
+        });
+    }
