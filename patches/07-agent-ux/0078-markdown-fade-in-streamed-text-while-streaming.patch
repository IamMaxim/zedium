+    /// Eased fade-in alpha for source text at `source_offset` when it was
+    /// appended recently enough to still be fading in. `None` = fully opaque.
+    pub fn fade_alpha_for_offset(
+        &self,
+        source_offset: usize,
+        now: Instant,
+        fade: Duration,
+    ) -> Option<f32> {
+        eased_fade_alpha(&self.recent_appends, source_offset, now, fade)
+    }
+
+    fn has_live_appends(&self, now: Instant, fade: Duration) -> bool {
+        self.recent_appends
+            .iter()
+            .any(|append| now.saturating_duration_since(append.at) < fade)
+    }
+
+    fn prune_recent_appends(&mut self, now: Instant) {
+        while let Some(front) = self.recent_appends.front() {
+            if now.saturating_duration_since(front.at) > MAX_RECENT_APPEND_AGE {
+                self.recent_appends.pop_front();
+            } else {
+                break;
+            }
+        }
+    }
