index 0000000000..b4a3af56a3
--- /dev/null
+++ b/crates/ui/src/components/cross_fade.rs
@@ -0,0 +1,92 @@
+use std::time::Duration;
+
+use gpui::{Animation, AnimationExt, AnyElement, ElementId};
+
+use crate::prelude::*;
+
+/// Cross-fades between two elements: `to` fades in from transparent while
+/// `from` (if present) fades out, absolutely positioned on top of it.
+///
+/// Used for the agent panel's status-icon swaps (spinner → check/x) and
+/// mascot state changes. The default duration is the spec's shared
+/// cross-fade timing of 120ms.
+///
+/// When `from` is `None` the component degrades to a plain fade-in of `to`.
+///
+/// `CrossFade` is meant for non-interactive content (icons, images, and
+/// similar glyphs). Once the `from` overlay's fade-out animation reaches
+/// `delta >= 1.0`, the overlay is also marked `invisible()`, which stops it
+/// (and its descendants) from painting and therefore from registering mouse
+/// listeners, so it stops intercepting clicks/hovers meant for `to` at
+/// rest. During the fade itself (`delta < 1.0`) `from` is still painted and
+/// remains hit-testable like any other faded-but-visible element.
+///
+/// # Example
+///
+/// ```no_run
+/// use ui::prelude::*;
+/// use ui::CrossFade;
+///
+/// let spinner = div().child("spinner");
+/// let check = div().child("check");
+/// let _status_swap = CrossFade::new("status-icon", Some(spinner.into_any_element()), check);
+/// ```
+#[derive(IntoElement)]
+pub struct CrossFade {
+    id: ElementId,
+    from: Option<AnyElement>,
+    to: AnyElement,
+    duration: Duration,
+}
+
+impl CrossFade {
+    pub fn new(id: impl Into<ElementId>, from: Option<AnyElement>, to: impl IntoElement) -> Self {
+        Self {
+            id: id.into(),
+            from,
+            to: to.into_any_element(),
+            duration: Duration::from_millis(120),
+        }
+    }
+
+    pub fn duration(mut self, duration: Duration) -> Self {
+        self.duration = duration;
+        self
+    }
+}
+
+impl RenderOnce for CrossFade {
+    fn render(self, _window: &mut Window, _cx: &mut App) -> impl IntoElement {
+        let CrossFade {
+            id,
+            from,
+            to,
+            duration,
+        } = self;
+
+        div()
+            .relative()
+            .child(div().child(to).with_animation(
+                (id.clone(), "cross_fade_in"),
+                Animation::new(duration),
+                |this, delta| this.opacity(delta),
+            ))
+            .when_some(from, |container, from| {
+                container.child(div().absolute().inset_0().child(from).with_animation(
+                    (id, "cross_fade_out"),
+                    Animation::new(duration),
+                    |this, delta| {
+                        let this = this.opacity(1.0 - delta);
+                        // gpui's one-shot `Animation` clamps `delta` at 1.0 and keeps
+                        // re-invoking this closure every frame thereafter, so once the
+                        // fade finishes we mark the overlay `invisible()` to stop it (and
+                        // its descendants) from painting. That in turn stops it from
+                        // registering mouse listeners, so it can no longer intercept
+                        // input meant for `to` (opacity alone has no effect on hit
+                        // testing in gpui).
+                        if delta >= 1.0 { this.invisible() } else { this }
+                    },
+                ))
+            })
+    }
+}
