diff --git a/crates/ui/src/styles/animation.rs b/crates/ui/src/styles/animation.rs
index ea08b74ca9..5813ff28b6 100644
--- a/crates/ui/src/styles/animation.rs
+++ b/crates/ui/src/styles/animation.rs
@@ -98,6 +98,39 @@ pub trait DefaultAnimations: Styled + Sized + Element {
 
 impl<E: Styled + Element> DefaultAnimations for E {}
 
+/// Wraps an easing so the animation holds at 0 until `delay` fraction of the
+/// total duration has elapsed, then eases over the remainder.
+///
+/// `gpui::Animation` has no built-in delay support, so a delayed entrance is
+/// expressed as one longer animation whose easing is time-shifted, e.g.
+/// `Animation::new(total).with_easing(with_delay(0.4, ease_out_quint()))`.
+pub fn with_delay(delay: f32, easing: impl Fn(f32) -> f32 + 'static) -> impl Fn(f32) -> f32 {
+    let delay = delay.clamp(0.0, 1.0);
+    move |t| {
+        if t < delay {
+            0.0
+        } else if 1.0 - delay <= f32::EPSILON {
+            easing(1.0)
+        } else {
+            easing(((t - delay) / (1.0 - delay)).clamp(0.0, 1.0))
+        }
+    }
+}
+
+/// Delay fraction for the item at `index` in a staggered entrance: `index`
+/// is capped at `cap`, each step adds `step_ms`, within a total animation of
+/// `total_ms`. Returns a value in `0.0..=1.0` suitable for [`with_delay`].
+///
+/// The agent panel's tool-call cascade (spec §3.2) uses 40ms steps capped at
+/// 5 cards (200ms), so `total_ms` = stagger window + entrance duration.
+pub fn stagger_delay(index: usize, cap: usize, step_ms: u64, total_ms: u64) -> f32 {
+    if total_ms == 0 {
+        return 0.0;
+    }
+    let offset_ms = index.min(cap) as u64 * step_ms;
+    (offset_ms.min(total_ms) as f32) / (total_ms as f32)
+}
+
 // Don't use this directly, it only exists to show animation previews
 #[derive(RegisterComponent)]
 struct Animation {}
@@ -273,3 +306,57 @@ impl Component for Animation {
             .into_any_element()
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_with_delay_holds_then_eases_over_remainder() {
+        let eased = with_delay(0.5, |t| t);
+        assert_eq!(eased(0.0), 0.0);
+        assert_eq!(eased(0.25), 0.0);
+        assert_eq!(eased(0.5), 0.0);
+        assert_eq!(eased(0.75), 0.5);
+        assert_eq!(eased(1.0), 1.0);
+    }
+
+    #[test]
+    fn test_with_delay_zero_is_passthrough() {
+        let eased = with_delay(0.0, |t| t * t);
+        assert_eq!(eased(0.5), 0.25);
+        assert_eq!(eased(1.0), 1.0);
+    }
+
+    #[test]
+    fn test_with_delay_full_delay_saturates_at_end() {
+        let eased = with_delay(1.0, |t| t);
+        assert_eq!(eased(0.0), 0.0);
+        assert_eq!(eased(0.999), 0.0);
+        assert_eq!(eased(1.0), 1.0);
+    }
+
+    #[test]
+    fn test_stagger_delay_first_item_has_no_delay() {
+        assert_eq!(stagger_delay(0, 5, 40, 350), 0.0);
+    }
+
+    #[test]
+    fn test_stagger_delay_steps_are_fractions_of_total() {
+        let delay = stagger_delay(2, 5, 40, 350);
+        assert!((delay - 80.0 / 350.0).abs() < 1e-6);
+    }
+
+    #[test]
+    fn test_stagger_delay_caps_index() {
+        assert_eq!(stagger_delay(50, 5, 40, 350), stagger_delay(5, 5, 40, 350));
+        let capped = stagger_delay(5, 5, 40, 350);
+        assert!((capped - 200.0 / 350.0).abs() < 1e-6);
+    }
+
+    #[test]
+    fn test_stagger_delay_clamps_to_one_and_handles_zero_total() {
+        assert_eq!(stagger_delay(10, 10, 100, 200), 1.0);
+        assert_eq!(stagger_delay(3, 5, 40, 0), 0.0);
+    }
+}
