+    #[gpui::test]
+    async fn context_menu_deploys_for_connection_database_and_relation_only(
+        cx: &mut TestAppContext,
+    ) {
+        init_test(cx);
+        let profile = ConnectionProfile {
+            id: "p1".into(),
+            name: "Test".into(),
+            host: "127.0.0.1".into(),
+            port: 1,
+            database: "db".into(),
+            user: "u".into(),
+            ssl_mode: SslMode::Disable,
