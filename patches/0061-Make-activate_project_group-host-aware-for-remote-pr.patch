@@ -66,6 +67,26 @@ pub struct SidebarRenderState {
     pub side: SidebarSide,
 }
 
+/// Establishes a remote connection for a project group whose host is
+/// `Some(..)`, returning a [`Task`] that resolves to the connected
+/// [`remote::RemoteClient`] session (or `None` if the connection was
+/// cancelled).
+///
+/// The `workspace` crate cannot depend on `remote_connection` (that would
+/// create a dependency cycle), so the actual connector — which shows the
+/// connection modal — is injected by the application layer via
+/// [`MultiWorkspace::set_remote_connector`]. This mirrors the closure the
+/// sidebar passes to [`MultiWorkspace::find_or_create_workspace`].
+pub type RemoteConnector = Arc<
+    dyn Fn(
+            Entity<Workspace>,
+            RemoteConnectionOptions,
+            &mut Window,
+            &mut App,
+        ) -> Task<Result<Option<Entity<remote::RemoteClient>>>>
+        + 'static,
+>;
+
 pub fn sidebar_side_context_menu(
     id: impl Into<ElementId>,
     cx: &App,
@@ -298,6 +319,7 @@ pub struct MultiWorkspace {
     _serialize_task: Option<Task<()>>,
     _subscriptions: Vec<Subscription>,
     previous_focus_handle: Option<FocusHandle>,
+    remote_connector: Option<RemoteConnector>,
 }
 
 impl EventEmitter<MultiWorkspaceEvent> for MultiWorkspace {}
@@ -358,9 +380,17 @@ impl MultiWorkspace {
                 settings_subscription,
             ],
             previous_focus_handle: None,
+            remote_connector: None,
         }
     }
 
+    /// Injects the connector used to (re)establish remote connections for
+    /// project groups with a host. Called once by the application layer,
+    /// which has access to the connection modal UI in `remote_connection`.
+    pub fn set_remote_connector(&mut self, connector: RemoteConnector) {
+        self.remote_connector = Some(connector);
+    }
+
     pub fn register_sidebar<T: Sidebar>(&mut self, sidebar: Entity<T>, cx: &mut Context<Self>) {
         self._subscriptions
             .push(cx.observe(&sidebar, |_this, _, cx| {
@@ -817,9 +847,39 @@ impl MultiWorkspace {
             self.activate(workspace, None, window, cx);
             return;
         }
-        self.find_or_create_local_workspace(
+
+        let host = key.host();
+        let Some(host) = host else {
+            // Local group: open from disk exactly as before.
+            self.find_or_create_local_workspace(
+                key.path_list().clone(),
+                Some(key.clone()),
+                &[],
+                None,
+                OpenMode::Activate,
+                window,
+                cx,
+            )
+            .detach_and_log_err(cx);
+            return;
+        };
+
+        // Remote group: reconnect to the host instead of opening the remote
+        // paths as a bogus local workspace. This mirrors the sidebar's
+        // `open_workspace_for_group`, routing through the host-aware
+        // `find_or_create_workspace` with the application-injected connector.
+        let Some(connector) = self.remote_connector.clone() else {
+            log::error!(
+                "cannot activate remote project group: no remote connector registered"
+            );
+            return;
+        };
+        let modal_workspace = self.workspace().clone();
+        self.find_or_create_workspace(
             key.path_list().clone(),
+            Some(host),
             Some(key.clone()),
+            move |options, window, cx| connector(modal_workspace, options, window, cx),
             &[],
             None,
             OpenMode::Activate,
