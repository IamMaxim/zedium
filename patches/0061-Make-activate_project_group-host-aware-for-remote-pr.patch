index 9a62fe9eb4..e9a6efac61 100644
--- a/crates/workspace/src/multi_workspace.rs
+++ b/crates/workspace/src/multi_workspace.rs
@@ -14,6 +14,7 @@ pub use settings::SidebarSide;
 use std::future::Future;
 
