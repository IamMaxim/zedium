+#[gpui::test]
+async fn test_activate_remote_project_group_does_not_open_local(cx: &mut TestAppContext) {
+    use remote::{RemoteConnectionOptions, SshConnectionOptions};
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    init_test(cx);
+    let fs = FakeFs::new(cx.executor());
+    fs.insert_tree(path!("/local"), json!({ "x.txt": "" })).await;
+
+    let project = Project::test(fs.clone(), [path!("/local").as_ref()], cx).await;
+    let (mw, cx) = cx.add_window_view(|window, cx| MultiWorkspace::test_new(project, window, cx));
+    cx.run_until_parked();
+
+    // A remote group whose paths are NOT loaded as a workspace. Before this
+    // fix, `activate_project_group` fell back to opening these remote paths
+    // as a local workspace; it must instead route through the host-aware
+    // connector.
+    let host = RemoteConnectionOptions::Ssh(SshConnectionOptions {
+        host: "example.com".into(),
+        ..Default::default()
+    });
+    let remote_key =
+        ProjectGroupKey::new(Some(host), PathList::new(&[path!("/remote/project")]));
+
+    let connector_called = Rc::new(Cell::new(false));
+    mw.update(cx, |mw, _cx| {
+        let connector_called = connector_called.clone();
+        mw.set_remote_connector(std::sync::Arc::new(move |_workspace, _options, _window, _cx| {
+            connector_called.set(true);
+            // Simulate a cancelled connection so no workspace is created.
+            gpui::Task::ready(Ok(None))
+        }));
+    });
+
+    let workspaces_before = mw.read_with(cx, |mw, _cx| mw.workspaces().count());
+
+    mw.update_in(cx, |mw, window, cx| {
+        mw.activate_project_group(&remote_key, window, cx);
+    });
+    cx.run_until_parked();
+
+    assert!(
+        connector_called.get(),
+        "activating a remote project group must route through the host-aware connector"
+    );
+
+    mw.read_with(cx, |mw, cx| {
+        assert_eq!(
+            mw.workspaces().count(),
+            workspaces_before,
+            "activating a remote group with a cancelled connection must not create a workspace"
+        );
+        assert!(
+            mw.workspace_for_paths(remote_key.path_list(), remote_key.host().as_ref(), cx)
+                .is_none(),
+            "no local workspace should have been opened for the remote paths"
+        );
+    });
+}
