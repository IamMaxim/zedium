         let welcome_label = if self.fallback_to_recent_projects {
             "Welcome back to Zed"
         } else {
-            "Welcome to Zed"
+            "Welcome to Zedium"
         };
 
         h_flex()
diff --git a/crates/zed/src/zed/app_menus.rs b/crates/zed/src/zed/app_menus.rs
