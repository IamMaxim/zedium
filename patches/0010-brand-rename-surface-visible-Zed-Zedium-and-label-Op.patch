From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IamMaxim <g.maxim.stepanoff@gmail.com>
Date: Thu, 28 May 2026 22:47:30 +0300
Subject: [PATCH] brand: rename surface-visible Zed -> Zedium and label
 OpenAI-compatible as Zedium AI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

User-visible touchpoints flip to the fork's name:
 - macOS app menu top-level becomes 'Zedium', About menu item becomes
   'About Zedium'.
 - ReleaseChannel::display_name yields 'Zedium' / 'Zedium Dev' / etc.
   (used in About window, status strings, log messages).
 - Welcome page + Onboarding headline say 'Welcome to Zedium'.
 - EditPredictionProvider::OpenAiCompatibleApi.display_name() is now
   'Zedium AI (OpenAI-compatible)' so the user-configurable
   OpenAI-compatible provider is presented as the Zedium AI provider
   (this is the generic provider that supersedes Anthropic / OpenAI /
   Gemini / etc. — no new crate is needed; the existing
   open_ai_compatible provider already supports user-configured
   endpoints).

Internal namespaces (zed::, zed_actions, settings keys, file paths)
intentionally stay as 'zed' to avoid a settings/keymap migration.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 crates/onboarding/src/onboarding.rs     | 2 +-
 crates/release_channel/src/lib.rs       | 8 ++++----
 crates/settings_content/src/language.rs | 2 +-
 crates/workspace/src/welcome.rs         | 2 +-
 crates/zed/src/zed/app_menus.rs         | 4 ++--
 5 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/crates/onboarding/src/onboarding.rs b/crates/onboarding/src/onboarding.rs
index ad3e6eb6b0..ed608451eb 100644
--- a/crates/onboarding/src/onboarding.rs
+++ b/crates/onboarding/src/onboarding.rs
@@ -343,7 +343,7 @@ impl Render for Onboarding {
                                             .child(
                                                 v_flex()
                                                     .child(
-                                                        Headline::new("Welcome to Zed")
+                                                        Headline::new("Welcome to Zedium")
                                                             .size(HeadlineSize::Small),
                                                     )
                                                     .child(
diff --git a/crates/release_channel/src/lib.rs b/crates/release_channel/src/lib.rs
index ca3aff66e1..493c02ef61 100644
--- a/crates/release_channel/src/lib.rs
+++ b/crates/release_channel/src/lib.rs
@@ -191,10 +191,10 @@ impl ReleaseChannel {
     /// Returns the display name for this [`ReleaseChannel`].
     pub fn display_name(&self) -> &'static str {
         match self {
-            ReleaseChannel::Dev => "Zed Dev",
-            ReleaseChannel::Nightly => "Zed Nightly",
-            ReleaseChannel::Preview => "Zed Preview",
-            ReleaseChannel::Stable => "Zed",
+            ReleaseChannel::Dev => "Zedium Dev",
+            ReleaseChannel::Nightly => "Zedium Nightly",
+            ReleaseChannel::Preview => "Zedium Preview",
+            ReleaseChannel::Stable => "Zedium",
         }
     }
 
diff --git a/crates/settings_content/src/language.rs b/crates/settings_content/src/language.rs
index 75a6288756..fb20375a0d 100644
--- a/crates/settings_content/src/language.rs
+++ b/crates/settings_content/src/language.rs
@@ -108,7 +108,7 @@ impl EditPredictionProvider {
             EditPredictionProvider::Mercury => Some("Mercury"),
             EditPredictionProvider::None => None,
             EditPredictionProvider::Ollama => Some("Ollama"),
-            EditPredictionProvider::OpenAiCompatibleApi => Some("OpenAI-Compatible API"),
+            EditPredictionProvider::OpenAiCompatibleApi => Some("Zedium AI (OpenAI-compatible)"),
         }
     }
 }
diff --git a/crates/workspace/src/welcome.rs b/crates/workspace/src/welcome.rs
index 1bf0e81f1b..bc937190f9 100644
--- a/crates/workspace/src/welcome.rs
