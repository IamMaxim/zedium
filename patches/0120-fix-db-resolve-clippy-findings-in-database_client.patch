From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 23:46:20 +0300
Subject: [PATCH] fix(db): resolve clippy findings in database_client

Drop redundant to_string() clones on Editor::text() results in the
connection modal, simplify a match to unwrap_or_default() in query view
restore, and elide a needless test-helper lifetime.
---
 crates/database_client/src/connection_modal.rs | 12 ++++++------
 crates/database_client/src/panel.rs            |  6 +++---
 crates/database_client/src/query_view.rs       |  5 +----
 3 files changed, 10 insertions(+), 13 deletions(-)

diff --git a/crates/database_client/src/connection_modal.rs b/crates/database_client/src/connection_modal.rs
index 4bd6691c1b..dc4db3d569 100644
--- a/crates/database_client/src/connection_modal.rs
+++ b/crates/database_client/src/connection_modal.rs
@@ -133,12 +133,12 @@ impl ConnectionModal {
     }
 
     fn confirm(&mut self, _: &Confirm, _window: &mut Window, cx: &mut Context<Self>) {
-        let name = self.name_input.read(cx).text(cx).to_string();
-        let host = self.host_input.read(cx).text(cx).to_string();
-        let port_str = self.port_input.read(cx).text(cx).to_string();
-        let database = self.database_input.read(cx).text(cx).to_string();
-        let user = self.user_input.read(cx).text(cx).to_string();
-        let password = self.password_input.read(cx).text(cx).to_string();
+        let name = self.name_input.read(cx).text(cx);
+        let host = self.host_input.read(cx).text(cx);
+        let port_str = self.port_input.read(cx).text(cx);
+        let database = self.database_input.read(cx).text(cx);
+        let user = self.user_input.read(cx).text(cx);
+        let password = self.password_input.read(cx).text(cx);
 
         let port = port_str.parse::<u16>().unwrap_or(5432);
 
diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
index f233959269..0b532713c5 100644
--- a/crates/database_client/src/panel.rs
+++ b/crates/database_client/src/panel.rs
@@ -716,10 +716,10 @@ mod tests {
     }
 
     /// Build a panel backed by a single injected profile, bypassing on-disk profile loading.
-    async fn panel_with_profile<'a>(
+    async fn panel_with_profile(
         profile: ConnectionProfile,
-        cx: &'a mut TestAppContext,
-    ) -> (Entity<DatabasePanel>, &'a mut gpui::VisualTestContext) {
+        cx: &mut TestAppContext,
+    ) -> (Entity<DatabasePanel>, &mut gpui::VisualTestContext) {
         let fs = fs::FakeFs::new(cx.executor());
         let project = project::Project::test(fs, [], cx).await;
         let (workspace, cx) =
diff --git a/crates/database_client/src/query_view.rs b/crates/database_client/src/query_view.rs
index bc4d8500d7..5ca04f0a10 100644
--- a/crates/database_client/src/query_view.rs
+++ b/crates/database_client/src/query_view.rs
@@ -350,10 +350,7 @@ impl SerializableItem for QueryView {
         let db = QueryDb::global(cx);
         let loaded = db.get_query(item_id, workspace_id).log_err().flatten();
         window.spawn(cx, async move |cx| {
-            let (profile_id, sql) = match loaded {
-                Some(row) => row,
-                None => (String::new(), String::new()),
-            };
+            let (profile_id, sql) = loaded.unwrap_or_default();
             let profile = store::load_profiles()
                 .into_iter()
                 .find(|p| p.id == profile_id);
