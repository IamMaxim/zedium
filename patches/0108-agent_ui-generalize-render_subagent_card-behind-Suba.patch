+    /// Build a plain-data `SubagentSnapshot` from whatever backs the card.
+    ///
+    /// `source == None` is the native case where the subagent's child session
+    /// hasn't been loaded yet; it produces the same values the pre-refactor code
+    /// computed when `thread_view` was `None` (no thread title, no changed files).
+    fn subagent_snapshot(
+        &self,
+        source: Option<&SubagentSource>,
+        tool_call: &ToolCall,
+        cx: &App,
+    ) -> SubagentSnapshot {
+        let is_running = matches!(
+            tool_call.status,
+            ToolCallStatus::Pending
+                | ToolCallStatus::InProgress
+                | ToolCallStatus::WaitingForConfirmation { .. }
+        );
+        let is_failed = matches!(
+            tool_call.status,
+            ToolCallStatus::Failed | ToolCallStatus::Rejected
+        );
+        let error_message = self.subagent_error_message(&tool_call.status, tool_call, cx);
+
+        match source {
+            Some(SubagentSource::ChildThread(thread_view)) => {
+                let thread = thread_view.read(cx).thread.clone();
+                let action_log = thread.read(cx).action_log();
+                let changed_buffers = action_log.read(cx).changed_buffers(cx).collect::<Vec<_>>();
+                let files_changed = changed_buffers.len();
+                let diff_stats = DiffStats::all_files(changed_buffers, cx);
+
+                let is_cancelled = matches!(tool_call.status, ToolCallStatus::Canceled)
+                    || tool_call.content.iter().any(|c| match c {
+                        ToolCallContent::ContentBlock(ContentBlock::Markdown { markdown }) => {
+                            markdown.read(cx).source() == "User canceled"
+                        }
+                        _ => false,
+                    });
+
+                let thread_title = thread
+                    .read(cx)
+                    .title()
+                    .filter(|t| !t.is_empty());
+                let tool_call_label = tool_call.label.read(cx).source().to_string();
+                let has_title = thread_title.is_some() || !tool_call_label.is_empty();
+
+                let title: SharedString = if let Some(thread_title) = thread_title {
+                    thread_title
+                } else if !tool_call_label.is_empty() {
+                    tool_call_label.into()
+                } else if is_cancelled {
+                    "Subagent Canceled".into()
+                } else if is_failed {
+                    "Subagent Failed".into()
+                } else {
+                    "Spawning Agent…".into()
+                };
+
+                SubagentSnapshot {
+                    title,
+                    has_title,
+                    is_running,
+                    is_failed,
+                    is_cancelled,
+                    files_changed,
+                    diff_stats,
+                    error_message,
+                }
+            }
+            Some(SubagentSource::SameThread { root }) => {
+                let label = self
+                    .thread
+                    .read(cx)
+                    .subagent_index()
+                    .root_label(root)
+                    .unwrap_or_else(|| "Subagent".into());
+
+                let is_cancelled = matches!(tool_call.status, ToolCallStatus::Canceled);
+
+                let title: SharedString = if is_cancelled {
+                    "Subagent Canceled".into()
+                } else if is_failed {
+                    "Subagent Failed".into()
+                } else {
+                    format!("{label} subagent").into()
+                };
+
+                SubagentSnapshot {
+                    title,
+                    has_title: true,
+                    is_running,
+                    is_failed,
+                    is_cancelled,
+                    files_changed: 0,
+                    diff_stats: DiffStats::default(),
+                    error_message,
+                }
+            }
+            None => {
+                let is_cancelled = matches!(tool_call.status, ToolCallStatus::Canceled)
+                    || tool_call.content.iter().any(|c| match c {
+                        ToolCallContent::ContentBlock(ContentBlock::Markdown { markdown }) => {
+                            markdown.read(cx).source() == "User canceled"
+                        }
+                        _ => false,
+                    });
+
+                let tool_call_label = tool_call.label.read(cx).source().to_string();
+                let has_title = !tool_call_label.is_empty();
+
+                let title: SharedString = if !tool_call_label.is_empty() {
+                    tool_call_label.into()
+                } else if is_cancelled {
+                    "Subagent Canceled".into()
+                } else if is_failed {
+                    "Subagent Failed".into()
+                } else {
+                    "Spawning Agent…".into()
+                };
+
+                SubagentSnapshot {
+                    title,
+                    has_title,
+                    is_running,
+                    is_failed,
+                    is_cancelled,
+                    files_changed: 0,
+                    diff_stats: DiffStats::default(),
+                    error_message,
+                }
+            }
+        }
+    }
