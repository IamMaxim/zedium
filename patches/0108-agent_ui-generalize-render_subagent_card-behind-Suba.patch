+        // `scroll_key` is the per-subagent scroll-handle map key; `element_seed`
+        // is the stable string baked into the entries container's element id. For
+        // native (`ChildThread`) both come straight from the child session, exactly
+        // as before this refactor; same-thread (qwen) subagents have no separate
+        // session, so they're derived from the subagent's root tool-call id.
+        let (rendered_entries, scroll_key, element_seed): (
