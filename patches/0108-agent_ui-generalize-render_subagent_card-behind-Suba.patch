+/// What a subagent card/pop-out is backed by. Native subagents are a
+/// separately-loaded child session (a real `Entity<ThreadView>`); same-thread
+/// providers (qwen) have no separate session — their subtree is a filtered
+/// view over entries already in `self.thread`.
+enum SubagentSource {
+    ChildThread(Entity<ThreadView>),
+    SameThread { root: acp::ToolCallId },
+}
+
+/// Plain-data view of a subagent's current state, read from whichever
+/// `SubagentSource` backs it. Card/titlebar rendering reads only this struct,
+/// never `SubagentSource` or its variants directly — that's what keeps the
+/// two providers' rendering pixel-identical.
+struct SubagentSnapshot {
+    title: SharedString,
+    /// Whether the card has a "real" title (thread title or tool-call label) as
+    /// opposed to a placeholder/status string. Drives the dashed-border and
+    /// header-background styling, preserved exactly from the pre-refactor
+    /// `has_no_title_or_canceled` computation.
+    has_title: bool,
+    is_running: bool,
+    is_failed: bool,
+    is_cancelled: bool,
+    files_changed: usize,
+    diff_stats: DiffStats,
+    error_message: Option<SharedString>,
+}
+
