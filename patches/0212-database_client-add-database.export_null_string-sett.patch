From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Sat, 4 Jul 2026 20:51:53 +0300
Subject: [PATCH] database_client: add database.export_null_string setting

---
 assets/settings/default.json                  |  5 +++-
 crates/database_client/src/export.rs          |  7 ++++--
 crates/database_client/src/settings.rs        | 23 +++++++++++++++++++
 .../settings_content/src/settings_content.rs  |  4 ++++
 4 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/assets/settings/default.json b/assets/settings/default.json
index 1232e57802..00eecdac07 100644
--- a/assets/settings/default.json
+++ b/assets/settings/default.json
@@ -2720,7 +2720,10 @@
     },
     // Enables the one-time schema metadata sweep that powers SQL
     // autocomplete in query editors.
-    "metadata_cache": true
+    "metadata_cache": true,
+    // String written for SQL NULL values in CSV export. Defaults to the
+    // empty string when null.
+    "export_null_string": ""
   },
   "debugger": {
     "stepping_granularity": "line",
diff --git a/crates/database_client/src/export.rs b/crates/database_client/src/export.rs
index 11ee14ee16..9006405a79 100644
--- a/crates/database_client/src/export.rs
+++ b/crates/database_client/src/export.rs
@@ -3,9 +3,11 @@
 
 use crate::connection::client::Connection;
 use crate::connection::introspect::quote_literal;
+use crate::settings::DatabaseClientSettings;
 use crate::sql_paging::{quote_ident, wrap};
 use anyhow::Result;
 use gpui::{App, Task};
+use settings::Settings as _;
 
 #[allow(dead_code)]
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
@@ -130,8 +132,9 @@ impl Connection {
         cx: &App,
     ) -> Task<Result<String>> {
         let connection = self.clone();
-        // export_null_string setting is wired in Plan 10; default empty for now.
-        let null_string = String::new();
+        let null_string = DatabaseClientSettings::get_global(cx)
+            .export_null_string
+            .clone();
         cx.spawn(async move |cx| {
             let base = format!(
                 "select * from {}.{}",
diff --git a/crates/database_client/src/settings.rs b/crates/database_client/src/settings.rs
index df6bf6b6ca..53b53390a4 100644
--- a/crates/database_client/src/settings.rs
+++ b/crates/database_client/src/settings.rs
@@ -62,6 +62,8 @@ pub struct DatabaseClientSettings {
     pub toolbar: DatabaseToolbarSettings,
     /// Whether to populate the autocomplete metadata cache on connection.
     pub metadata_cache: bool,
+    /// CSV representation of SQL NULL on export; default is the empty string.
+    pub export_null_string: String,
 }
 
 impl Settings for DatabaseClientSettings {
@@ -102,6 +104,9 @@ impl Settings for DatabaseClientSettings {
             metadata_cache: database
                 .and_then(|database| database.metadata_cache)
                 .unwrap_or(true),
+            export_null_string: database
+                .and_then(|database| database.export_null_string.clone())
+                .unwrap_or_default(),
         }
     }
 }
@@ -165,6 +170,24 @@ mod tests {
         assert_eq!(settings.sidebar, DatabaseSidebarSettings::default());
         assert_eq!(settings.toolbar, DatabaseToolbarSettings::default());
         assert!(settings.metadata_cache);
+        assert_eq!(settings.export_null_string, "");
+    }
+
+    #[gpui::test]
+    fn export_null_string_defaults_empty_and_passes_through(cx: &mut App) {
+        init_settings(cx);
+        assert_eq!(
+            DatabaseClientSettings::get_global(cx).export_null_string,
+            ""
+        );
+
+        set_database_settings(cx, |database| {
+            database.export_null_string = Some("\\N".to_string());
+        });
+        assert_eq!(
+            DatabaseClientSettings::get_global(cx).export_null_string,
+            "\\N"
+        );
     }
 
     #[gpui::test]
diff --git a/crates/settings_content/src/settings_content.rs b/crates/settings_content/src/settings_content.rs
index cbde567dca..951ae46db6 100644
--- a/crates/settings_content/src/settings_content.rs
+++ b/crates/settings_content/src/settings_content.rs
@@ -1272,6 +1272,10 @@ pub struct DatabaseSettingsContent {
     ///
     /// Default: true
     pub metadata_cache: Option<bool>,
+    /// String written for SQL `NULL` values in CSV export.
+    ///
+    /// If this option is not included, NULLs export as an empty field.
+    pub export_null_string: Option<String>,
 }
 
 /// Density settings for the database client sidebar tree.
