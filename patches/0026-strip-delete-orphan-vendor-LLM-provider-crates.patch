-                AnthropicModelMode::Default => None,
-            }
-        } else {
-            None
-        },
-        tools,
-        tool_choice: request.tool_choice.map(|choice| match choice {
-            LanguageModelToolChoice::Auto => ToolChoice::Auto,
-            LanguageModelToolChoice::Any => ToolChoice::Any,
