+/// Settings for the database client's query results grid and pagination.
+#[with_fallible_options]
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize, JsonSchema, MergeFrom)]
+pub struct DatabaseSettingsContent {
+    /// Sets the font family for the query results grid.
+    ///
+    /// If this option is not included, the results grid will default to
+    /// matching the buffer's font family.
+    pub results_font_family: Option<FontFamilyName>,
+    /// Sets the font size for the query results grid.
+    ///
+    /// If this option is not included, the results grid will default to
+    /// matching the buffer's font size.
+    pub results_font_size: Option<FontSize>,
+    /// Number of rows fetched per page of query results.
+    /// Values below 50 are clamped to 50.
+    ///
+    /// Default: 500
+    pub page_size: Option<usize>,
+}
+
