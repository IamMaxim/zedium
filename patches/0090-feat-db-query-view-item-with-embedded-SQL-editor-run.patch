index 0000000000..fb1018e62f
--- /dev/null
+++ b/crates/database_client/src/query_view.rs
@@ -0,0 +1,275 @@
+use std::time::Instant;
+
+use editor::{Editor, EditorElement, EditorStyle};
+use gpui::{
+    App, Context, Entity, EventEmitter, FocusHandle, Focusable, IntoElement, KeyBinding,
+    ParentElement, Render, SharedString, Styled, TextStyle, WeakEntity, Window, actions, div,
+    relative,
+};
+use language::Buffer;
+use settings::Settings as _;
+use theme::ActiveTheme;
+use theme_settings::ThemeSettings;
+use ui::prelude::*;
+use workspace::{
+    Workspace, WorkspaceId,
+    item::{Item, ItemEvent, TabContentParams},
+};
+
+use crate::{
+    DEFAULT_RESULT_LIMIT,
+    connection::{
+        client::{Connection, QueryResult},
+        profile::ConnectionProfile,
+    },
+};
+
+actions!(database_client, [RunQuery]);
+
+pub(crate) fn register_keybindings(cx: &mut App) {
+    cx.bind_keys([
+        KeyBinding::new("cmd-enter", RunQuery, Some("QueryView")),
+        KeyBinding::new("ctrl-enter", RunQuery, Some("QueryView")),
+    ]);
+}
+
+pub enum QueryViewEvent {
+    Edit,
+    ResultsChanged,
+}
+
+pub struct QueryView {
+    editor: Entity<Editor>,
+    connection: Option<Connection>,
+    profile: Option<ConnectionProfile>,
+    result: Option<QueryResult>,
+    error: Option<String>,
+    elapsed_ms: Option<u128>,
+    #[allow(dead_code)]
+    workspace: WeakEntity<Workspace>,
+    #[allow(dead_code)]
+    workspace_id: Option<WorkspaceId>,
+}
+
+impl QueryView {
+    pub fn new(
+        profile: Option<ConnectionProfile>,
+        connection: Option<Connection>,
+        initial_sql: String,
+        workspace: WeakEntity<Workspace>,
+        workspace_id: Option<WorkspaceId>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Self {
+        let buffer = cx.new(|cx| Buffer::local(initial_sql, cx));
+        let editor = cx.new(|cx| Editor::for_buffer(buffer.clone(), None, window, cx));
+
+        let language_future = workspace
+            .read_with(cx, |ws, cx| {
+                ws.project().read(cx).languages().language_for_name("SQL")
+            })
+            .ok();
+        if let Some(language_future) = language_future {
+            cx.spawn(async move |_this, cx| {
+                let language = language_future.await.ok();
+                buffer.update(cx, |buf, cx| {
+                    buf.set_language(language, cx);
+                });
+            })
+            .detach();
+        }
+
+        QueryView {
+            editor,
+            connection,
+            profile,
+            result: None,
+            error: None,
+            elapsed_ms: None,
+            workspace,
+            workspace_id,
+        }
+    }
+
+    pub fn open(
+        workspace: &mut Workspace,
+        profile: Option<ConnectionProfile>,
+        connection: Option<Connection>,
+        initial_sql: String,
+        window: &mut Window,
+        cx: &mut Context<Workspace>,
+    ) {
+        let weak = cx.entity().downgrade();
+        let workspace_id = workspace.database_id();
+        let view = cx.new(|cx| {
+            QueryView::new(profile, connection, initial_sql, weak, workspace_id, window, cx)
+        });
+        workspace.add_item_to_active_pane(Box::new(view), None, true, window, cx);
+    }
+
+    fn run(&mut self, _: &RunQuery, _window: &mut Window, cx: &mut Context<Self>) {
+        let sql = self.editor.read(cx).text(cx);
+        let Some(connection) = self.connection.clone() else {
+            self.error = Some("No active connection".into());
+            cx.notify();
+            return;
+        };
+        let start = Instant::now();
+        let task = connection.execute(sql, DEFAULT_RESULT_LIMIT, cx);
+        cx.spawn(async move |this, cx| {
+            let outcome = task.await;
+            let elapsed = start.elapsed().as_millis();
+            this.update(cx, |this, cx| match outcome {
+                Ok(result) => {
+                    this.result = Some(result);
+                    this.error = None;
+                    this.elapsed_ms = Some(elapsed);
+                    cx.emit(QueryViewEvent::ResultsChanged);
+                    cx.notify();
+                }
+                Err(err) => {
+                    this.error = Some(err.to_string());
+                    this.result = None;
+                    this.elapsed_ms = Some(elapsed);
+                    cx.emit(QueryViewEvent::ResultsChanged);
+                    cx.notify();
+                }
+            })
+            .ok();
+        })
+        .detach();
+    }
+
+    fn editor_style(cx: &App) -> EditorStyle {
+        let settings = ThemeSettings::get_global(cx);
+        let theme = cx.theme();
+        let text_style = TextStyle {
+            color: theme.colors().text,
+            font_family: settings.buffer_font.family.clone(),
+            font_features: settings.buffer_font.features.clone(),
+            font_size: settings.buffer_font_size(cx).into(),
+            font_weight: settings.buffer_font.weight,
+            line_height: relative(settings.buffer_line_height.value()),
+            ..Default::default()
+        };
+        EditorStyle {
+            background: theme.colors().editor_background,
+            local_player: theme.players().local(),
+            text: text_style,
+            syntax: theme.syntax().clone(),
+            ..Default::default()
+        }
+    }
+}
+
+impl Focusable for QueryView {
+    fn focus_handle(&self, cx: &App) -> FocusHandle {
+        self.editor.read(cx).focus_handle(cx)
+    }
+}
+
+impl EventEmitter<QueryViewEvent> for QueryView {}
+
+impl Item for QueryView {
+    type Event = QueryViewEvent;
+
+    fn tab_content_text(&self, _detail: usize, _cx: &App) -> SharedString {
+        self.profile
+            .as_ref()
+            .map(|p| SharedString::from(p.name.clone()))
+            .unwrap_or_else(|| "Query".into())
+    }
+
+    fn tab_content(
+        &self,
+        params: TabContentParams,
+        _window: &Window,
+        cx: &App,
+    ) -> gpui::AnyElement {
+        Label::new(self.tab_content_text(params.detail.unwrap_or_default(), cx))
+            .color(params.text_color())
+            .into_any_element()
+    }
+
+    fn to_item_events(event: &QueryViewEvent, f: &mut dyn FnMut(ItemEvent)) {
+        match event {
+            QueryViewEvent::Edit => f(ItemEvent::Edit),
+            QueryViewEvent::ResultsChanged => f(ItemEvent::UpdateTab),
+        }
+    }
+}
+
+impl Render for QueryView {
+    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+        let editor_style = Self::editor_style(cx);
+
+        let status_line = if let Some(error) = &self.error {
+            let error = error.clone();
+            Some(
+                h_flex()
+                    .px_2()
+                    .py_1()
+                    .gap_1()
+                    .child(
+                        Label::new(format!("Error: {error}"))
+                            .size(LabelSize::Small)
+                            .color(Color::Error),
+                    )
+                    .into_any_element(),
+            )
+        } else if let Some(result) = &self.result {
+            let row_count = result.rows.len();
+            let truncated = result.truncated;
+            let elapsed = self.elapsed_ms.unwrap_or(0);
+            let tag = result
+                .command_tag
+                .clone()
+                .unwrap_or_else(|| format!("{row_count} row(s)"));
+            let truncation_note = if truncated {
+                format!(" (truncated to {DEFAULT_RESULT_LIMIT})")
+            } else {
+                String::new()
+            };
+            Some(
+                h_flex()
+                    .px_2()
+                    .py_1()
+                    .child(
+                        Label::new(format!("{tag}{truncation_note} — {elapsed}ms"))
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                    )
+                    .into_any_element(),
+            )
+        } else {
+            None
+        };
+
+        div()
+            .key_context("QueryView")
+            .track_focus(&self.focus_handle(cx))
+            .on_action(cx.listener(Self::run))
+            .size_full()
+            .flex()
+            .flex_col()
+            .child(
+                div()
+                    .flex_none()
+                    .h(gpui::px(200.0))
+                    .child(EditorElement::new(&self.editor, editor_style)),
+            )
+            .when_some(status_line, |this, line| this.child(line))
+            .child(
+                div()
+                    .flex_1()
+                    .w_full()
+                    .px_2()
+                    .py_1()
+                    .child(
+                        Label::new("Results will appear here (Task 10).")
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                    ),
+            )
+    }
+}
