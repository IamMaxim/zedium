-    ));
-
-    let markdown = workspace
-        .app_state()
-        .languages
-        .language_for_name("Markdown");
-
-    cx.spawn_in(window, async move |workspace, cx| {
-        let markdown = markdown.await.log_err();
-        let response = client.get(&url, Default::default(), true).await;
