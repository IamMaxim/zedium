-                    workspace.add_item_to_active_pane(
-                        Box::new(markdown_preview),
-                        None,
-                        true,
-                        window,
-                        cx,
-                    );
-                    cx.notify();
-                })
-                .ok()
-        })
-        .await;
-        if res.is_none() {
-            workspace
-                .update_in(cx, notify_release_notes_failed_to_show)
-                .log_err();
-        }
-    })
-    .detach();
-}
