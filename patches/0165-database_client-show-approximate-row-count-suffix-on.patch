From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Sat, 4 Jul 2026 16:33:45 +0300
Subject: [PATCH] database_client: show approximate row-count suffix on table
 nodes

---
 crates/database_client/src/panel.rs | 21 +++++++++++++++
 crates/database_client/src/tree.rs  | 42 +++++++++++++++++++++++++----
 2 files changed, 58 insertions(+), 5 deletions(-)

diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
index 8c305ca76d..bd1293e55e 100644
--- a/crates/database_client/src/panel.rs
+++ b/crates/database_client/src/panel.rs
@@ -638,6 +638,17 @@ impl DatabasePanel {
                 cx.notify();
             })
             .ok();
+
+            let count_result = cx
+                .update(|cx| conn.approx_row_count(schema_name.clone(), table_name.clone(), cx))
+                .await;
+            this.update(cx, |this, cx| {
+                if let Ok(count) = count_result {
+                    this.tree.set_row_count(&rel_id, count);
+                }
+                cx.notify();
+            })
+            .ok();
         })
         .detach();
     }
@@ -1039,6 +1050,16 @@ impl DatabasePanel {
                     .truncate()
                     .when(is_loading || is_empty, |label| label.color(Color::Muted)),
             )
+            .when_some(
+                node.row_count.and_then(crate::tree::row_count_suffix),
+                |this, suffix| {
+                    this.child(
+                        Label::new(suffix)
+                            .size(LabelSize::Small)
+                            .color(Color::Muted),
+                    )
+                },
+            )
             .when_some(error, |this, err_text| {
                 this.child(
                     Label::new(format!("— {err_text}"))
diff --git a/crates/database_client/src/tree.rs b/crates/database_client/src/tree.rs
index ef8e60cd20..6b67181410 100644
--- a/crates/database_client/src/tree.rs
+++ b/crates/database_client/src/tree.rs
@@ -133,9 +133,6 @@ pub struct TreeNode {
     /// For `NodeKind::Column`: whether the column is part of the primary key.
     pub is_primary_key: bool,
     /// For `NodeKind::Relation`: the row count, once loaded.
-    // Pinned cross-task API: the results-grid row-count task is its first
-    // non-test consumer, so dead_code fires until that task lands.
-    #[allow(dead_code)]
     pub row_count: Option<i64>,
 }
 
@@ -487,7 +484,11 @@ impl TreeState {
             relation_kind: Some(rel.kind),
             column_data_type: None,
             is_primary_key: false,
-            row_count: None,
+            row_count: if rel.kind == RelationKind::Table {
+                self.row_counts.get(&rel_id).copied()
+            } else {
+                None
+            },
         });
         if expanded && !is_matview {
             self.push_table_group(nodes, &rel_id, ObjectGroupKind::Columns);
@@ -756,7 +757,6 @@ impl TreeState {
         self.triggers.contains_key(rel_id)
     }
 
-    #[allow(dead_code)]
     pub fn set_row_count(&mut self, rel_id: &str, count: i64) {
         self.row_counts.insert(rel_id.to_string(), count);
     }
@@ -793,6 +793,16 @@ impl TreeState {
     }
 }
 
+/// Muted, right-aligned suffix for a table's approximate row count. A negative
+/// `reltuples` (never analyzed) renders nothing.
+pub fn row_count_suffix(count: i64) -> Option<String> {
+    if count < 0 {
+        return None;
+    }
+    let unit = if count == 1 { "row" } else { "rows" };
+    Some(format!("~{count} {unit}"))
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
@@ -1207,4 +1217,26 @@ mod tests {
         t.set_row_count(rel_id, 99);
         assert_eq!(t.row_count(rel_id), Some(99));
     }
+
+    #[test]
+    fn table_node_carries_row_count_and_negative_is_hidden() {
+        let mut t = loaded_tree();
+        t.set_row_count("p1/db1/public/tables/users", 1500);
+        t.toggle("p1/db1/public/tables");
+        let nodes = t.visible_nodes();
+        let table = nodes
+            .iter()
+            .find(|n| n.id == "p1/db1/public/tables/users")
+            .expect("users table");
+        assert_eq!(table.row_count, Some(1500));
+
+        assert_eq!(row_count_suffix(1500).as_deref(), Some("~1500 rows"));
+        assert_eq!(row_count_suffix(1).as_deref(), Some("~1 row"));
+        assert_eq!(
+            row_count_suffix(-1),
+            None,
+            "unknown count renders no suffix"
+        );
+        assert_eq!(row_count_suffix(0).as_deref(), Some("~0 rows"));
+    }
 }
