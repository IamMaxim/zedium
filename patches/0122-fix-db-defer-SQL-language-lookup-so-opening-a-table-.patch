From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maxim Stepanov <g.maxim.stepanoff@gmail.com>
Date: Wed, 1 Jul 2026 23:56:04 +0300
Subject: [PATCH] fix(db): defer SQL-language lookup so opening a table does
 not read Workspace mid-update

---
 crates/database_client/src/panel.rs      | 24 ++++++++++++++++---
 crates/database_client/src/query_view.rs | 30 ++++++++++++++----------
 2 files changed, 39 insertions(+), 15 deletions(-)

diff --git a/crates/database_client/src/panel.rs b/crates/database_client/src/panel.rs
index 0b532713c5..b768a69769 100644
--- a/crates/database_client/src/panel.rs
+++ b/crates/database_client/src/panel.rs
@@ -719,7 +719,11 @@ mod tests {
     async fn panel_with_profile(
         profile: ConnectionProfile,
         cx: &mut TestAppContext,
-    ) -> (Entity<DatabasePanel>, &mut gpui::VisualTestContext) {
+    ) -> (
+        Entity<DatabasePanel>,
+        Entity<Workspace>,
+        &mut gpui::VisualTestContext,
+    ) {
         let fs = fs::FakeFs::new(cx.executor());
         let project = project::Project::test(fs, [], cx).await;
         let (workspace, cx) =
@@ -733,7 +737,7 @@ mod tests {
             panel.connections.clear();
             cx.notify();
         });
-        (panel, cx)
+        (panel, workspace, cx)
     }
 
     async fn wait_until(
@@ -791,7 +795,7 @@ mod tests {
         profile.id = "p1".into();
         profile.ssl_mode = SslMode::Disable;
 
-        let (panel, cx) = panel_with_profile(profile, cx).await;
+        let (panel, workspace, cx) = panel_with_profile(profile, cx).await;
 
         // Expand connection -> databases load.
         panel.update(cx, |panel, cx| {
@@ -894,5 +898,19 @@ mod tests {
             empty_present,
             "expected '(no tables)' placeholder under emptydb/public"
         );
+
+        // Double-click open: must not read Workspace inside its own update
+        // (regression: opening a table panicked with "cannot read Workspace
+        // while it is already being updated").
+        panel.update_in(cx, |panel, window, cx| {
+            panel.open_query_for_relation("p1/testdb/public/users", window, cx)
+        });
+        cx.run_until_parked();
+        let query_views = workspace.update(cx, |workspace, cx| {
+            workspace
+                .items_of_type::<crate::query_view::QueryView>(cx)
+                .count()
+        });
+        assert_eq!(query_views, 1, "double-click should open one QueryView tab");
     }
 }
diff --git a/crates/database_client/src/query_view.rs b/crates/database_client/src/query_view.rs
index 5ca04f0a10..d0ac8da4e2 100644
--- a/crates/database_client/src/query_view.rs
+++ b/crates/database_client/src/query_view.rs
@@ -81,20 +81,26 @@ impl QueryView {
         let editor = cx.new(|cx| Editor::for_buffer(buffer.clone(), None, window, cx));
         let table_interaction = cx.new(|cx| TableInteractionState::new(cx));
 
-        let language_future = workspace
-            .read_with(cx, |ws, cx| {
-                ws.project().read(cx).languages().language_for_name("SQL")
-            })
-            .ok();
-        if let Some(language_future) = language_future {
-            cx.spawn(async move |_this, cx| {
+        cx.spawn({
+            let workspace = workspace.clone();
+            let buffer = buffer.clone();
+            async move |_this, cx| {
+                let Ok(language_future) = workspace.read_with(cx, |workspace, cx| {
+                    workspace
+                        .project()
+                        .read(cx)
+                        .languages()
+                        .language_for_name("SQL")
+                }) else {
+                    return;
+                };
                 let language = language_future.await.ok();
-                buffer.update(cx, |buf, cx| {
-                    buf.set_language(language, cx);
+                buffer.update(cx, |buffer, cx| {
+                    buffer.set_language(language, cx);
                 });
-            })
-            .detach();
-        }
+            }
+        })
+        .detach();
 
         let editor_subscription =
             cx.subscribe(&editor, |this, _editor, event: &EditorEvent, cx| {
