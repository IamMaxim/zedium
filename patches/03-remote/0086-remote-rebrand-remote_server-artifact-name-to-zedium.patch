 mkdir -p "${zed_dir}/libexec/remote_servers"
-if compgen -G "${remote_servers_src}/zed-remote-server-"*.gz >/dev/null; then
-    cp "${remote_servers_src}"/zed-remote-server-*.gz "${zed_dir}/libexec/remote_servers/"
