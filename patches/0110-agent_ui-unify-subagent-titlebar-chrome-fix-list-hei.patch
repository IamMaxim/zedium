+    /// Shared visual chrome for both the native subagent titlebar (shown atop a
+    /// popped-out child-session subagent) and the same-thread focused breadcrumb,
+    /// so the two stay pixel-identical. `title` is a slot so native can pass its
+    /// inline title editor while qwen passes a plain label. `on_back` drives the
+    /// trailing button (minimize for native, back-to-transcript for focused), and
+    /// `stop`, when present, renders a leading stop button.
+    fn render_subagent_titlebar_chrome(
+        &self,
+        title: AnyElement,
+        is_done: bool,
+        is_failed_or_cancelled: bool,
+        back_icon: IconName,
+        back_tooltip: &'static str,
+        on_back: impl Fn(&mut Self, &mut Window, &mut Context<Self>) + 'static,
+        stop: Option<impl Fn(&mut Self, &mut Window, &mut Context<Self>) + 'static>,
+        cx: &mut Context<Self>,
+    ) -> Div {
+        let max_content_width = AgentSettings::get_global(cx).max_content_width;
+        h_flex()
+            .w_full()
+            .h(Tab::container_height(cx))
+            .border_b_1()
+            .when(is_done && is_failed_or_cancelled, |this| this.border_dashed())
+            .border_color(cx.theme().colors().border)
+            .bg(cx.theme().colors().editor_background.opacity(0.2))
