+    #[test]
+    fn subagent_index_is_in_subtree_handles_nested_roots() {
+        // Outer root R; N is a nested subagent that is BOTH a root in its own
+        // right and a member of R; leaf L is a member of N.
+        let mut index = SubagentIndex::default();
+        let outer = acp::ToolCallId::new("R");
+        let nested = acp::ToolCallId::new("N");
+        let leaf = acp::ToolCallId::new("L");
+
+        index.apply(
+            &outer,
+            SubagentClassification::Root {
+                subagent_type: Some(SharedString::from("Explore")),
+                subtree: SubagentSubtree::SameThread,
+            },
+        );
+        index.apply(
+            &nested,
+            SubagentClassification::Member {
+                parent: outer.clone(),
+                subagent_type: SharedString::from("Explore"),
+            },
+        );
+        index.apply(
+            &nested,
+            SubagentClassification::Root {
+                subagent_type: Some(SharedString::from("Explore")),
+                subtree: SubagentSubtree::SameThread,
+            },
+        );
+        index.apply(
+            &leaf,
+            SubagentClassification::Member {
+                parent: nested.clone(),
+                subagent_type: SharedString::from("Explore"),
+            },
+        );
+
+        // `root_of` short-circuits at the nested root: it resolves N (and L) to
+        // N, NOT to the outer ancestor R. This is the trap that would wrongly
+        // hide nested entries while focused on R.
+        assert_eq!(index.root_of(&nested).as_ref(), Some(&nested));
+        assert_eq!(index.root_of(&leaf).as_ref(), Some(&nested));
+
+        // `is_in_subtree_of` does not short-circuit, so the entire nested
+        // subtree is correctly reported as part of R's subtree.
+        assert!(index.is_in_subtree_of(&outer, &outer));
+        assert!(index.is_in_subtree_of(&nested, &outer));
+        assert!(index.is_in_subtree_of(&leaf, &outer));
+        // N's own subtree is still queryable directly, and R is not under N.
+        assert!(index.is_in_subtree_of(&leaf, &nested));
+        assert!(!index.is_in_subtree_of(&outer, &nested));
+    }
