+    /// Whether `id` lies in the subtree rooted at `root` (inclusive of `root`
+    /// itself). Unlike [`Self::root_of`], this does not stop at the first root
+    /// it meets while walking the membership chain, so a *nested* root that is
+    /// also a member of `root` (and anything beneath it) is still reported as
+    /// in-subtree. `root_of` short-circuits at such a nested root and would
+    /// otherwise wrongly exclude it from its outer ancestor's subtree, which
+    /// matters when deciding entry visibility while focused on an outer root.
+    pub fn is_in_subtree_of(&self, id: &acp::ToolCallId, root: &acp::ToolCallId) -> bool {
+        if id == root {
+            return true;
+        }
+        let mut current = id.clone();
+        for _ in 0..Self::MAX_WALK_DEPTH {
+            let Some(membership) = self.membership.get(&current) else {
+                return false;
+            };
+            if &membership.parent == root {
+                return true;
+            }
+            current = membership.parent.clone();
+        }
+        false
+    }
+
     /// Direct children of `parent` (one parent hop only — does not flatten nested
     /// subtrees), in document order. Mixes tool-call and text/thought entries.
     /// `parent` may be a top-level root or a nested root; the caller decides which
@@ -4136,6 +4160,60 @@ mod tests {
