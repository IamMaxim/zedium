+/// Resolves the configured `extensions.local_registry` path to an unpacked bundle
+/// directory (one that directly contains `index.json`), or `None` if it cannot be
+/// resolved. A directory is used in place; a `.tar.gz` is unpacked once into
+/// `cache_root/<size-mtime>/` and reused on subsequent calls. No network.
+async fn resolve_registry_dir(
+    fs: Arc<dyn Fs>,
+    configured: PathBuf,
+    cache_root: PathBuf,
+) -> Result<Option<PathBuf>> {
+    let Some(metadata) = fs.metadata(&configured).await? else {
+        log::warn!("extensions.local_registry path {configured:?} does not exist");
+        return Ok(None);
+    };
+
+    if metadata.is_dir {
+        return Ok(find_bundle_dir(&fs, configured).await);
+    }
+
+    // Treat a regular file as a gzip tarball. Key the cache by size + mtime so a
+    // replaced bundle is re-unpacked, but an unchanged one is read straight from
+    // the cache.
+    let (secs, nanos) = metadata
+        .mtime
+        .to_seconds_and_nanos_for_persistence()
+        .unwrap_or((0, 0));
+    let cache_dir = cache_root.join(format!("{:x}-{:x}-{:x}", metadata.len, secs, nanos));
+    let marker = cache_dir.join(".unpacked");
+    if !fs.is_file(&marker).await {
+        fs.remove_dir(
+            &cache_dir,
+            RemoveOptions {
+                recursive: true,
+                ignore_if_not_exists: true,
+            },
+        )
+        .await?;
+        fs.create_dir(&cache_dir).await?;
+        let bytes = fs
+            .load_bytes(&configured)
+            .await
+            .with_context(|| format!("reading extension registry archive {configured:?}"))?;
+        let archive = Archive::new(GzipDecoder::new(BufReader::new(bytes.as_slice())));
+        archive
+            .unpack(&cache_dir)
+            .await
+            .with_context(|| format!("unpacking extension registry archive {configured:?}"))?;
+        fs.write(&marker, b"").await?;
+    }
+
+    Ok(find_bundle_dir(&fs, cache_dir).await)
+}
+
+/// Returns the directory that directly contains `index.json`: either `dir` itself,
+/// or its single bundle subdirectory (the snapshot tar wraps a top-level dir).
+async fn find_bundle_dir(fs: &Arc<dyn Fs>, dir: PathBuf) -> Option<PathBuf> {
+    if fs.is_file(&dir.join("index.json")).await {
+        return Some(dir);
+    }
+    let mut entries = fs.read_dir(&dir).await.log_err()?;
+    while let Some(Ok(child)) = entries.next().await {
+        if fs.is_file(&child.join("index.json")).await {
+            return Some(child);
+        }
+    }
+    None
+}
