+        // `/extensions/<id>` (but not `/extensions/updates`) asks for one id's versions.
+        let single_id = path
+            .strip_prefix("/extensions/")
+            .filter(|rest| !rest.is_empty() && *rest != "updates")
+            .map(|id| id.to_string());
+
+        let filter = query
+            .iter()
+            .find(|(key, _)| *key == "filter")
+            .map(|(_, value)| value.to_lowercase());
+        let provides: BTreeSet<ExtensionProvides> = query
+            .iter()
+            .find(|(key, _)| *key == "provides")
+            .map(|(_, value)| value.split(',').filter_map(|p| p.parse().ok()).collect())
+            .unwrap_or_default();
+        let ids: Option<BTreeSet<String>> = query
+            .iter()
+            .find(|(key, _)| *key == "ids")
+            .map(|(_, value)| {
+                value
+                    .split(',')
+                    .filter(|s| !s.is_empty())
+                    .map(|s| s.to_string())
+                    .collect()
+            });
+
+        cx.background_spawn(async move {
+            let Some(configured) = configured.filter(|path| !path.is_empty()) else {
+                return Ok(Vec::new());
+            };
+            let Some(registry_dir) =
+                resolve_registry_dir(fs.clone(), PathBuf::from(configured), cache_root).await?
+            else {
+                return Ok(Vec::new());
+            };
+
+            let index_bytes = fs
+                .load_bytes(&registry_dir.join("index.json"))
+                .await
+                .context("reading local registry index.json")?;
+            let response: GetExtensionsResponse =
+                serde_json::from_slice(&index_bytes).context("parsing local registry index.json")?;
+
+            let extensions = response
+                .data
+                .into_iter()
+                .filter(|extension| {
+                    single_id
+                        .as_ref()
+                        .is_none_or(|id| extension.id.as_ref() == id)
+                })
+                .filter(|extension| {
+                    ids.as_ref()
+                        .is_none_or(|ids| ids.contains(extension.id.as_ref()))
+                })
+                .filter(|extension| {
+                    provides.is_empty()
+                        || provides
+                            .iter()
+                            .all(|provided| extension.manifest.provides.contains(provided))
+                })
+                .filter(|extension| match &filter {
+                    Some(filter) => {
+                        extension.id.to_lowercase().contains(filter)
+                            || extension.manifest.name.to_lowercase().contains(filter)
+                            || extension
+                                .manifest
+                                .description
+                                .as_deref()
+                                .is_some_and(|description| {
+                                    description.to_lowercase().contains(filter)
+                                })
+                    }
+                    None => true,
+                })
+                .collect();
+            Ok(extensions)
+        })
     }
 
