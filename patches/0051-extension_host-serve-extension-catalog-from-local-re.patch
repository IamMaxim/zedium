+#[gpui::test]
+async fn test_fetch_extensions_from_local_registry(cx: &mut TestAppContext) {
+    init_test(cx);
+    cx.executor().allow_parking();
+
+    let index_json = r#"{
+        "data": [
+            {
+                "id": "airgap-theme",
+                "name": "Airgap Theme",
+                "version": "1.0.0",
+                "description": "A dark theme",
+                "authors": ["Someone"],
+                "repository": "https://example.invalid/airgap",
+                "schema_version": 1,
+                "wasm_api_version": null,
+                "provides": ["themes"],
+                "published_at": "2024-01-01T00:00:00Z",
+                "download_count": 0
+            },
+            {
+                "id": "ruby-lang",
+                "name": "Ruby",
+                "version": "2.0.0",
+                "description": "Ruby language support",
+                "authors": ["Someone"],
+                "repository": "https://example.invalid/ruby",
+                "schema_version": 1,
+                "wasm_api_version": null,
+                "provides": ["languages", "grammars"],
+                "published_at": "2024-01-01T00:00:00Z",
+                "download_count": 0
+            }
+        ]
+    }"#;
+
+    let registry_tree = TempTree::new(json!({
+        "index.json": index_json,
+    }));
+    let registry_dir = registry_tree.path().canonicalize().unwrap();
+
+    let fs = Arc::new(RealFs::new(None, cx.executor()));
+    let extensions_tree = TempTree::new(json!({
+        "installed": {},
+        "work": {},
+        "staging": {},
+    }));
+    let extensions_dir = extensions_tree.path().canonicalize().unwrap();
+
+    cx.update(|cx| {
+        SettingsStore::update_global(cx, |store, cx| {
+            store.update_user_settings(cx, |content| {
+                content.extension.local_registry =
+                    Some(registry_dir.to_string_lossy().into_owned());
+            });
+        });
+    });
+
+    let proxy = Arc::new(ExtensionHostProxy::new());
+    let node_runtime = NodeRuntime::unavailable();
+    let http_client = FakeHttpClient::with_404_response();
+    let extension_store = cx.new(|cx| {
+        ExtensionStore::new(
+            extensions_dir.clone(),
+            None,
+            proxy,
+            fs.clone(),
+            http_client.clone(),
+            http_client.clone(),
+            node_runtime,
+            cx,
+        )
+    });
+
+    let all = extension_store
+        .update(cx, |store, cx| store.fetch_extensions(None, None, cx))
+        .await
+        .unwrap();
+    assert_eq!(all.len(), 2, "both registry extensions should be listed");
+
+    let filtered = extension_store
+        .update(cx, |store, cx| store.fetch_extensions(Some("ruby"), None, cx))
+        .await
+        .unwrap();
+    assert_eq!(filtered.len(), 1);
+    assert_eq!(filtered[0].id.as_ref(), "ruby-lang");
+
+    let themes_only = extension_store
+        .update(cx, |store, cx| {
+            store.fetch_extensions(
+                None,
+                Some(&BTreeSet::from_iter([ExtensionProvides::Themes])),
+                cx,
+            )
+        })
+        .await
+        .unwrap();
+    assert_eq!(themes_only.len(), 1);
+    assert_eq!(themes_only[0].id.as_ref(), "airgap-theme");
+}
