-        .unbounded_send(Ok(Some(vec![
-            lsp::Location {
-                uri: lsp::Uri::from_file_path(path!("/root/dir-1/two.rs")).unwrap(),
-                range: lsp::Range::new(lsp::Position::new(0, 24), lsp::Position::new(0, 27)),
