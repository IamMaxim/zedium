-    pub fn share_project(
-        &mut self,
-        project: Entity<Project>,
-        cx: &mut Context<Self>,
-    ) -> Task<Result<u64>> {
-        if let Some(project_id) = project.read(cx).remote_id() {
-            return Task::ready(Ok(project_id));
