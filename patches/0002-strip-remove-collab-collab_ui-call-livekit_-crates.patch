-        tx: &DatabaseTransaction,
-    ) -> Result<ChannelsForUser> {
-        let mut filter = channel_member::Column::UserId.eq(user_id);
-        if !include_invites {
-            filter = filter.and(channel_member::Column::Accepted.eq(true))
