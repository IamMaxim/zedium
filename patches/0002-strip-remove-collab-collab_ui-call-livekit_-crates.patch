-                    vec![VectorClockEntry {
-                        timestamp: latest_lamport_timestamp as u32,
-                        replica_id: latest_replica_id as u32,
-                    }]
-                } else {
-                    vec![]
-                },
-            });
-        }
-        drop(rows);
-
-        let observed_buffer_versions = self
-            .observed_channel_buffer_changes(&channel_ids_by_buffer_id, user_id, tx)
-            .await?;
-
-        Ok(ChannelsForUser {
-            channel_memberships,
-            channels,
