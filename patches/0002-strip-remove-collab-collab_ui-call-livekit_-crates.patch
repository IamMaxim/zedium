-        if result.rows_affected == 0 {
-            Err(anyhow!("not a collaborator on this project"))?;
-        }
-
-        let mut collaborators = Vec::new();
-        let mut connections = Vec::new();
-        let mut rows = channel_buffer_collaborator::Entity::find()
